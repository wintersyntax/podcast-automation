REPOSITORY_ROOT = Path(__file__).resolve().parents[2]


def load_canonical_benchmark_v2_config(*, root: Path | None = None) -> tuple[dict, bytes]:
    benchmark_root = REPOSITORY_ROOT if root is None else Path(root)
    config_path = benchmark_root / "config" / "summary-review-benchmark-v2.json"
    try:
        config_bytes = config_path.read_bytes()
    except OSError as error:
        raise ValueError("Benchmark v2 canonical config is unavailable") from error
    try:
        config = json.loads(config_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError("Benchmark v2 canonical config must be valid UTF-8 JSON") from error
    if not isinstance(config, dict):
        raise ValueError("Benchmark v2 canonical config must be an object")
    models = config.get("models")
    if (
        not isinstance(models, list)
        or len(models) != 5
        or any(not isinstance(model_id, str) or not model_id.strip() for model_id in models)
        or len(set(models)) != 5
    ):
        raise ValueError("Benchmark v2 canonical config must define five unique model IDs")
    designated_candidates = config.get("geoffrey_designated_candidates")
    if (
        not isinstance(designated_candidates, list)
        or not designated_candidates
        or any(
            not isinstance(candidate_id, str) or candidate_id not in models
            for candidate_id in designated_candidates
        )
        or len(set(designated_candidates)) != len(designated_candidates)
    ):
        raise ValueError(
            "Benchmark v2 canonical config must define unique geoffrey_designated_candidates "
            "drawn from the committed models"
        )
    return config, config_bytes


def require_canonical_candidate_ids(
    candidate_ids: list[str] | tuple[str, ...],
    *,
    root: Path | None = None,
) -> tuple[str, ...]:
    config, _config_bytes = load_canonical_benchmark_v2_config(root=root)
    canonical_models = config["models"]
    if not isinstance(candidate_ids, (list, tuple)) or list(candidate_ids) != canonical_models:
        raise ValueError("Benchmark v2 candidate IDs must match exact committed candidate order")
    return tuple(canonical_models)


def build_benchmark_v2_run_bundle(
    *,
    repository_root: Path,
    provider_lock_bytes: bytes,
    pricing_evidence_bytes: bytes,
    geoffrey_transcript_bytes: bytes,
    geoffrey_draft_bytes: bytes,
) -> dict:
    """Load and bind the exact canonical Benchmark-v2 run authorities once."""

    repository_root = Path(repository_root)

    def read_exact_authority(
        relative_path: Path,
        *,
        label: str,
    ) -> bytes:
        repository_path = repository_root / relative_path
        committed_path = REPOSITORY_ROOT / relative_path
        try:
            repository_bytes = repository_path.read_bytes()
            committed_bytes = committed_path.read_bytes()
        except OSError as error:
            raise ValueError(
                f"Benchmark v2 run bundle {label} authority is unavailable"
            ) from error
        if repository_bytes != committed_bytes:
            raise ValueError(
                f"Benchmark v2 run bundle {label} bytes must match committed authority"
            )
        return repository_bytes

    def parse_json_bytes(
        data: bytes,
        *,
        label: str,
        require_canonical: bool,
    ) -> dict:
        if not isinstance(data, bytes):
            raise ValueError(
                f"Benchmark v2 run bundle {label} must be exact bytes"
            )
        try:
            payload = json.loads(data.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise ValueError(
                f"Benchmark v2 run bundle {label} must be valid UTF-8 JSON"
            ) from error
        if not isinstance(payload, dict):
            raise ValueError(
                f"Benchmark v2 run bundle {label} must be a JSON object"
            )
        if require_canonical:
            try:
                canonical_bytes = (
                    json.dumps(
                        payload,
                        ensure_ascii=False,
                        indent=2,
                        sort_keys=True,
                    )
                    + "\n"
                ).encode("utf-8")
            except (TypeError, ValueError) as error:
                raise ValueError(
                    f"Benchmark v2 run bundle {label} must be canonical JSON"
                ) from error
            if data != canonical_bytes:
                raise ValueError(
                    f"Benchmark v2 run bundle {label} bytes must be canonical JSON"
                )
        return payload

    committed_config, committed_config_bytes = load_canonical_benchmark_v2_config(
        root=REPOSITORY_ROOT
    )
    config, config_bytes = load_canonical_benchmark_v2_config(
        root=repository_root
    )
    if config_bytes != committed_config_bytes or config != committed_config:
        raise ValueError(
            "Benchmark v2 run bundle config must match exact committed authority"
        )
    canonical_candidate_ids = require_canonical_candidate_ids(
        config["models"],
        root=REPOSITORY_ROOT,
    )

    fixture_relative_path = (
        Path("config") / "summary-review-benchmark-v2-fixtures.json"
    )
    fixture_set_bytes = read_exact_authority(
        fixture_relative_path,
        label="fixture set",
    )
    fixture_set = parse_json_bytes(
        fixture_set_bytes,
        label="fixture set",
        require_canonical=False,
    )
    cases = fixture_set.get("cases")
    if (
        not isinstance(cases, list)
        or len(cases) != 6
        or any(not isinstance(case, dict) for case in cases)
    ):
        raise ValueError(
            "Benchmark v2 run bundle fixture set must contain six canonical cases"
        )
    canonical_case_ids = [case.get("case_id") for case in cases]
    if (
        any(
            not isinstance(case_id, str) or not case_id
            for case_id in canonical_case_ids
        )
        or len(set(canonical_case_ids)) != len(canonical_case_ids)
    ):
        raise ValueError(
            "Benchmark v2 run bundle canonical case identities are invalid"
        )

    prompt_relative_path = (
        Path("config") / "summary-review-benchmark-v2-prompt.txt"
    )
    reviewer_prompt_bytes = read_exact_authority(
        prompt_relative_path,
        label="reviewer prompt",
    )
    try:
        reviewer_prompt = reviewer_prompt_bytes.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ValueError(
            "Benchmark v2 run bundle reviewer prompt must be valid UTF-8"
        ) from error
    if not reviewer_prompt.strip():
        raise ValueError(
            "Benchmark v2 run bundle reviewer prompt must not be empty"
        )

    provider_lock = parse_json_bytes(
        provider_lock_bytes,
        label="provider lock",
        require_canonical=True,
    )
    pricing_evidence = parse_json_bytes(
        pricing_evidence_bytes,
        label="pricing evidence",
        require_canonical=True,
    )

    expected_candidates = set(canonical_candidate_ids)
    provider_models = provider_lock.get("models")
    if (
        not isinstance(provider_models, dict)
        or set(provider_models) != expected_candidates
    ):
        raise ValueError(
            "Benchmark v2 run bundle provider candidate coverage must match "
            "the five committed candidates"
        )

    pricing_models = pricing_evidence.get("models")
    if (
        not isinstance(pricing_models, dict)
        or set(pricing_models) != expected_candidates
    ):
        raise ValueError(
            "Benchmark v2 run bundle pricing candidate coverage must match "
            "the five committed candidates"
        )

    max_completion_tokens = _require_max_completion_tokens(config)
    derived_reservations = {}
    for model_id in canonical_candidate_ids:
        provider_entry = provider_models[model_id]
        pricing_entry = pricing_models[model_id]
        if not isinstance(provider_entry, dict):
            raise ValueError(
                "Benchmark v2 run bundle provider candidate entry is invalid"
            )
        if not isinstance(pricing_entry, dict):
            raise ValueError(
                "Benchmark v2 run bundle pricing candidate entry is invalid"
            )

        provider_route = provider_entry.get("routing_provider_slug")
        pricing_route = pricing_entry.get("routing_provider_slug")
        available_routes = pricing_entry.get("available_provider_slugs")
        compatible_served_providers = provider_entry.get(
            "compatible_served_providers"
        )
        if (
            not isinstance(provider_route, str)
            or not provider_route
            or pricing_route != provider_route
            or not isinstance(available_routes, list)
            or provider_route not in available_routes
            or not isinstance(compatible_served_providers, list)
            or not compatible_served_providers
            or any(
                not isinstance(provider, str) or not provider
                for provider in compatible_served_providers
            )
        ):
            raise ValueError(
                "Benchmark v2 run bundle provider/pricing route authority is invalid"
            )

        derived_reservations[model_id] = format(
            derive_call_reservation_usd(
                pricing_entry,
                max_completion_tokens=max_completion_tokens,
            ),
            "f",
        )

    geoffrey_fixture_context = build_geoffrey_fixture_context(
        transcript_bytes=geoffrey_transcript_bytes,
        draft_bytes=geoffrey_draft_bytes,
    )

    workspace = prepare_benchmark_v2_operator_workspace(
        repository_root=repository_root,
    )
    canonical_workspace_root = (
        repository_root
        / "var"
        / "benchmarks"
        / "summary-review-v2"
    )
    expected_workspace = {
        "root": canonical_workspace_root,
        "locks_dir": canonical_workspace_root / "locks",
        "preflight_locks_dir": canonical_workspace_root / "preflight" / "locks",
        "provider_lock_path": canonical_workspace_root / "provider-lock.json",
        "pricing_evidence_path": canonical_workspace_root / "pricing-evidence.json",
        "execution_state_path": canonical_workspace_root / "execution-state.json",
        "reveal_path": canonical_workspace_root / "reveal.json",
    }
    if not isinstance(workspace, dict) or set(workspace) != set(expected_workspace):
        raise ValueError(
            "Benchmark v2 run bundle workspace must match canonical benchmark paths"
        )

    canonical_workspace_resolved = canonical_workspace_root.resolve()
    for key, expected_path in expected_workspace.items():
        actual_path = workspace.get(key)
        if not isinstance(actual_path, Path):
            raise ValueError(
                "Benchmark v2 run bundle workspace paths must be pathlib Paths"
            )
        if actual_path.resolve() != expected_path.resolve():
            raise ValueError(
                "Benchmark v2 run bundle workspace path does not match canonical benchmark path"
            )
        try:
            actual_path.resolve().relative_to(canonical_workspace_resolved)
        except ValueError as error:
            raise ValueError(
                "Benchmark v2 run bundle workspace path escapes canonical benchmark workspace"
            ) from error

    benchmark_binding = {
        "config_sha256": _sha256_bytes(config_bytes),
        "fixture_set_sha256": _sha256_bytes(fixture_set_bytes),
        "reviewer_prompt_sha256": _sha256_bytes(reviewer_prompt_bytes),
        "provider_lock_sha256": _sha256_bytes(provider_lock_bytes),
        "pricing_evidence_sha256": _sha256_bytes(pricing_evidence_bytes),
        "geoffrey_transcript_sha256": geoffrey_fixture_context[
            "transcript_sha256"
        ],
        "geoffrey_draft_sha256": geoffrey_fixture_context["draft_sha256"],
    }

    return {
        "config": config,
        "config_bytes": config_bytes,
        "canonical_candidate_ids": canonical_candidate_ids,
        "fixture_set": fixture_set,
        "fixture_set_bytes": fixture_set_bytes,
        "canonical_case_ids": tuple(canonical_case_ids),
        "reviewer_prompt_bytes": reviewer_prompt_bytes,
        "provider_lock": provider_lock,
        "provider_lock_bytes": provider_lock_bytes,
        "pricing_evidence": pricing_evidence,
        "pricing_evidence_bytes": pricing_evidence_bytes,
        "geoffrey_transcript_bytes": geoffrey_transcript_bytes,
        "geoffrey_draft_bytes": geoffrey_draft_bytes,
        "workspace": workspace,
        "ordered_case_keys": [
            f"{model_id}::{case_id}"
            for case_id in canonical_case_ids
            for model_id in canonical_candidate_ids
        ] + [
            f"geoffrey::{_geoffrey_track_slug(candidate_id)}::run-{run_number}"
            for candidate_id in config["geoffrey_designated_candidates"]
            for run_number in range(1, 4)
        ],
        "geoffrey_designated_candidates": tuple(config["geoffrey_designated_candidates"]),
        "benchmark_binding": benchmark_binding,
        "derived_call_reservation_usd_by_model": derived_reservations,
    }


GEOFFREY_TRANSCRIPT_SHA256 = (
    "sha256:f0cfbb4983101aa5f111b6f2deffe47bdec120d771b98f477113679d3db88d68"
)
GEOFFREY_DRAFT_SHA256 = (
    "sha256:8bc46ea8b8740365fc1f756f4cb05c3030c03022bfedf22ffc391acc0aea2882"
)


def _sha256_bytes(data: bytes) -> str:
    return "sha256:" + hashlib.sha256(data).hexdigest()


def build_geoffrey_fixture_context(
    *,
    transcript_bytes: bytes,
    draft_bytes: bytes,
) -> dict:
    """Bind the exact frozen Geoffrey inputs before deriving evaluator context."""

    if not isinstance(transcript_bytes, bytes):
        raise ValueError("Benchmark v2 Geoffrey transcript input must be exact bytes")
    if not isinstance(draft_bytes, bytes):
        raise ValueError("Benchmark v2 Geoffrey draft input must be exact bytes")

    transcript_sha256 = _sha256_bytes(transcript_bytes)
    if transcript_sha256 != GEOFFREY_TRANSCRIPT_SHA256:
        raise ValueError(
            "Benchmark v2 Geoffrey transcript hash does not match frozen input"
        )

    draft_sha256 = _sha256_bytes(draft_bytes)
    if draft_sha256 != GEOFFREY_DRAFT_SHA256:
        raise ValueError(
            "Benchmark v2 Geoffrey draft hash does not match frozen input"
        )

    try:
        transcript = transcript_bytes.decode("utf-8")
        draft = draft_bytes.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ValueError(
            "Benchmark v2 Geoffrey frozen inputs must be valid UTF-8"
        ) from error

    return {
        "transcript_sha256": transcript_sha256,
        "draft_sha256": draft_sha256,
        "transcript": transcript,
        "draft": draft,
        "review_context": build_review_context(transcript, draft),
    }


def _contains_casefold(text: str, substring: str) -> bool:
    return substring.casefold() in text.casefold()


_GEOFFREY_SEMANTIC_FORBIDDEN_PATTERNS = (
    (
        "forbidden_precision:99%",
        re.compile(r"(?<!\d)99\s*(?:%|percent\b)", re.IGNORECASE),
    ),
    (
        "forbidden_outside_normalization:Concept2",
        re.compile(r"\bconcept\s*(?:2|two)\b", re.IGNORECASE),
    ),
    (
        "forbidden_outside_normalization:Yates style",
        re.compile(r"\byates\b", re.IGNORECASE),
    ),
)


def build_geoffrey_evaluator_private(review_context: dict) -> dict:
    """Derive the canonical evaluator-private Geoffrey expectations."""

    if not isinstance(review_context, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey review context must be an object"
        )

    spans = review_context.get("transcript_span_index", {}).get("spans")
    if not isinstance(spans, list) or not spans:
        raise ValueError(
            "Benchmark v2 Geoffrey canonical private expectations require transcript spans"
        )

    coverage_terms = ("relationships", "sleep", "lifestyle")
    coverage_span_ids = []
    concept_to_found = False
    seen_span_ids = set()

    for span in spans:
        if not isinstance(span, dict):
            raise ValueError(
                "Benchmark v2 Geoffrey transcript span must be an object"
            )
        span_id = span.get("span_id")
        text = span.get("text")
        if (
            not isinstance(span_id, str)
            or not span_id
            or span_id in seen_span_ids
            or not isinstance(text, str)
        ):
            raise ValueError(
                "Benchmark v2 Geoffrey transcript span identity is invalid"
            )
        seen_span_ids.add(span_id)

        if any(_contains_casefold(text, term) for term in coverage_terms):
            coverage_span_ids.append(span_id)
        if _contains_casefold(text, "concept to"):
            concept_to_found = True

    if not coverage_span_ids:
        raise ValueError(
            "Benchmark v2 Geoffrey frozen context lacks material coverage spans"
        )
    if not concept_to_found:
        raise ValueError(
            "Benchmark v2 Geoffrey frozen context lacks canonical concept to evidence"
        )

    return {
        "coverage_span_ids": coverage_span_ids,
        "coverage_final_any_substrings": list(coverage_terms),
        "required_canonical_substrings": ["concept to"],
        "forbidden_precision_substrings": ["99%"],
        "forbidden_outside_normalizations": [
            "Concept2",
            "Yates style",
        ],
        "forbidden_new_material_substrings": [
            "cold plunge protocol",
        ],
        "required_section_substrings": [
            "## TL;DR",
            "## Key Ideas",
        ],
    }


def evaluate_geoffrey_run(
    *,
    review_context: dict,
    case_result: dict,
    evaluator_private: dict,
    transcript: str | None = None,
    draft: str | None = None,
) -> dict:
    """Evaluate one contract-valid Geoffrey result against private hard gates."""

    if not isinstance(review_context, dict):
        raise ValueError("Benchmark v2 Geoffrey review context must be an object")
    if not isinstance(case_result, dict):
        raise ValueError("Benchmark v2 Geoffrey case result must be an object")
    if not isinstance(evaluator_private, dict):
        raise ValueError("Benchmark v2 Geoffrey evaluator-private config must be an object")

    canonical_evaluator_private = build_geoffrey_evaluator_private(review_context)
    if evaluator_private != canonical_evaluator_private:
        raise ValueError(
            "Benchmark v2 Geoffrey evaluator-private config must match canonical expectations"
        )

    audit_result = case_result.get("audit_result")
    final_markdown = case_result.get("accepted_final_markdown")
    if not isinstance(audit_result, dict):
        raise ValueError("Benchmark v2 Geoffrey audit result must be an object")
    if not isinstance(final_markdown, str):
        raise ValueError("Benchmark v2 Geoffrey accepted final must be Markdown text")

    failures = []

    # The canonical Geoffrey path is built from the real deterministic V2 context.
    # When exact source text is available, run the production Reviewer-v2 audit/edit
    # validators end to end. Direct evaluator calls without source text still enforce
    # the same structured audit/obligation/final-Markdown shape before Geoffrey-only
    # semantic assertions. Older synthetic unit contexts intentionally omit the
    # draft_block_index and exercise only the isolated semantic predicates below.
    if isinstance(review_context.get("draft_block_index"), dict):
        try:
            validated_audit = validate_audit_result(
                audit_result,
                transcript if isinstance(transcript, str) else "",
                review_context,
            )
            edit_result = case_result.get("edit_result")
            if isinstance(transcript, str) and isinstance(draft, str):
                validated_edit = validate_edit_result(
                    edit_result,
                    validated_audit,
                    draft,
                    transcript,
                    review_context,
                )
                expected_final = accepted_final_markdown(
                    validated_audit,
                    validated_edit,
                    draft,
                )
            else:
                if not isinstance(edit_result, dict) or set(edit_result) != {
                    "resolved_issue_ids",
                    "final_markdown",
                }:
                    raise ValueError(
                        "Benchmark v2 Geoffrey edit result does not match Reviewer-v2"
                    )
                obligations = build_edit_obligations(validated_audit)
                expected_issue_ids = [
                    obligation["issue_id"] for obligation in obligations
                ]
                if edit_result.get("resolved_issue_ids") != expected_issue_ids:
                    raise ValueError(
                        "Benchmark v2 Geoffrey edit obligations do not match Reviewer-v2"
                    )
                edit_final = edit_result.get("final_markdown")
                validate_final_markdown(edit_final)
                expected_final = accepted_final_markdown(
                    validated_audit,
                    edit_result,
                    "",
                )
            if expected_final != final_markdown:
                raise ValueError(
                    "Benchmark v2 Geoffrey accepted final does not match Reviewer-v2"
                )
        except ValueError:
            failures.append("reviewer_v2_contract")

    if audit_result.get("status") != "revised":
        failures.append("required_status")

    risks = review_context.get("risk_inventory", {}).get("risks")
    assessments = audit_result.get("risk_assessments")
    if not isinstance(risks, list) or not isinstance(assessments, list):
        failures.append("risk_completeness")
    else:
        expected_risk_ids = [
            risk.get("risk_id")
            for risk in risks
            if isinstance(risk, dict)
        ]
        actual_risk_ids = [
            assessment.get("risk_id")
            for assessment in assessments
            if isinstance(assessment, dict)
        ]
        if (
            len(expected_risk_ids) != len(risks)
            or len(actual_risk_ids) != len(assessments)
            or len(set(expected_risk_ids)) != len(expected_risk_ids)
            or len(set(actual_risk_ids)) != len(actual_risk_ids)
            or set(actual_risk_ids) != set(expected_risk_ids)
        ):
            failures.append("risk_completeness")

    for substring in evaluator_private.get("forbidden_precision_substrings", []):
        if _contains_casefold(final_markdown, substring):
            failures.append(f"forbidden_precision:{substring}")

    for substring in evaluator_private.get("forbidden_outside_normalizations", []):
        if _contains_casefold(final_markdown, substring):
            failures.append(f"forbidden_outside_normalization:{substring}")

    for failure_label, pattern in _GEOFFREY_SEMANTIC_FORBIDDEN_PATTERNS:
        if pattern.search(final_markdown) and failure_label not in failures:
            failures.append(failure_label)

    for substring in evaluator_private.get("required_canonical_substrings", []):
        if not _contains_casefold(final_markdown, substring):
            failures.append(f"required_canonical:{substring}")

    spans = review_context.get("transcript_span_index", {}).get("spans", [])
    valid_span_ids = {
        span.get("span_id")
        for span in spans
        if isinstance(span, dict) and isinstance(span.get("span_id"), str)
    }
    coverage_span_ids = {
        span_id
        for span_id in evaluator_private.get("coverage_span_ids", [])
        if isinstance(span_id, str) and span_id in valid_span_ids
    }
    additional_issues = audit_result.get("additional_issues", [])
    coverage_evidence_found = False
    if isinstance(additional_issues, list):
        for issue in additional_issues:
            if (
                not isinstance(issue, dict)
                or issue.get("issue_type") != "coverage_omission"
            ):
                continue
            issue_span_ids = issue.get("transcript_span_ids")
            if (
                isinstance(issue_span_ids, list)
                and coverage_span_ids.intersection(issue_span_ids)
            ):
                coverage_evidence_found = True
                break
    if not coverage_evidence_found:
        failures.append("coverage_omission_evidence")

    coverage_substrings = evaluator_private.get(
        "coverage_final_any_substrings",
        [],
    )
    if (
        not isinstance(coverage_substrings, list)
        or not coverage_substrings
        or not any(
            isinstance(substring, str)
            and _contains_casefold(final_markdown, substring)
            for substring in coverage_substrings
        )
    ):
        failures.append("coverage_restoration")

    for substring in evaluator_private.get("forbidden_new_material_substrings", []):
        if _contains_casefold(final_markdown, substring):
            failures.append(f"unsupported_new_material:{substring}")

    for substring in evaluator_private.get("required_section_substrings", []):
        if not _contains_casefold(final_markdown, substring):
            failures.append(f"required_section:{substring}")

    return {
        "hard_gate_passed": not failures,
        "failures": failures,
    }


def run_locked_qualification_geoffrey_dry_run(
    *,
    lock_dir: Path,
    qualification_inputs: dict,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    geoffrey_run_executor,
    benchmark_binding: dict | None = None,
) -> dict:
    """Compose Task-7 qualification locking and canonical Task-8 Geoffrey with zero spend."""

    lock_dir = Path(lock_dir)
    if not isinstance(transcript_bytes, bytes) or not isinstance(draft_bytes, bytes):
        raise ValueError(
            "Benchmark v2 canonical Geoffrey dry-run inputs must be exact bytes"
        )

    if benchmark_binding is not None:
        benchmark_binding = _require_benchmark_binding(benchmark_binding)
        if "benchmark_binding" in qualification_inputs:
            raise ValueError(
                "Benchmark v2 dry-run benchmark binding must have one authority"
            )
        qualification_inputs = {
            **qualification_inputs,
            "benchmark_binding": benchmark_binding,
        }

    qualification_result = finalize_qualification_decision(
        lock_dir=lock_dir,
        **qualification_inputs,
    )
    qualification_payload = qualification_result["payload"]

    if qualification_payload["decision"] != "advance":
        result = {
            "mode": "dry_run",
            "spent_usd": "0.00",
            "qualification": qualification_payload,
            "geoffrey": None,
        }
        if benchmark_binding is not None:
            result["benchmark_binding"] = benchmark_binding
        return result

    geoffrey_result = run_geoffrey_final_gate_with_qualification_lock(
        lock_dir=lock_dir,
        expected_binding=qualification_payload["binding"],
        transcript_bytes=transcript_bytes,
        draft_bytes=draft_bytes,
        geoffrey_run_executor=geoffrey_run_executor,
    )

    result = {
        "mode": "dry_run",
        "spent_usd": "0.00",
        "qualification": qualification_payload,
        "geoffrey": geoffrey_result,
    }
    if benchmark_binding is not None:
        result["benchmark_binding"] = benchmark_binding
    return result


def run_locked_qualification_geoffrey_dry_run_for_designated_tracks(
    *,
    lock_dir: Path,
    designated_candidate_ids: list[str],
    qualification_inputs: dict,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    geoffrey_run_executor,
    benchmark_binding: dict | None = None,
) -> dict:
    """Compose Task-7 designated-track locking and canonical Task-8 Geoffrey
    with zero spend, once per independent designated track.

    Mirrors ``run_locked_qualification_geoffrey_dry_run`` exactly except for
    which lock shape it exercises: every designated candidate's own
    eligibility is resolved independently (no single-winner tie-break), and
    each eligible candidate gets its own zero-paid Geoffrey dry-run gate in
    its own track lock directory, so one track's dry-run outcome can never
    affect another's.
    """

    lock_dir = Path(lock_dir)
    if not isinstance(transcript_bytes, bytes) or not isinstance(draft_bytes, bytes):
        raise ValueError(
            "Benchmark v2 canonical Geoffrey dry-run inputs must be exact bytes"
        )
    if (
        not isinstance(designated_candidate_ids, list)
        or not designated_candidate_ids
    ):
        raise ValueError(
            "Benchmark v2 designated-tracks dry-run requires designated candidate ids"
        )

    if benchmark_binding is not None:
        benchmark_binding = _require_benchmark_binding(benchmark_binding)
        if "benchmark_binding" in qualification_inputs:
            raise ValueError(
                "Benchmark v2 dry-run benchmark binding must have one authority"
            )
        qualification_inputs = {
            **qualification_inputs,
            "benchmark_binding": benchmark_binding,
        }

    designated_tracks_result = finalize_qualification_designated_tracks_decision(
        lock_dir=lock_dir,
        designated_candidate_ids=list(designated_candidate_ids),
        **qualification_inputs,
    )
    designated_tracks_payload = designated_tracks_result["payload"]

    geoffrey_tracks = {}
    for candidate_id in designated_candidate_ids:
        track = designated_tracks_payload["designated_tracks"][candidate_id]
        if track["eligible"] is not True:
            geoffrey_tracks[candidate_id] = {
                "eligible": False,
                "geoffrey": None,
            }
            continue

        slug = _geoffrey_track_slug(candidate_id)
        track_lock_dir = lock_dir / "geoffrey" / slug
        geoffrey_result = run_geoffrey_final_gate_with_designated_track_lock(
            qualification_lock_dir=lock_dir,
            track_lock_dir=track_lock_dir,
            expected_binding=designated_tracks_payload["binding"],
            candidate_id=candidate_id,
            transcript_bytes=transcript_bytes,
            draft_bytes=draft_bytes,
            geoffrey_run_executor=geoffrey_run_executor,
        )
        geoffrey_tracks[candidate_id] = {
            "eligible": True,
            "geoffrey": geoffrey_result,
        }

    result = {
        "mode": "dry_run",
        "spent_usd": "0.00",
        "designated_tracks": designated_tracks_payload,
        "geoffrey_tracks": geoffrey_tracks,
    }
    if benchmark_binding is not None:
        result["benchmark_binding"] = benchmark_binding
    return result


def run_canonical_qualification_matrix_dry_run(
    *,
    lock_dir: Path,
    config: dict,
    fixture_set: dict,
    candidate_routes: dict,
    qualification_case_executor,
    qualification_evidence: dict,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    geoffrey_run_executor,
    benchmark_binding: dict | None = None,
    designated_candidate_ids: list[str] | None = None,
) -> dict:
    """Execute and aggregate the canonical 5x6 canned qualification matrix."""

    models = config.get("models") if isinstance(config, dict) else None
    cases = fixture_set.get("cases") if isinstance(fixture_set, dict) else None
    if (
        not isinstance(models, list)
        or len(models) != 5
        or any(not isinstance(model_id, str) or not model_id for model_id in models)
        or len(set(models)) != len(models)
    ):
        raise ValueError(
            "Benchmark v2 dry-run requires exactly five canonical candidate models"
        )
    require_canonical_candidate_ids(models)

    if (
        not isinstance(cases, list)
        or len(cases) != 6
        or any(not isinstance(fixture, dict) for fixture in cases)
    ):
        raise ValueError(
            "Benchmark v2 dry-run requires exactly six canonical qualification cases"
        )
    if not callable(qualification_case_executor):
        raise ValueError(
            "Benchmark v2 dry-run qualification case executor must be callable"
        )
    if not isinstance(candidate_routes, dict) or set(candidate_routes) != set(models):
        raise ValueError(
            "Benchmark v2 dry-run candidate routes must cover canonical models exactly"
        )
    if not isinstance(qualification_evidence, dict):
        raise ValueError(
            "Benchmark v2 dry-run qualification evidence must be an object"
        )

    case_ids = []
    case_artifacts = []
    for fixture in cases:
        case_id = fixture.get("case_id")
        hard_gate = fixture.get("hard_gate")
        if (
            not isinstance(case_id, str)
            or not case_id
            or case_id in case_ids
            or not isinstance(hard_gate, dict)
        ):
            raise ValueError(
                "Benchmark v2 dry-run qualification case identity is invalid"
            )
        case_ids.append(case_id)
        case_artifacts.append(
            {
                "case_id": case_id,
                "fixture_bytes": (
                    json.dumps(
                        fixture,
                        ensure_ascii=False,
                        indent=2,
                        sort_keys=True,
                    )
                    + "\n"
                ).encode("utf-8"),
                "gate_bytes": (
                    json.dumps(
                        hard_gate,
                        ensure_ascii=False,
                        indent=2,
                        sort_keys=True,
                    )
                    + "\n"
                ).encode("utf-8"),
            }
        )

    raw_case_records = []

    for model_id in models:
        route = candidate_routes[model_id]
        if not isinstance(route, dict):
            raise ValueError(
                "Benchmark v2 dry-run candidate route must be an object"
            )
        routing_provider_slug = route.get("routing_provider_slug")
        observed_served_provider = route.get(
            "observed_served_provider_identity"
        )
        if (
            not isinstance(routing_provider_slug, str)
            or not routing_provider_slug
            or not isinstance(observed_served_provider, str)
            or not observed_served_provider
        ):
            raise ValueError(
                "Benchmark v2 dry-run candidate route identity is invalid"
            )

        for fixture in cases:
            case_id = fixture["case_id"]
            execution = qualification_case_executor(
                model_id=model_id,
                fixture=fixture,
            )
            if not isinstance(execution, dict):
                raise ValueError(
                    "Benchmark v2 dry-run case execution must be an object"
                )

            raw_result = execution.get("result")
            if not isinstance(raw_result, dict):
                raise ValueError(
                    "Benchmark v2 dry-run raw case result must be an object"
                )

            case_repair_turns = execution.get("repair_turns")
            case_cost_usd = execution.get("cost_usd")
            case_latency_ms = execution.get("latency_ms")
            if (
                isinstance(case_repair_turns, bool)
                or not isinstance(case_repair_turns, int)
                or case_repair_turns < 0
                or case_repair_turns > 1
                or isinstance(case_latency_ms, bool)
                or not isinstance(case_latency_ms, int)
                or case_latency_ms < 0
                or not isinstance(case_cost_usd, str)
                or not case_cost_usd
            ):
                raise ValueError(
                    "Benchmark v2 dry-run case execution metrics are invalid"
                )
            try:
                parsed_case_cost = Decimal(case_cost_usd)
            except InvalidOperation as error:
                raise ValueError(
                    "Benchmark v2 dry-run case cost must be a decimal string"
                ) from error
            if not parsed_case_cost.is_finite() or parsed_case_cost < 0:
                raise ValueError(
                    "Benchmark v2 dry-run case cost must be finite and non-negative"
                )

            raw_case_records.append(
                {
                    "candidate_id": model_id,
                    "case_id": case_id,
                    "case_result": raw_result,
                    "routing_provider_slug": routing_provider_slug,
                    "served_provider": observed_served_provider,
                    "repair_turns": case_repair_turns,
                    "cost_usd": case_cost_usd,
                    "latency_ms": case_latency_ms,
                }
            )

    required_evidence_fields = (
        "config_bytes",
        "prompt_bytes",
        "provider_lock_bytes",
    )
    evidence = {}
    for field in required_evidence_fields:
        value = qualification_evidence.get(field)
        if not isinstance(value, bytes):
            raise ValueError(
                f"Benchmark v2 dry-run {field} must be exact bytes"
            )
        evidence[field] = value

    dry_run_qualification_inputs = {
        "canonical_candidate_ids": list(models),
        "canonical_case_ids": case_ids,
        "raw_case_records": raw_case_records,
        **evidence,
        "case_artifacts": case_artifacts,
    }
    if designated_candidate_ids is not None:
        return run_locked_qualification_geoffrey_dry_run_for_designated_tracks(
            lock_dir=Path(lock_dir),
            designated_candidate_ids=list(designated_candidate_ids),
            qualification_inputs=dry_run_qualification_inputs,
            transcript_bytes=transcript_bytes,
            draft_bytes=draft_bytes,
            geoffrey_run_executor=geoffrey_run_executor,
            benchmark_binding=benchmark_binding,
        )
    return run_locked_qualification_geoffrey_dry_run(
        lock_dir=Path(lock_dir),
        qualification_inputs=dry_run_qualification_inputs,
        transcript_bytes=transcript_bytes,
        draft_bytes=draft_bytes,
        geoffrey_run_executor=geoffrey_run_executor,
        benchmark_binding=benchmark_binding,
    )


def _canonical_geoffrey_json_bytes(value: object) -> bytes:
    try:
        return (
            json.dumps(
                value,
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
            + "\n"
        ).encode("utf-8")
    except (TypeError, ValueError) as error:
        raise ValueError(
            "Benchmark v2 Geoffrey final evidence is not canonical JSON"
        ) from error


def _validate_geoffrey_locked_candidate(selected_candidate: dict) -> None:
    if not isinstance(selected_candidate, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey locked candidate must be an object"
        )

    candidate_id = selected_candidate.get("candidate_id")
    model_id = selected_candidate.get("model_id")
    routing_provider_slug = selected_candidate.get("routing_provider_slug")
    observed_served_provider = selected_candidate.get(
        "observed_served_provider_identity"
    )
    eligibility = selected_candidate.get("eligibility")
    if (
        not isinstance(candidate_id, str)
        or not candidate_id
        or model_id != candidate_id
        or not isinstance(routing_provider_slug, str)
        or not routing_provider_slug
        or not isinstance(observed_served_provider, str)
        or not observed_served_provider
        or not isinstance(eligibility, dict)
        or eligibility.get("eligible") is not True
        or eligibility.get("passed_case_count") != 6
        or eligibility.get("required_case_count") != 6
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey locked candidate model/provider/eligibility identity is invalid"
        )


def _validate_geoffrey_qualification_lock_bytes(
    *,
    qualification_lock_bytes: bytes,
    expected_qualification_binding: dict,
    selected_candidate: dict,
) -> dict:
    """Validate exact canonical Task-7 ADVANCE bytes for Task-8 final evidence."""

    if not isinstance(qualification_lock_bytes, bytes):
        raise ValueError(
            "Benchmark v2 Geoffrey final evidence requires exact qualification lock bytes"
        )
    if not isinstance(expected_qualification_binding, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey final evidence requires the expected qualification binding"
        )

    _validate_geoffrey_locked_candidate(selected_candidate)

    try:
        payload = json.loads(qualification_lock_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 Geoffrey qualification lock evidence is invalid JSON"
        ) from error

    if not isinstance(payload, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey qualification lock evidence must be an object"
        )
    if set(payload) != {
        "lock_format",
        "decision",
        "binding",
        "selected_candidate",
    }:
        raise ValueError(
            "Benchmark v2 Geoffrey qualification lock evidence shape is invalid"
        )

    canonical_bytes = _canonical_geoffrey_json_bytes(payload)
    if qualification_lock_bytes != canonical_bytes:
        raise ValueError(
            "Benchmark v2 Geoffrey qualification lock evidence bytes are not canonical"
        )

    if (
        payload.get("lock_format") != 1
        or payload.get("decision") != "advance"
        or payload.get("binding") != expected_qualification_binding
        or payload.get("selected_candidate") != selected_candidate
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey qualification lock evidence does not match the exact ADVANCE decision"
        )

    return payload


def _geoffrey_terminal_failure_evaluation(stage: str) -> dict:
    if stage not in {"executor", "evaluator"}:
        raise ValueError(
            "Benchmark v2 Geoffrey terminal failure stage is invalid"
        )
    return {
        "hard_gate_passed": False,
        "failures": [f"terminal_failure:{stage}"],
    }


def build_geoffrey_final_binding(
    *,
    qualification_lock_bytes: bytes,
    expected_qualification_binding: dict,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    selected_candidate: dict,
    gate_result: dict,
    geoffrey_run_records: list[dict],
    _revalidate_machine_evidence: bool = False,
) -> dict:
    """Build deterministic Task-8 final evidence, with optional machine revalidation."""

    if not isinstance(_revalidate_machine_evidence, bool):
        raise ValueError(
            "Benchmark v2 Geoffrey machine-evidence revalidation flag must be boolean"
        )

    _validate_geoffrey_qualification_lock_bytes(
        qualification_lock_bytes=qualification_lock_bytes,
        expected_qualification_binding=expected_qualification_binding,
        selected_candidate=selected_candidate,
    )

    fixture_context = build_geoffrey_fixture_context(
        transcript_bytes=transcript_bytes,
        draft_bytes=draft_bytes,
    )
    review_context = fixture_context["review_context"]
    evaluator_private = build_geoffrey_evaluator_private(review_context)

    candidate_id = selected_candidate["candidate_id"]
    selected_candidate_bytes = _canonical_geoffrey_json_bytes(selected_candidate)

    if not isinstance(gate_result, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding gate result must be an object"
        )
    decision = gate_result.get("decision")
    required_run_count = gate_result.get("required_run_count")
    attempted_run_count = gate_result.get("attempted_run_count")
    completed_run_count = gate_result.get("completed_run_count")
    machine_pass_count = gate_result.get("machine_pass_count")
    if (
        decision not in {"no_winner", "sanity_review_required"}
        or required_run_count != 3
        or isinstance(attempted_run_count, bool)
        or not isinstance(attempted_run_count, int)
        or attempted_run_count < 1
        or attempted_run_count > required_run_count
        or isinstance(completed_run_count, bool)
        or not isinstance(completed_run_count, int)
        or completed_run_count < 0
        or completed_run_count > attempted_run_count
        or isinstance(machine_pass_count, bool)
        or not isinstance(machine_pass_count, int)
        or machine_pass_count < 0
        or machine_pass_count > completed_run_count
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding gate result is invalid"
        )
    if decision == "sanity_review_required" and (
        attempted_run_count != required_run_count
        or completed_run_count != required_run_count
        or machine_pass_count != required_run_count
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding sanity-review gate requires 3/3"
        )
    _canonical_geoffrey_json_bytes(gate_result)

    if (
        not isinstance(geoffrey_run_records, list)
        or len(geoffrey_run_records) != attempted_run_count
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding run evidence disagrees with attempted-run count"
        )

    records_by_number = {}
    for record in geoffrey_run_records:
        if not isinstance(record, dict):
            raise ValueError(
                "Benchmark v2 Geoffrey final binding run evidence must be an object"
            )
        run_number = record.get("run_number")
        if (
            isinstance(run_number, bool)
            or not isinstance(run_number, int)
            or run_number < 1
            or run_number > attempted_run_count
            or run_number in records_by_number
            or record.get("candidate_id") != candidate_id
        ):
            raise ValueError(
                "Benchmark v2 Geoffrey final binding run identity is invalid"
            )

        terminal_failure = record.get("terminal_failure")
        if terminal_failure is not None:
            if (
                not isinstance(terminal_failure, dict)
                or set(terminal_failure) != {"stage"}
                or terminal_failure.get("stage") not in {"executor", "evaluator"}
            ):
                raise ValueError(
                    "Benchmark v2 Geoffrey terminal failure evidence is invalid"
                )
            if terminal_failure["stage"] == "executor":
                if set(record) != {
                    "run_number",
                    "candidate_id",
                    "terminal_failure",
                }:
                    raise ValueError(
                        "Benchmark v2 Geoffrey executor failure must not contain completed case evidence"
                    )
            else:
                if set(record) != {
                    "run_number",
                    "candidate_id",
                    "case_result",
                    "terminal_failure",
                }:
                    raise ValueError(
                        "Benchmark v2 Geoffrey evaluator failure evidence is invalid"
                    )
                _canonical_geoffrey_json_bytes(record["case_result"])
        else:
            if set(record) != {
                "run_number",
                "candidate_id",
                "case_result",
                "machine_evaluation",
            }:
                raise ValueError(
                    "Benchmark v2 Geoffrey completed run evidence is malformed"
                )
            case_result = record["case_result"]
            machine_evaluation = record["machine_evaluation"]
            if not isinstance(case_result, dict):
                raise ValueError(
                    "Benchmark v2 Geoffrey final binding case result is invalid"
                )
            if (
                not isinstance(machine_evaluation, dict)
                or not isinstance(
                    machine_evaluation.get("hard_gate_passed"),
                    bool,
                )
            ):
                raise ValueError(
                    "Benchmark v2 Geoffrey final binding machine evidence is invalid"
                )
            if _revalidate_machine_evidence:
                expected_evaluation = evaluate_geoffrey_run(
                    review_context=review_context,
                    case_result=case_result,
                    evaluator_private=evaluator_private,
                    transcript=fixture_context["transcript"],
                    draft=fixture_context["draft"],
                )
                if machine_evaluation != expected_evaluation:
                    raise ValueError(
                        "Benchmark v2 Geoffrey final binding machine evidence does not match canonical evaluation"
                    )

        _canonical_geoffrey_json_bytes(record)
        records_by_number[run_number] = record

    expected_run_numbers = list(range(1, attempted_run_count + 1))
    if set(records_by_number) != set(expected_run_numbers):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding requires contiguous attempted runs"
        )
    sorted_records = [
        records_by_number[run_number]
        for run_number in expected_run_numbers
    ]

    completed_records = [
        record for record in sorted_records if "case_result" in record
    ]
    machine_records = [
        record for record in sorted_records if "machine_evaluation" in record
    ]
    terminal_records = [
        record for record in sorted_records if "terminal_failure" in record
    ]
    if len(completed_records) != completed_run_count:
        raise ValueError(
            "Benchmark v2 Geoffrey final binding completed case evidence disagrees with gate count"
        )

    pass_flags = [
        record["machine_evaluation"]["hard_gate_passed"]
        for record in machine_records
    ]
    if sum(pass_flags) != machine_pass_count:
        raise ValueError(
            "Benchmark v2 Geoffrey final binding machine-pass evidence disagrees with gate count"
        )

    if decision == "sanity_review_required":
        evidence_matches_gate = (
            not terminal_records
            and len(machine_records) == required_run_count
            and all(pass_flags)
        )
    elif terminal_records:
        terminal_record = terminal_records[-1]
        terminal_stage = terminal_record["terminal_failure"]["stage"]
        evidence_matches_gate = (
            len(terminal_records) == 1
            and terminal_record["run_number"] == attempted_run_count
        )
        if terminal_stage == "executor":
            evidence_matches_gate = (
                evidence_matches_gate
                and attempted_run_count == completed_run_count + 1
                and len(machine_records) == completed_run_count
                and machine_pass_count == completed_run_count
                and all(pass_flags)
            )
        else:
            evidence_matches_gate = (
                evidence_matches_gate
                and attempted_run_count == completed_run_count
                and completed_run_count >= 1
                and len(machine_records) == completed_run_count - 1
                and machine_pass_count == completed_run_count - 1
                and all(pass_flags)
            )
    else:
        evidence_matches_gate = (
            attempted_run_count == completed_run_count
            and completed_run_count >= 1
            and len(machine_records) == completed_run_count
            and pass_flags
            == [True] * (completed_run_count - 1) + [False]
            and machine_pass_count == completed_run_count - 1
        )

    if not evidence_matches_gate:
        raise ValueError(
            "Benchmark v2 Geoffrey final binding run evidence disagrees with gate"
        )

    return {
        "qualification_lock_sha256": _sha256_bytes(
            qualification_lock_bytes
        ),
        "geoffrey_transcript_sha256": fixture_context["transcript_sha256"],
        "geoffrey_draft_sha256": fixture_context["draft_sha256"],
        "geoffrey_evaluator_private_sha256": _sha256_bytes(
            _canonical_geoffrey_json_bytes(evaluator_private)
        ),
        "selected_candidate_sha256": _sha256_bytes(
            selected_candidate_bytes
        ),
        "gate_result": gate_result,
        "geoffrey_runs": [
            {
                "run_number": record["run_number"],
                "run_evidence_sha256": _sha256_bytes(
                    _canonical_geoffrey_json_bytes(record)
                ),
            }
            for record in sorted_records
        ],
    }


def write_geoffrey_final_decision_lock(
    *,
    lock_dir: Path,
    qualification_lock_bytes: bytes,
    expected_qualification_binding: dict,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    selected_candidate: dict,
    gate_result: dict,
    geoffrey_run_records: list[dict],
    sanity_review_accepted: bool | None,
) -> dict:
    """Revalidate raw Task-8 evidence, then write one immutable final decision."""

    binding = build_geoffrey_final_binding(
        qualification_lock_bytes=qualification_lock_bytes,
        expected_qualification_binding=expected_qualification_binding,
        transcript_bytes=transcript_bytes,
        draft_bytes=draft_bytes,
        selected_candidate=selected_candidate,
        gate_result=gate_result,
        geoffrey_run_records=geoffrey_run_records,
        _revalidate_machine_evidence=True,
    )
    gate_result = binding.get("gate_result")
    if not isinstance(gate_result, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock requires a gate result"
        )

    gate_decision = gate_result.get("decision")
    required_run_count = gate_result.get("required_run_count")
    attempted_run_count = gate_result.get("attempted_run_count")
    completed_run_count = gate_result.get("completed_run_count")
    machine_pass_count = gate_result.get("machine_pass_count")
    geoffrey_runs = binding.get("geoffrey_runs")

    if (
        required_run_count != 3
        or isinstance(attempted_run_count, bool)
        or not isinstance(attempted_run_count, int)
        or attempted_run_count < 1
        or attempted_run_count > required_run_count
        or isinstance(completed_run_count, bool)
        or not isinstance(completed_run_count, int)
        or completed_run_count < 0
        or completed_run_count > attempted_run_count
        or isinstance(machine_pass_count, bool)
        or not isinstance(machine_pass_count, int)
        or machine_pass_count < 0
        or machine_pass_count > completed_run_count
        or not isinstance(geoffrey_runs, list)
        or len(geoffrey_runs) != attempted_run_count
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock binding is inconsistent"
        )

    if gate_decision == "no_winner":
        count_shape_is_valid = (
            attempted_run_count == completed_run_count + 1
            and machine_pass_count == completed_run_count
        ) or (
            attempted_run_count == completed_run_count
            and completed_run_count >= 1
            and machine_pass_count == completed_run_count - 1
        )
        if not count_shape_is_valid:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock NO WINNER gate is invalid"
            )
        if sanity_review_accepted is not None:
            raise ValueError(
                "Benchmark v2 Geoffrey machine NO WINNER cannot accept a sanity decision"
            )
        decision = "no_winner"
        sanity_review = {
            "required": False,
            "accepted": None,
        }
    elif gate_decision == "sanity_review_required":
        if (
            attempted_run_count != 3
            or completed_run_count != 3
            or machine_pass_count != 3
        ):
            raise ValueError(
                "Benchmark v2 Geoffrey sanity review requires a 3/3 machine pass"
            )
        if type(sanity_review_accepted) is not bool:
            raise ValueError(
                "Benchmark v2 Geoffrey 3/3 result requires an explicit sanity decision"
            )
        decision = (
            "winner"
            if sanity_review_accepted
            else "no_winner"
        )
        sanity_review = {
            "required": True,
            "accepted": sanity_review_accepted,
        }
    else:
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock gate decision is invalid"
        )

    payload = {
        "lock_format": 1,
        "decision": decision,
        "binding": binding,
        "sanity_review": sanity_review,
    }
    expected_bytes = _canonical_geoffrey_json_bytes(payload)

    lock_dir = Path(lock_dir)
    filename = (
        "winner.lock.json"
        if decision == "winner"
        else "no_winner.lock.json"
    )
    opposite_filename = (
        "no_winner.lock.json"
        if decision == "winner"
        else "winner.lock.json"
    )
    target_path = lock_dir / filename
    opposite_path = lock_dir / opposite_filename

    if opposite_path.exists():
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock conflicts with an existing opposite decision"
        )

    if target_path.exists():
        if not target_path.is_file():
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock path is not a file"
            )
        try:
            existing_bytes = target_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock is unreadable"
            ) from error
        if existing_bytes != expected_bytes:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock is immutable and conflicts"
            )
        return {
            "path": target_path,
            "payload": payload,
        }

    try:
        lock_dir.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock directory is unavailable"
        ) from error

    if opposite_path.exists():
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock conflicts with an existing opposite decision"
        )

    try:
        with target_path.open("xb") as handle:
            handle.write(expected_bytes)
    except FileExistsError:
        try:
            existing_bytes = target_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock is unreadable"
            ) from error
        if existing_bytes != expected_bytes:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock is immutable and conflicts"
            )
    except OSError as error:
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock could not be written"
        ) from error

    return {
        "path": target_path,
        "payload": payload,
    }


def run_geoffrey_final_gate_with_qualification_lock(
    *,
    lock_dir: Path,
    expected_binding: dict,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    geoffrey_run_executor,
) -> dict:
    """Run canonical Task-8 Geoffrey evaluation and lock machine NO WINNER."""

    if not callable(geoffrey_run_executor):
        raise ValueError(
            "Benchmark v2 Geoffrey final-gate executor must be callable"
        )

    fixture_context = build_geoffrey_fixture_context(
        transcript_bytes=transcript_bytes,
        draft_bytes=draft_bytes,
    )
    review_context = fixture_context["review_context"]
    evaluator_private = build_geoffrey_evaluator_private(review_context)
    lock_dir = Path(lock_dir)

    def run_locked_candidate(selected_candidate):
        qualification_path = lock_dir / "qualification.lock.json"
        try:
            qualification_lock_bytes = qualification_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 Geoffrey final gate cannot read qualification lock bytes"
            ) from error

        run_records = []
        attempted_run_count = 0
        completed_run_count = 0
        machine_pass_count = 0
        required_run_count = 3

        def lock_no_winner_for_run(
            *,
            run_number: int,
            case_result=None,
            evaluation: dict | None = None,
            terminal_stage: str | None = None,
        ) -> dict:
            record = {
                "run_number": run_number,
                "candidate_id": selected_candidate["candidate_id"],
            }
            if terminal_stage == "executor":
                record["terminal_failure"] = {"stage": "executor"}
            elif terminal_stage == "evaluator":
                record["case_result"] = case_result
                record["terminal_failure"] = {"stage": "evaluator"}
            else:
                record["case_result"] = case_result
                record["machine_evaluation"] = evaluation
            run_records.append(record)
            gate_result = {
                "decision": "no_winner",
                "required_run_count": required_run_count,
                "attempted_run_count": attempted_run_count,
                "completed_run_count": completed_run_count,
                "machine_pass_count": machine_pass_count,
            }
            write_geoffrey_final_decision_lock(
                lock_dir=lock_dir,
                qualification_lock_bytes=qualification_lock_bytes,
                expected_qualification_binding=expected_binding,
                transcript_bytes=transcript_bytes,
                draft_bytes=draft_bytes,
                selected_candidate=selected_candidate,
                gate_result=gate_result,
                geoffrey_run_records=run_records,
                sanity_review_accepted=None,
            )
            return gate_result

        for run_number in range(1, required_run_count + 1):
            attempted_run_count += 1
            try:
                case_result = geoffrey_run_executor(
                    selected_candidate,
                    run_number,
                )
            except Exception:
                return lock_no_winner_for_run(
                    run_number=run_number,
                    terminal_stage="executor",
                )

            completed_run_count += 1
            try:
                evaluation = evaluate_geoffrey_run(
                    review_context=review_context,
                    case_result=case_result,
                    evaluator_private=evaluator_private,
                    transcript=fixture_context["transcript"],
                    draft=fixture_context["draft"],
                )
                if (
                    not isinstance(evaluation, dict)
                    or not isinstance(evaluation.get("hard_gate_passed"), bool)
                ):
                    raise ValueError(
                        "Benchmark v2 Geoffrey evaluator returned invalid machine evidence"
                    )
            except Exception:
                return lock_no_winner_for_run(
                    run_number=run_number,
                    case_result=case_result,
                    terminal_stage="evaluator",
                )

            if evaluation["hard_gate_passed"] is not True:
                return lock_no_winner_for_run(
                    run_number=run_number,
                    case_result=case_result,
                    evaluation=evaluation,
                )

            run_records.append(
                {
                    "run_number": run_number,
                    "candidate_id": selected_candidate["candidate_id"],
                    "case_result": case_result,
                    "machine_evaluation": evaluation,
                }
            )
            machine_pass_count += 1

        gate_result = {
            "decision": "sanity_review_required",
            "required_run_count": required_run_count,
            "attempted_run_count": attempted_run_count,
            "completed_run_count": completed_run_count,
            "machine_pass_count": machine_pass_count,
        }
        binding = build_geoffrey_final_binding(
            qualification_lock_bytes=qualification_lock_bytes,
            expected_qualification_binding=expected_binding,
            transcript_bytes=transcript_bytes,
            draft_bytes=draft_bytes,
            selected_candidate=selected_candidate,
            gate_result=gate_result,
            geoffrey_run_records=run_records,
            _revalidate_machine_evidence=True,
        )
        return {
            **gate_result,
            "binding": binding,
        }

    return run_geoffrey_with_qualification_lock(
        lock_dir=lock_dir,
        expected_binding=expected_binding,
        geoffrey_executor=run_locked_candidate,
    )


def load_provider_lock(config: dict, *, root: Path | None = None) -> dict:
    """Load the configured provider-lock input or fail closed."""

    if not isinstance(config, dict):
        raise ValueError("Benchmark provider lock config must be an object")

    configured_path = config.get("provider_lock_path")
    if not isinstance(configured_path, str) or not configured_path.strip():
        raise ValueError("Benchmark provider lock path is required")

    base = Path(root) if root is not None else REPOSITORY_ROOT
    path = base / configured_path

    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise ValueError("Benchmark provider lock input is unavailable") from error

    try:
        payload = json.loads(text)
    except json.JSONDecodeError as error:
        raise ValueError("Benchmark provider lock input is invalid JSON") from error

    if not isinstance(payload, dict):
        raise ValueError("Benchmark provider lock input must be an object")

    configured_models = config.get("models")
    locked_models = payload.get("models")
    if (
        not isinstance(configured_models, list)
        or not isinstance(locked_models, dict)
        or set(locked_models) != set(configured_models)
    ):
        raise ValueError("Benchmark provider lock model set must match configured models")

    for model in configured_models:
        entry = locked_models[model]
        routing_provider_slug = (
            entry.get("routing_provider_slug") if isinstance(entry, dict) else None
        )
        if (
            not isinstance(routing_provider_slug, str)
            or not routing_provider_slug.strip()
        ):
            raise ValueError(
                "Benchmark provider lock routing_provider_slug must be a non-empty string"
            )

        compatible_served_providers = (
            entry.get("compatible_served_providers") if isinstance(entry, dict) else None
        )
        if (
            not isinstance(compatible_served_providers, list)
            or not compatible_served_providers
            or any(
                not isinstance(provider, str) or not provider.strip()
                for provider in compatible_served_providers
            )
            or len(set(compatible_served_providers)) != len(compatible_served_providers)
        ):
            raise ValueError(
                "Benchmark provider lock compatible_served_providers must be a non-empty list of unique non-empty strings"
            )

    return payload


def provider_policy_for_model(
    config: dict,
    provider_lock: dict,
    model_id: str,
) -> dict:
    """Build the exact request-time provider policy for one locked candidate."""

    provider = dict(config["provider"])
    routing_provider_slug = provider_lock["models"][model_id]["routing_provider_slug"]
    provider["only"] = [routing_provider_slug]
    return provider


def validate_served_provider(
    provider_lock: dict,
    model_id: str,
    served_provider: str,
    *,
    expected_served_provider: str | None = None,
) -> str:
    """Validate actual served-provider identity against the frozen lock."""

    if not isinstance(served_provider, str) or not served_provider.strip():
        raise ValueError("Benchmark served provider must be a non-empty string")

    compatible_served_providers = provider_lock["models"][model_id][
        "compatible_served_providers"
    ]
    if served_provider not in compatible_served_providers:
        raise ValueError(
            "Benchmark served provider is not compatible with the frozen provider lock"
        )

    if expected_served_provider is not None:
        if (
            not isinstance(expected_served_provider, str)
            or not expected_served_provider.strip()
        ):
            raise ValueError("Benchmark expected served provider must be a non-empty string")
        if served_provider != expected_served_provider:
            raise ValueError(
                "Benchmark served provider changed across case calls; identity must remain stable"
            )

    return served_provider


def _require_max_completion_tokens(config: dict) -> int:
    raw_value = (
        config.get("max_completion_tokens_per_call")
        if isinstance(config, dict)
        else None
    )
    if (
        isinstance(raw_value, bool)
        or not isinstance(raw_value, int)
        or raw_value <= 0
    ):
        raise ValueError(
            "Benchmark v2 completion token ceiling must be a positive integer"
        )
    return raw_value


def _require_temperature(config: dict) -> float:
    """The sampling temperature every compatible benchmark call must use.

    Benchmark v2 previously sent no ``temperature`` at all, silently
    defaulting to each provider's own baseline (commonly ``1.0``) instead of
    the ``temperature: 0.2`` the production "Podcast Summary" OpenRouter
    preset actually uses. That let every candidate run measurably hotter
    than production, which is not a fair or representative comparison. This
    requires an explicit, canonical value so every compatible candidate is
    exercised under the same, production-matching sampling behavior. Explicit
    unsupported-model omissions are validated separately and remain part of
    the canonical config binding.
    """

    raw_value = config.get("temperature") if isinstance(config, dict) else None
    if (
        isinstance(raw_value, bool)
        or not isinstance(raw_value, (int, float))
        or not (0 <= raw_value <= 2)
    ):
        raise ValueError(
            "Benchmark v2 temperature must be a number between 0 and 2"
        )
    return float(raw_value)


def _temperature_for_model(config: dict, model_id: str) -> float | None:
    """Resolve one candidate's explicit, fail-closed temperature policy."""

    temperature = _require_temperature(config)
    models = config.get("models") if isinstance(config, dict) else None
    unsupported_models = (
        config.get("temperature_unsupported_models", [])
        if isinstance(config, dict)
        else None
    )
    if (
        not isinstance(models, list)
        or any(not isinstance(candidate, str) or not candidate for candidate in models)
        or len(set(models)) != len(models)
        or not isinstance(unsupported_models, list)
        or any(
            not isinstance(candidate, str) or not candidate
            for candidate in unsupported_models
        )
        or len(set(unsupported_models)) != len(unsupported_models)
        or not set(unsupported_models).issubset(models)
    ):
        raise ValueError(
            "Benchmark v2 temperature unsupported models must be unique "
            "canonical candidates"
        )
    if not isinstance(model_id, str) or model_id not in models:
        raise ValueError("Benchmark v2 temperature model must be canonical")
    if model_id in unsupported_models:
        return None
    return temperature


def derive_call_reservation_usd(
    pricing_entry: dict,
    *,
    max_completion_tokens: int,
) -> Decimal:
    """Derive one conservative paid-call reservation from frozen pricing."""

    if not isinstance(pricing_entry, dict):
        raise ValueError(
            "Benchmark v2 pricing evidence entry must be an object"
        )
    if (
        isinstance(max_completion_tokens, bool)
        or not isinstance(max_completion_tokens, int)
        or max_completion_tokens <= 0
    ):
        raise ValueError(
            "Benchmark v2 completion token ceiling must be a positive integer"
        )

    context_length_tokens = pricing_entry.get("context_length_tokens")
    if (
        isinstance(context_length_tokens, bool)
        or not isinstance(context_length_tokens, int)
        or context_length_tokens <= max_completion_tokens
    ):
        raise ValueError(
            "Benchmark v2 pricing context length must be an integer above "
            "the completion token ceiling"
        )

    parsed_prices = {}
    for field in (
        "prompt_usd_per_token",
        "completion_usd_per_token",
    ):
        raw_value = pricing_entry.get(field)
        if not isinstance(raw_value, str) or not raw_value:
            raise ValueError(
                f"Benchmark v2 paid readiness {field} must be a decimal string"
            )
        try:
            value = Decimal(raw_value)
        except InvalidOperation as error:
            raise ValueError(
                f"Benchmark v2 paid readiness {field} must be a decimal string"
            ) from error
        if not value.is_finite() or value < 0:
            raise ValueError(
                f"Benchmark v2 paid readiness {field} must be finite and non-negative"
            )
        parsed_prices[field] = value

    max_prompt_tokens = context_length_tokens - max_completion_tokens
    reservation = (
        Decimal(max_prompt_tokens) * parsed_prices["prompt_usd_per_token"]
        + Decimal(max_completion_tokens)
        * parsed_prices["completion_usd_per_token"]
    )
    if not reservation.is_finite() or reservation <= 0:
        raise ValueError(
            "Benchmark v2 derived call reservation must be positive"
        )
    return reservation


def build_paid_execution_readiness(
    *,
    run_bundle: dict,
    journal_state: dict,
) -> dict:
    """Prove pending-candidate admission from one canonical bundle and journal."""

    if not isinstance(run_bundle, dict):
        raise ValueError(
            "Benchmark v2 paid readiness run bundle must be an object"
        )
    if not isinstance(journal_state, dict):
        raise ValueError(
            "Benchmark v2 paid readiness journal state must be an object"
        )

    config = run_bundle.get("config")
    if not isinstance(config, dict):
        raise ValueError("Benchmark v2 paid readiness config must be an object")

    models = config.get("models")
    if (
        not isinstance(models, list)
        or len(models) != 5
        or any(not isinstance(model_id, str) or not model_id for model_id in models)
        or len(set(models)) != len(models)
    ):
        raise ValueError(
            "Benchmark v2 paid readiness requires exactly five canonical candidates"
        )
    require_canonical_candidate_ids(models)

    candidate_ids = run_bundle.get("canonical_candidate_ids")
    if (
        not isinstance(candidate_ids, (list, tuple))
        or tuple(candidate_ids) != tuple(models)
    ):
        raise ValueError(
            "Benchmark v2 paid readiness run bundle candidate order is not canonical"
        )

    max_completion_tokens = _require_max_completion_tokens(config)
    try:
        budget_usd = Decimal(config["budget_usd"])
    except (KeyError, InvalidOperation, TypeError) as error:
        raise ValueError("Benchmark v2 paid readiness hard budget is invalid") from error
    if not budget_usd.is_finite() or budget_usd != Decimal("6.00"):
        raise ValueError(
            "Benchmark v2 paid readiness hard budget must remain exactly $6.00"
        )

    provider_lock = run_bundle.get("provider_lock")
    provider_lock_bytes = run_bundle.get("provider_lock_bytes")
    if not isinstance(provider_lock, dict):
        raise ValueError("Benchmark v2 paid readiness provider lock must be an object")
    locked_models = provider_lock.get("models")
    if not isinstance(locked_models, dict) or set(locked_models) != set(models):
        raise ValueError(
            "Benchmark v2 paid readiness provider lock must cover all five canonical candidates"
        )
    if not isinstance(provider_lock_bytes, bytes) or not provider_lock_bytes:
        raise ValueError(
            "Benchmark v2 paid readiness provider lock bytes are required"
        )
    try:
        frozen_provider_lock = json.loads(provider_lock_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 paid readiness provider lock bytes are invalid"
        ) from error
    canonical_provider_lock_bytes = (
        json.dumps(
            frozen_provider_lock,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
        + "\n"
    ).encode("utf-8")
    if (
        frozen_provider_lock != provider_lock
        or provider_lock_bytes != canonical_provider_lock_bytes
    ):
        raise ValueError(
            "Benchmark v2 paid readiness provider lock bytes do not match runtime provider lock"
        )

    pricing_evidence = run_bundle.get("pricing_evidence")
    pricing_evidence_bytes = run_bundle.get("pricing_evidence_bytes")
    if not isinstance(pricing_evidence, dict):
        raise ValueError(
            "Benchmark v2 paid readiness pricing evidence must be an object"
        )
    if not isinstance(pricing_evidence_bytes, bytes) or not pricing_evidence_bytes:
        raise ValueError(
            "Benchmark v2 paid readiness pricing evidence bytes are required"
        )
    try:
        frozen_pricing_evidence = json.loads(
            pricing_evidence_bytes.decode("utf-8")
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 paid readiness pricing evidence bytes are invalid"
        ) from error
    canonical_pricing_evidence_bytes = (
        json.dumps(
            frozen_pricing_evidence,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
        + "\n"
    ).encode("utf-8")
    if (
        frozen_pricing_evidence != pricing_evidence
        or pricing_evidence_bytes != canonical_pricing_evidence_bytes
    ):
        raise ValueError(
            "Benchmark v2 paid readiness pricing evidence must be canonical JSON"
        )

    pricing_models = pricing_evidence.get("models")
    if not isinstance(pricing_models, dict) or set(pricing_models) != set(models):
        raise ValueError(
            "Benchmark v2 paid readiness pricing evidence must cover all five canonical candidates"
        )

    reservation_authority = run_bundle.get(
        "derived_call_reservation_usd_by_model"
    )
    if (
        not isinstance(reservation_authority, dict)
        or set(reservation_authority) != set(models)
    ):
        raise ValueError(
            "Benchmark v2 paid readiness run bundle reservations are invalid"
        )

    reservation_usd_by_model = {}
    routable_candidate_count = 0
    for model_id in models:
        lock_entry = locked_models.get(model_id)
        pricing_entry = pricing_models.get(model_id)
        if not isinstance(lock_entry, dict) or not isinstance(pricing_entry, dict):
            raise ValueError(
                "Benchmark v2 paid readiness model evidence must be objects"
            )

        routing_provider_slug = lock_entry.get("routing_provider_slug")
        compatible_served_providers = lock_entry.get("compatible_served_providers")
        if (
            not isinstance(routing_provider_slug, str)
            or not routing_provider_slug
            or not isinstance(compatible_served_providers, list)
            or not compatible_served_providers
            or any(
                not isinstance(provider, str) or not provider
                for provider in compatible_served_providers
            )
            or len(set(compatible_served_providers))
            != len(compatible_served_providers)
        ):
            raise ValueError(
                "Benchmark v2 paid readiness frozen provider lock is invalid"
            )

        evidence_route = pricing_entry.get("routing_provider_slug")
        available_provider_slugs = pricing_entry.get("available_provider_slugs")
        if (
            evidence_route != routing_provider_slug
            or not isinstance(available_provider_slugs, list)
            or not available_provider_slugs
            or any(
                not isinstance(provider, str) or not provider
                for provider in available_provider_slugs
            )
            or len(set(available_provider_slugs))
            != len(available_provider_slugs)
            or routing_provider_slug not in available_provider_slugs
        ):
            raise ValueError(
                "Benchmark v2 paid readiness all five canonical candidates must be routable"
            )
        routable_candidate_count += 1

        derived_reservation = derive_call_reservation_usd(
            pricing_entry,
            max_completion_tokens=max_completion_tokens,
        )
        if "call_reservation_usd" in pricing_entry:
            raise ValueError(
                "Benchmark v2 paid readiness caller-supplied call reservation "
                "is not authoritative"
            )
        authority_value = reservation_authority.get(model_id)
        if not isinstance(authority_value, str) or not authority_value:
            raise ValueError(
                "Benchmark v2 paid readiness run bundle reservation is invalid"
            )
        try:
            authority_reservation = Decimal(authority_value)
        except InvalidOperation as error:
            raise ValueError(
                "Benchmark v2 paid readiness run bundle reservation is invalid"
            ) from error
        if (
            not authority_reservation.is_finite()
            or authority_reservation <= 0
            or authority_reservation != derived_reservation
        ):
            raise ValueError(
                "Benchmark v2 paid readiness run bundle reservation conflicts "
                "with frozen pricing"
            )
        reservation_usd_by_model[model_id] = format(
            derived_reservation.normalize(),
            "f",
        )

    if routable_candidate_count != len(models):
        raise ValueError(
            "Benchmark v2 paid readiness all five canonical candidates must be routable"
        )

    benchmark_binding = run_bundle.get("benchmark_binding")
    binding_fields = (
        "config_sha256",
        "fixture_set_sha256",
        "reviewer_prompt_sha256",
        "provider_lock_sha256",
        "pricing_evidence_sha256",
        "geoffrey_transcript_sha256",
        "geoffrey_draft_sha256",
    )
    if (
        not isinstance(benchmark_binding, dict)
        or set(benchmark_binding) != set(binding_fields)
    ):
        raise ValueError(
            "Benchmark v2 paid readiness run bundle binding is invalid"
        )
    for field in binding_fields:
        value = benchmark_binding.get(field)
        if (
            not isinstance(value, str)
            or re.fullmatch(r"sha256:[0-9a-f]{64}", value) is None
        ):
            raise ValueError(
                "Benchmark v2 paid readiness run bundle binding is invalid"
            )
    if (
        benchmark_binding["provider_lock_sha256"]
        != _sha256_bytes(provider_lock_bytes)
        or benchmark_binding["pricing_evidence_sha256"]
        != _sha256_bytes(pricing_evidence_bytes)
    ):
        raise ValueError(
            "Benchmark v2 paid readiness run bundle binding hash conflicts"
        )

    ordered_case_keys = run_bundle.get("ordered_case_keys")
    if (
        not isinstance(ordered_case_keys, list)
        or not ordered_case_keys
        or journal_state.get("ordered_case_keys") != ordered_case_keys
    ):
        raise ValueError(
            "Benchmark v2 paid readiness journal case order is not canonical"
        )
    if journal_state.get("journal_format") != JOURNAL_FORMAT:
        raise ValueError(
            "Benchmark v2 paid readiness journal format is invalid"
        )
    if journal_state.get("benchmark_binding") != benchmark_binding:
        raise ValueError(
            "Benchmark v2 paid readiness journal binding conflicts"
        )

    attempts = journal_state.get("attempts")
    if not isinstance(attempts, list):
        raise ValueError(
            "Benchmark v2 paid readiness journal attempts are invalid"
        )
    for attempt in attempts:
        if (
            not isinstance(attempt, dict)
            or attempt.get("case_key") not in ordered_case_keys
            or attempt.get("status")
            not in {
                "reserved",
                "completed",
                "cost_unknown",
                "transport_failed",
            }
        ):
            raise ValueError(
                "Benchmark v2 paid readiness journal attempt is invalid"
            )
        if attempt["status"] in {
            "reserved",
            "cost_unknown",
            "transport_failed",
        }:
            raise ValueError(
                "Benchmark v2 paid readiness has unresolved in-flight liability"
            )

    resumed = resume_execution_state(
        {
            "spent_usd": journal_state.get("spent_usd"),
            "completed_case_keys": journal_state.get(
                "completed_case_keys"
            ),
        },
        ordered_case_keys,
    )
    pending_case_keys = resumed["pending_case_keys"]
    if not pending_case_keys:
        raise ValueError(
            "Benchmark v2 paid readiness requires a pending paid case"
        )

    next_case_key = pending_case_keys[0]
    next_model_id = next_case_key.split("::", 1)[0]
    if next_model_id not in reservation_usd_by_model:
        raise ValueError(
            "Benchmark v2 paid readiness next case model is not canonical"
        )

    next_call_reservation_usd = Decimal(
        reservation_usd_by_model[next_model_id]
    )
    spent_usd = resumed["spent_usd"]
    pending_model_ids = [
        model_id
        for model_id in models
        if any(
            case_key.startswith(f"{model_id}::")
            for case_key in pending_case_keys
        )
    ]
    for pending_model_id in pending_model_ids:
        admit_paid_call(
            budget_usd,
            spent_usd,
            Decimal(reservation_usd_by_model[pending_model_id]),
        )

    remaining_usd = budget_usd - spent_usd
    return {
        "ready": True,
        "budget_usd": format(budget_usd, "f"),
        "spent_usd": format(spent_usd, "f"),
        "remaining_usd": format(remaining_usd, "f"),
        "next_case_key": next_case_key,
        "next_model_id": next_model_id,
        "next_call_reservation_usd": format(
            next_call_reservation_usd,
            "f",
        ),
        "candidate_count": len(models),
        "routable_candidate_count": routable_candidate_count,
        "provider_lock_sha256": _sha256_bytes(provider_lock_bytes),
        "pricing_evidence_sha256": _sha256_bytes(pricing_evidence_bytes),
        "reservation_usd_by_model": reservation_usd_by_model,
        "benchmark_binding": benchmark_binding,
    }


def admit_paid_call(
    budget_usd: Decimal,
    spent_usd: Decimal,
    reservation_usd: Decimal,
) -> bool:
    """Admit one paid call only when its reservation stays within the hard budget."""

    values = (budget_usd, spent_usd, reservation_usd)
    if any(not isinstance(value, Decimal) for value in values):
        raise TypeError("Benchmark budget values must be Decimal instances")

    if spent_usd + reservation_usd > budget_usd:
        raise ValueError("Benchmark paid call would exceed the hard budget")

    return True


def completed_call_cost_usd(payload: dict) -> Decimal:
    """Return reliable non-negative completed-call cost telemetry or fail closed."""

    usage = payload.get("usage") if isinstance(payload, dict) else None
    cost = usage.get("cost") if isinstance(usage, dict) else None
    if isinstance(cost, bool) or cost is None:
        raise ValueError("Benchmark completed-call cost telemetry is unavailable")

    try:
        cost_usd = Decimal(str(cost))
    except (InvalidOperation, ValueError) as error:
        raise ValueError("Benchmark completed-call cost telemetry is invalid") from error

    if not cost_usd.is_finite() or cost_usd < 0:
        raise ValueError("Benchmark completed-call cost must be finite and non-negative")

    return cost_usd


def record_completed_case(
    persisted_state: dict,
    ordered_case_keys: list[str],
    case_key: str,
    response_payload: dict,
) -> dict:
    """Record one completed case with its actual completed-call cost."""

    resumed = resume_execution_state(persisted_state, ordered_case_keys)
    if case_key not in ordered_case_keys:
        raise ValueError("Benchmark case key is not canonical")

    if case_key in resumed["completed_case_keys"]:
        raise ValueError("Benchmark case is already completed")

    cost_usd = completed_call_cost_usd(response_payload)
    spent_usd = resumed["spent_usd"] + cost_usd

    return {
        "spent_usd": format(spent_usd, "f"),
        "completed_case_keys": [
            *resumed["completed_case_keys"],
            case_key,
        ],
    }


def resume_execution_state(
    persisted_state: dict,
    ordered_case_keys: list[str],
) -> dict:
    """Normalize persisted spend and exclude completed cases from benchmark re-entry."""

    if not isinstance(persisted_state, dict):
        raise ValueError("Benchmark re-entry state must be an object")
    if (
        not isinstance(ordered_case_keys, list)
        or any(not isinstance(key, str) or not key for key in ordered_case_keys)
        or len(set(ordered_case_keys)) != len(ordered_case_keys)
    ):
        raise ValueError("Benchmark ordered case keys must be unique non-empty strings")

    spent_text = persisted_state.get("spent_usd")
    if not isinstance(spent_text, str) or not spent_text:
        raise ValueError("Benchmark re-entry spent_usd must be a decimal string")
    try:
        spent_usd = Decimal(spent_text)
    except InvalidOperation as error:
        raise ValueError("Benchmark re-entry spent_usd must be a decimal string") from error
    if not spent_usd.is_finite() or spent_usd < 0:
        raise ValueError("Benchmark re-entry spent_usd must be a finite non-negative Decimal")

    completed_case_keys = persisted_state.get("completed_case_keys")
    if (
        not isinstance(completed_case_keys, list)
        or any(not isinstance(key, str) or not key for key in completed_case_keys)
        or len(set(completed_case_keys)) != len(completed_case_keys)
    ):
        raise ValueError("Benchmark completed case keys must be unique non-empty strings")

    known_case_keys = set(ordered_case_keys)
    if any(key not in known_case_keys for key in completed_case_keys):
        raise ValueError("Benchmark completed case key is not present in the execution plan")

    failed_case_keys = persisted_state.get("failed_case_keys", [])
    if (
        not isinstance(failed_case_keys, list)
        or any(not isinstance(key, str) or not key for key in failed_case_keys)
        or len(set(failed_case_keys)) != len(failed_case_keys)
    ):
        raise ValueError("Benchmark failed case keys must be unique non-empty strings")
    if any(key not in known_case_keys for key in failed_case_keys):
        raise ValueError("Benchmark failed case key is not present in the execution plan")

    completed = tuple(completed_case_keys)
    failed = tuple(failed_case_keys)
    if set(completed) & set(failed):
        raise ValueError("Benchmark completed and failed case keys overlap")
    resolved_set = set(completed) | set(failed)
    resolved = tuple(key for key in ordered_case_keys if key in resolved_set)
    pending = tuple(key for key in ordered_case_keys if key not in resolved_set)

    return {
        "spent_usd": spent_usd,
        "completed_case_keys": completed,
        "failed_case_keys": failed,
        "resolved_case_keys": resolved,
        "pending_case_keys": pending,
    }


def prepare_qualification_reentry(
    *,
    persisted_state: dict,
    ordered_case_keys: list[str],
    persisted_case_results: list[dict],
) -> dict:
    """Bind completed execution state to exactly the saved qualification evidence."""

    resumed = resume_execution_state(persisted_state, ordered_case_keys)
    if not isinstance(persisted_case_results, list):
        raise ValueError("Benchmark persisted case results must be a list")

    evidence_case_keys = []
    for case_result in persisted_case_results:
        if not isinstance(case_result, dict):
            raise ValueError("Benchmark persisted case result must be an object")

        candidate_id = case_result.get("candidate_id")
        case_id = case_result.get("case_id")
        result = case_result.get("result")
        if (
            not isinstance(candidate_id, str)
            or not candidate_id
            or not isinstance(case_id, str)
            or not case_id
            or not isinstance(result, dict)
        ):
            raise ValueError("Benchmark persisted case result evidence is invalid")

        evidence_case_keys.append(f"{candidate_id}::{case_id}")

    if len(set(evidence_case_keys)) != len(evidence_case_keys):
        raise ValueError("Benchmark persisted case result evidence is duplicated")

    completed_case_keys = resumed["completed_case_keys"]
    if set(evidence_case_keys) != set(completed_case_keys):
        raise ValueError(
            "Benchmark completed case state does not match persisted case result evidence"
        )

    return {
        "spent_usd": resumed["spent_usd"],
        "completed_case_keys": completed_case_keys,
        "pending_case_keys": resumed["pending_case_keys"],
        "completed_case_results": tuple(persisted_case_results),
    }


def perform_transport_attempt(
    transport,
    *,
    attempt_number: int,
    max_calls_per_case: int,
):
    """Perform exactly one transport call within the per-case call cap."""

    effective_call_cap = min(max_calls_per_case, 3)
    if attempt_number > effective_call_cap:
        raise ValueError("Benchmark transport call cap exceeded")

    return transport()


def _audit_hard_gate_failures(
    fixture: dict,
    audit_result: dict,
) -> list[str]:
    hard_gate = fixture["hard_gate"]
    failures = []

    if audit_result["status"] != hard_gate["required_status"]:
        failures.append("required_status")

    assessments = {
        assessment["risk_id"]: assessment
        for assessment in audit_result["risk_assessments"]
    }
    for expectation in hard_gate["risk_expectations"]:
        for risk_id in expectation["risk_ids"]:
            assessment = assessments.get(risk_id)
            if assessment is None:
                failures.append(f"missing_risk:{risk_id}")
                continue
            if assessment["disposition"] != expectation["required_disposition"]:
                failures.append(f"risk_disposition:{risk_id}")
            required_issue_type = expectation.get("required_issue_type")
            if (
                required_issue_type is not None
                and assessment["issue_type"] != required_issue_type
            ):
                failures.append(f"risk_issue_type:{risk_id}")

    actual_additional_issue_types = [
        issue["issue_type"] for issue in audit_result["additional_issues"]
    ]
    if actual_additional_issue_types != hard_gate["required_additional_issue_types"]:
        failures.append("additional_issue_types")

    additional_expectations = hard_gate.get("additional_issue_expectations", [])
    if len(audit_result["additional_issues"]) == len(additional_expectations):
        for issue, expectation in zip(
            audit_result["additional_issues"],
            additional_expectations,
        ):
            if (
                issue["issue_type"] != expectation["required_issue_type"]
                or issue["draft_block_ids"] != expectation["draft_block_ids"]
                or issue["transcript_span_ids"] != expectation["transcript_span_ids"]
            ):
                failures.append(
                    f"additional_issue_evidence:{expectation['required_issue_type']}"
                )

    return failures


def _risk_evidence_is_minimal_and_valid(
    review_context: dict,
    audit_result: dict,
) -> bool:
    risks = {
        risk["risk_id"]: risk
        for risk in review_context["risk_inventory"]["risks"]
    }
    spans = {
        span["span_id"]
        for span in review_context["transcript_span_index"]["spans"]
    }
    assessments = {
        assessment["risk_id"]: assessment
        for assessment in audit_result["risk_assessments"]
    }

    if set(assessments) != set(risks):
        return False

    for risk_id, risk in risks.items():
        assessment = assessments[risk_id]
        if assessment["draft_block_ids"] != [risk["draft_block_id"]]:
            return False

        span_ids = assessment["transcript_span_ids"]
        if len(span_ids) != len(set(span_ids)) or any(
            span_id not in spans for span_id in span_ids
        ):
            return False

        if assessment["disposition"] == "not_applicable":
            if span_ids:
                return False
        elif len(span_ids) != 1:
            return False

    return True


def _additional_issue_evidence_matches_hard_gate(
    fixture: dict,
    audit_result: dict,
) -> bool:
    expectations = fixture["hard_gate"].get("additional_issue_expectations", [])
    issues = audit_result["additional_issues"]

    if len(issues) != len(expectations):
        return False

    for issue, expectation in zip(issues, expectations):
        if (
            issue["issue_type"] != expectation["required_issue_type"]
            or issue["draft_block_ids"] != expectation["draft_block_ids"]
            or issue["transcript_span_ids"] != expectation["transcript_span_ids"]
        ):
            return False

    return True


def evaluate_quality_predicate(
    predicate: str,
    fixture: dict,
    review_context: dict,
    case_result: dict,
) -> bool:
    """Evaluate one deterministic Benchmark v2 quality assertion predicate."""

    if (
        case_result["audit_result"].get("status") == "fail"
        and predicate
        in {
            "pass_edit_is_byte_preserving",
            "final_omits_forbidden_substrings",
            "final_contains_any_required_substring",
            "final_respects_occurrence_limits",
            "untargeted_supported_content_preserved",
        }
    ):
        return False

    if predicate == "audit_matches_hard_gate":
        return not _audit_hard_gate_failures(
            fixture,
            case_result["audit_result"],
        )

    if predicate == "issue_evidence_is_minimal_and_valid":
        return _risk_evidence_is_minimal_and_valid(
            review_context,
            case_result["audit_result"],
        )

    if predicate == "additional_issue_evidence_matches_hard_gate":
        return _additional_issue_evidence_matches_hard_gate(
            fixture,
            case_result["audit_result"],
        )

    if predicate == "pass_edit_is_byte_preserving":
        edit_result = case_result["edit_result"]
        return (
            edit_result is not None
            and edit_result["resolved_issue_ids"] == []
            and edit_result["final_markdown"] == fixture["draft"]
            and case_result["accepted_final_markdown"] == fixture["draft"]
        )

    if predicate == "final_omits_forbidden_substrings":
        forbidden_substrings = fixture["hard_gate"].get(
            "forbidden_final_substrings",
            [],
        )
        final_markdown = case_result["accepted_final_markdown"]
        return all(
            substring not in final_markdown
            for substring in forbidden_substrings
        )

    if predicate == "final_contains_any_required_substring":
        required_substrings = fixture["hard_gate"].get(
            "required_final_any_substrings",
            [],
        )
        final_markdown = case_result["accepted_final_markdown"]
        return bool(required_substrings) and any(
            substring in final_markdown for substring in required_substrings
        )

    if predicate == "final_respects_occurrence_limits":
        occurrence_limits = fixture["hard_gate"].get("max_final_occurrences", {})
        final_markdown = case_result["accepted_final_markdown"]
        return all(
            final_markdown.count(text) <= maximum
            for text, maximum in occurrence_limits.items()
        )

    if predicate == "untargeted_supported_content_preserved":
        if not fixture["hard_gate"].get(
            "preserve_unrelated_supported_content",
            False,
        ):
            return True

        obligations = build_edit_obligations(case_result["audit_result"])
        targeted_block_ids = {
            block_id
            for obligation in obligations
            for block_id in obligation["draft_block_ids"]
        }

        required_counts: dict[str, int] = {}
        for block in review_context["draft_block_index"]["blocks"]:
            if block["block_id"] in targeted_block_ids:
                continue
            text = block["text"]
            required_counts[text] = required_counts.get(text, 0) + 1

        final_markdown = case_result["accepted_final_markdown"]
        if not isinstance(final_markdown, str):
            return False

        final_counts: dict[str, int] = {}
        for block in build_draft_block_index(final_markdown)["blocks"]:
            text = block["text"]
            final_counts[text] = final_counts.get(text, 0) + 1

        return all(
            final_counts.get(text, 0) >= required_count
            for text, required_count in required_counts.items()
        )

    raise ValueError(f"Unsupported Benchmark v2 quality predicate: {predicate}")


def score_qualification_case(
    fixture: dict,
    review_context: dict,
    case_result: dict,
) -> dict:
    """Score one deterministic Benchmark v2 qualification fixture from 0 to 100."""

    quality_assertions = fixture.get("quality_assertions")
    if not isinstance(quality_assertions, dict) or not quality_assertions:
        raise ValueError("Benchmark v2 quality assertions must be a non-empty object")

    category_scores: dict[str, int] = {}
    assertion_results = []
    seen_assertion_ids = set()
    score = 0
    max_score = 0

    for category, assertions in quality_assertions.items():
        if (
            not isinstance(category, str)
            or not category
            or not isinstance(assertions, list)
            or not assertions
        ):
            raise ValueError("Benchmark v2 quality assertion category is invalid")

        category_score = 0
        for assertion in assertions:
            if not isinstance(assertion, dict):
                raise ValueError("Benchmark v2 quality assertion must be an object")

            assertion_id = assertion.get("assertion_id")
            predicate = assertion.get("predicate")
            weight = assertion.get("weight")
            if (
                not isinstance(assertion_id, str)
                or not assertion_id
                or assertion_id in seen_assertion_ids
                or not isinstance(predicate, str)
                or not predicate
                or isinstance(weight, bool)
                or not isinstance(weight, int)
                or weight <= 0
            ):
                raise ValueError("Benchmark v2 quality assertion is invalid")

            seen_assertion_ids.add(assertion_id)
            passed = evaluate_quality_predicate(
                predicate,
                fixture,
                review_context,
                case_result,
            )
            earned = weight if passed else 0
            category_score += earned
            score += earned
            max_score += weight
            assertion_results.append(
                {
                    "assertion_id": assertion_id,
                    "category": category,
                    "predicate": predicate,
                    "passed": passed,
                    "weight": weight,
                    "earned": earned,
                }
            )

        category_scores[category] = category_score

    if max_score != 100:
        raise ValueError("Benchmark v2 fixture quality weights must total exactly 100")

    return {
        "case_id": fixture["case_id"],
        "score": score,
        "max_score": max_score,
        "category_scores": category_scores,
        "assertions": assertion_results,
    }


def aggregate_candidate_scores(
    fixture_set: dict,
    per_case_scores: list[dict],
) -> dict:
    """Aggregate exactly six canonical Benchmark v2 case scores from 0 to 600."""

    fixtures = fixture_set.get("cases") if isinstance(fixture_set, dict) else None
    if not isinstance(fixtures, list) or len(fixtures) != 6:
        raise ValueError(
            "Benchmark v2 fixture set must declare exactly six canonical qualification cases"
        )

    canonical_case_ids = []
    for fixture in fixtures:
        case_id = fixture.get("case_id") if isinstance(fixture, dict) else None
        if (
            not isinstance(case_id, str)
            or not case_id
            or case_id in canonical_case_ids
        ):
            raise ValueError(
                "Benchmark v2 fixture set must declare unique canonical qualification cases"
            )
        canonical_case_ids.append(case_id)

    if (
        not isinstance(per_case_scores, list)
        or len(per_case_scores) != len(canonical_case_ids)
    ):
        raise ValueError(
            "Benchmark v2 candidate scores must cover canonical qualification cases exactly once"
        )

    scores_by_case = {}
    for case_score in per_case_scores:
        if not isinstance(case_score, dict):
            raise ValueError(
                "Benchmark v2 candidate scores must cover canonical qualification cases exactly once"
            )

        case_id = case_score.get("case_id")
        if case_id not in canonical_case_ids or case_id in scores_by_case:
            raise ValueError(
                "Benchmark v2 candidate scores must cover canonical qualification cases exactly once"
            )

        score = case_score.get("score")
        max_score = case_score.get("max_score")
        if (
            isinstance(score, bool)
            or not isinstance(score, int)
            or score < 0
            or score > 100
            or max_score != 100
        ):
            raise ValueError(
                "Benchmark v2 candidate case score must be an integer from 0 to 100 "
                "with max_score 100"
            )

        scores_by_case[case_id] = case_score

    if set(scores_by_case) != set(canonical_case_ids):
        raise ValueError(
            "Benchmark v2 candidate scores must cover canonical qualification cases exactly once"
        )

    ordered_case_scores = [
        scores_by_case[case_id] for case_id in canonical_case_ids
    ]

    return {
        "score": sum(case_score["score"] for case_score in ordered_case_scores),
        "max_score": 600,
        "case_scores": ordered_case_scores,
    }


def evaluate_candidate_eligibility(
    fixture_set: dict,
    per_case_results: list[dict],
) -> dict:
    """Require hard-gate passes for exactly six canonical qualification cases."""

    fixtures = fixture_set.get("cases") if isinstance(fixture_set, dict) else None
    if not isinstance(fixtures, list) or len(fixtures) != 6:
        raise ValueError(
            "Benchmark v2 fixture set must declare exactly six canonical qualification cases"
        )

    canonical_case_ids = []
    for fixture in fixtures:
        case_id = fixture.get("case_id") if isinstance(fixture, dict) else None
        if (
            not isinstance(case_id, str)
            or not case_id
            or case_id in canonical_case_ids
        ):
            raise ValueError(
                "Benchmark v2 fixture set must declare unique canonical qualification cases"
            )
        canonical_case_ids.append(case_id)

    if (
        not isinstance(per_case_results, list)
        or len(per_case_results) != len(canonical_case_ids)
    ):
        raise ValueError(
            "Benchmark v2 candidate eligibility must cover canonical qualification cases exactly once"
        )

    results_by_case = {}
    for case_result in per_case_results:
        if not isinstance(case_result, dict):
            raise ValueError(
                "Benchmark v2 candidate eligibility must cover canonical qualification cases exactly once"
            )

        case_id = case_result.get("case_id")
        if case_id not in canonical_case_ids or case_id in results_by_case:
            raise ValueError(
                "Benchmark v2 candidate eligibility must cover canonical qualification cases exactly once"
            )

        hard_gate_passed = case_result.get("hard_gate_passed")
        if not isinstance(hard_gate_passed, bool):
            raise ValueError(
                "Benchmark v2 candidate eligibility requires boolean hard_gate_passed values"
            )

        results_by_case[case_id] = case_result

    if set(results_by_case) != set(canonical_case_ids):
        raise ValueError(
            "Benchmark v2 candidate eligibility must cover canonical qualification cases exactly once"
        )

    ordered_case_results = [
        results_by_case[case_id] for case_id in canonical_case_ids
    ]
    passed_case_count = sum(
        case_result["hard_gate_passed"]
        for case_result in ordered_case_results
    )

    return {
        "eligible": passed_case_count == len(canonical_case_ids),
        "passed_case_count": passed_case_count,
        "required_case_count": len(canonical_case_ids),
        "case_results": ordered_case_results,
    }


def rank_candidate_quality(
    *,
    canonical_candidate_ids: list[str],
    candidate_results: list[dict],
) -> dict:
    """Rank candidates by the approved Benchmark v2 quality order."""

    if not isinstance(candidate_results, list):
        raise ValueError(
            "Benchmark v2 quality ranking must cover canonical candidates exactly once"
        )

    results_by_candidate = {}
    for candidate_result in candidate_results:
        if not isinstance(candidate_result, dict):
            raise ValueError(
                "Benchmark v2 quality ranking must cover canonical candidates exactly once"
            )

        candidate_id = candidate_result.get("candidate_id")
        if (
            not isinstance(candidate_id, str)
            or candidate_id not in canonical_candidate_ids
            or candidate_id in results_by_candidate
        ):
            raise ValueError(
                "Benchmark v2 quality ranking must cover canonical candidates exactly once"
            )

        eligibility = candidate_result.get("eligibility")
        if (
            not isinstance(eligibility, dict)
            or not isinstance(eligibility.get("eligible"), bool)
        ):
            raise ValueError(
                "Benchmark v2 qualification selection requires valid eligibility results"
            )

        results_by_candidate[candidate_id] = candidate_result

    if set(results_by_candidate) != set(canonical_candidate_ids):
        raise ValueError(
            "Benchmark v2 quality ranking must cover canonical candidates exactly once"
        )

    canonical_rows = []
    for candidate_id in canonical_candidate_ids:
        candidate_result = results_by_candidate[candidate_id]
        eligibility = candidate_result["eligibility"]
        aggregate_score = candidate_result.get("aggregate_score")
        if not isinstance(aggregate_score, dict):
            raise ValueError(
                "Benchmark v2 qualification selection requires valid six-case aggregate scores"
            )

        case_scores = aggregate_score.get("case_scores")
        if not isinstance(case_scores, list) or len(case_scores) != 6:
            raise ValueError(
                "Benchmark v2 qualification selection requires valid six-case aggregate scores"
            )

        fixture_scores = []
        case_ids = []
        case_ids_present = False
        for case_score in case_scores:
            if not isinstance(case_score, dict):
                raise ValueError(
                    "Benchmark v2 qualification selection requires valid six-case aggregate scores"
                )

            score = case_score.get("score")
            if (
                isinstance(score, bool)
                or not isinstance(score, int)
                or score < 0
                or score > 100
            ):
                raise ValueError(
                    "Benchmark v2 qualification selection requires valid six-case aggregate scores"
                )
            fixture_scores.append(score)

            if "case_id" in case_score:
                case_ids_present = True
                case_id = case_score.get("case_id")
                if not isinstance(case_id, str) or not case_id:
                    raise ValueError(
                        "Benchmark v2 qualification selection requires valid six-case aggregate scores"
                    )
                case_ids.append(case_id)

        if case_ids_present and (
            len(case_ids) != 6 or len(set(case_ids)) != 6
        ):
            raise ValueError(
                "Benchmark v2 qualification selection requires valid six-case aggregate scores"
            )

        eligibility_case_results = eligibility.get("case_results")
        if case_ids_present and isinstance(eligibility_case_results, list):
            eligibility_case_ids = [
                case_result.get("case_id")
                if isinstance(case_result, dict)
                else None
                for case_result in eligibility_case_results
            ]
            if (
                len(eligibility_case_ids) != 6
                or any(
                    not isinstance(case_id, str) or not case_id
                    for case_id in eligibility_case_ids
                )
                or len(set(eligibility_case_ids)) != 6
                or case_ids != eligibility_case_ids
            ):
                raise ValueError(
                    "Benchmark v2 qualification aggregate cases must match eligibility cases exactly"
                )

        aggregate_total = aggregate_score.get("score")
        if (
            isinstance(aggregate_total, bool)
            or not isinstance(aggregate_total, int)
            or aggregate_score.get("max_score") != 600
            or aggregate_total != sum(fixture_scores)
        ):
            raise ValueError(
                "Benchmark v2 qualification selection requires valid six-case aggregate scores"
            )
        lower_tail_profile = sorted(fixture_scores)
        canonical_rows.append(
            {
                "candidate_id": candidate_id,
                "eligible": candidate_result["eligibility"]["eligible"],
                "score": aggregate_score["score"],
                "max_score": aggregate_score["max_score"],
                "worst_fixture_score": lower_tail_profile[0],
                "lower_tail_profile": lower_tail_profile,
            }
        )

    eligible_rows = [
        row for row in canonical_rows if row["eligible"]
    ]
    eligible_rows.sort(
        key=lambda row: (
            row["score"],
            row["worst_fixture_score"],
            tuple(row["lower_tail_profile"]),
        ),
        reverse=True,
    )

    previous_quality_key = None
    current_rank = None
    for position, row in enumerate(eligible_rows, start=1):
        quality_key = (
            row["score"],
            row["worst_fixture_score"],
            tuple(row["lower_tail_profile"]),
        )
        if quality_key != previous_quality_key:
            current_rank = position
        row["quality_rank"] = current_rank
        previous_quality_key = quality_key

    ineligible_rows = [
        row for row in canonical_rows if not row["eligible"]
    ]
    for row in ineligible_rows:
        row["quality_rank"] = None

    return {
        "ranking": [
            *eligible_rows,
            *ineligible_rows,
        ],
    }


def _load_canonical_qualification_fixture_set() -> dict:
    fixture_path = (
        REPOSITORY_ROOT / "config" / "summary-review-benchmark-v2-fixtures.json"
    )
    try:
        fixture_set = json.loads(fixture_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 canonical qualification fixtures are unavailable"
        ) from error

    fixtures = (
        fixture_set.get("cases")
        if isinstance(fixture_set, dict)
        else None
    )
    if not isinstance(fixtures, list) or len(fixtures) != 6:
        raise ValueError(
            "Benchmark v2 canonical qualification fixtures must contain exactly six cases"
        )

    case_ids = []
    for fixture in fixtures:
        case_id = fixture.get("case_id") if isinstance(fixture, dict) else None
        if (
            not isinstance(case_id, str)
            or not case_id
            or case_id in case_ids
        ):
            raise ValueError(
                "Benchmark v2 canonical qualification case IDs must be unique non-empty strings"
            )
        case_ids.append(case_id)

    return fixture_set


def _qualification_provider_lock_from_bytes(
    *,
    provider_lock_bytes: bytes,
    canonical_candidate_ids: tuple[str, ...],
) -> dict:
    if not isinstance(provider_lock_bytes, bytes):
        raise ValueError(
            "Benchmark v2 qualification provider-lock evidence must be exact bytes"
        )
    try:
        provider_lock = json.loads(provider_lock_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 qualification provider-lock evidence is invalid JSON"
        ) from error

    locked_models = (
        provider_lock.get("models")
        if isinstance(provider_lock, dict)
        else None
    )
    if (
        not isinstance(locked_models, dict)
        or set(locked_models) != set(canonical_candidate_ids)
    ):
        raise ValueError(
            "Benchmark v2 qualification provider lock must cover canonical candidates exactly"
        )

    for candidate_id in canonical_candidate_ids:
        provider_entry = locked_models.get(candidate_id)
        routing_provider_slug = (
            provider_entry.get("routing_provider_slug")
            if isinstance(provider_entry, dict)
            else None
        )
        compatible_served_providers = (
            provider_entry.get("compatible_served_providers")
            if isinstance(provider_entry, dict)
            else None
        )
        if (
            not isinstance(routing_provider_slug, str)
            or not routing_provider_slug
            or not isinstance(compatible_served_providers, list)
            or not compatible_served_providers
            or any(
                not isinstance(provider, str) or not provider
                for provider in compatible_served_providers
            )
            or len(set(compatible_served_providers))
            != len(compatible_served_providers)
        ):
            raise ValueError(
                "Benchmark v2 qualification provider-lock candidate entry is invalid"
            )

    return provider_lock


def build_canonical_candidate_results(
    *,
    fixture_set: dict,
    canonical_candidate_ids: tuple[str, ...],
    raw_case_records: list[dict],
    provider_lock_bytes: bytes,
) -> tuple[list[dict], list[dict]]:
    """Recompute Task-6 truth from raw Reviewer-v2 qualification evidence."""

    candidate_ids = require_canonical_candidate_ids(canonical_candidate_ids)
    fixtures = (
        fixture_set.get("cases")
        if isinstance(fixture_set, dict)
        else None
    )
    if not isinstance(fixtures, list) or len(fixtures) != 6:
        raise ValueError(
            "Benchmark v2 qualification recompute requires six canonical fixtures"
        )

    fixtures_by_id = {}
    canonical_case_ids = []
    for fixture in fixtures:
        case_id = fixture.get("case_id") if isinstance(fixture, dict) else None
        transcript = fixture.get("transcript") if isinstance(fixture, dict) else None
        draft = fixture.get("draft") if isinstance(fixture, dict) else None
        if (
            not isinstance(case_id, str)
            or not case_id
            or case_id in fixtures_by_id
            or not isinstance(transcript, str)
            or not isinstance(draft, str)
        ):
            raise ValueError(
                "Benchmark v2 qualification recompute fixture is invalid"
            )
        fixtures_by_id[case_id] = fixture
        canonical_case_ids.append(case_id)

    provider_lock = _qualification_provider_lock_from_bytes(
        provider_lock_bytes=provider_lock_bytes,
        canonical_candidate_ids=candidate_ids,
    )
    expected_pairs = {
        (candidate_id, case_id)
        for candidate_id in candidate_ids
        for case_id in canonical_case_ids
    }
    if (
        not isinstance(raw_case_records, list)
        or len(raw_case_records) != len(expected_pairs)
    ):
        raise ValueError(
            "Benchmark v2 raw qualification evidence must cover every candidate case exactly once"
        )

    required_fields = {
        "candidate_id",
        "case_id",
        "case_result",
        "routing_provider_slug",
        "served_provider",
        "repair_turns",
        "cost_usd",
        "latency_ms",
    }
    raw_by_pair = {}
    recomputed_by_pair = {}
    served_provider_by_candidate = {}

    for record in raw_case_records:
        if not isinstance(record, dict) or set(record) != required_fields:
            raise ValueError(
                "Benchmark v2 raw qualification case record is malformed"
            )

        candidate_id = record["candidate_id"]
        case_id = record["case_id"]
        pair = (candidate_id, case_id)
        if pair not in expected_pairs or pair in raw_by_pair:
            raise ValueError(
                "Benchmark v2 raw qualification evidence has duplicate or unknown candidate case"
            )

        routing_provider_slug = record["routing_provider_slug"]
        served_provider = record["served_provider"]
        provider_entry = provider_lock["models"][candidate_id]
        if (
            not isinstance(routing_provider_slug, str)
            or not routing_provider_slug
            or routing_provider_slug
            != provider_entry["routing_provider_slug"]
        ):
            raise ValueError(
                "Benchmark v2 raw qualification routing provider does not match provider lock"
            )

        expected_served_provider = served_provider_by_candidate.get(candidate_id)
        served_provider = validate_served_provider(
            provider_lock,
            candidate_id,
            served_provider,
            expected_served_provider=expected_served_provider,
        )
        served_provider_by_candidate[candidate_id] = served_provider

        repair_turns = record["repair_turns"]
        latency_ms = record["latency_ms"]
        cost_usd = record["cost_usd"]
        if (
            isinstance(repair_turns, bool)
            or not isinstance(repair_turns, int)
            or repair_turns < 0
            or repair_turns > 1
            or isinstance(latency_ms, bool)
            or not isinstance(latency_ms, int)
            or latency_ms < 0
            or not isinstance(cost_usd, str)
            or not cost_usd
        ):
            raise ValueError(
                "Benchmark v2 raw qualification operational metrics are invalid"
            )
        try:
            parsed_cost_usd = Decimal(cost_usd)
        except InvalidOperation as error:
            raise ValueError(
                "Benchmark v2 raw qualification cost must be a decimal string"
            ) from error
        if not parsed_cost_usd.is_finite() or parsed_cost_usd < 0:
            raise ValueError(
                "Benchmark v2 raw qualification cost must be finite and non-negative"
            )

        raw_case_result = record["case_result"]
        if not isinstance(raw_case_result, dict):
            raise ValueError(
                "Benchmark v2 raw Reviewer-v2 case result must be an object"
            )

        fixture = fixtures_by_id[case_id]
        transcript = fixture["transcript"]
        draft = fixture["draft"]
        review_context = build_review_context(transcript, draft)

        expected_case_key = f"{candidate_id}::{case_id}"
        if raw_case_result.get("outcome") == "model_failed":
            try:
                validated_failure = _validate_failed_case(
                    raw_case_result,
                    [expected_case_key],
                )
            except ValueError as error:
                raise ValueError(
                    "Benchmark v2 raw qualification terminal model_failed evidence is invalid"
                ) from error
            if validated_failure["case_key"] != expected_case_key:
                raise ValueError(
                    "Benchmark v2 raw qualification terminal failure identity conflicts"
                )
            quality_assertions = fixture.get("quality_assertions")
            if not isinstance(quality_assertions, dict) or not quality_assertions:
                raise ValueError(
                    "Benchmark v2 quality assertions must be a non-empty object"
                )
            zero_category_scores: dict[str, int] = {}
            zero_assertions = []
            zero_max_score = 0
            for category, assertions in quality_assertions.items():
                zero_category_scores[category] = 0
                for assertion in assertions:
                    weight = assertion["weight"]
                    zero_max_score += weight
                    zero_assertions.append(
                        {
                            "assertion_id": assertion["assertion_id"],
                            "category": category,
                            "predicate": assertion["predicate"],
                            "passed": False,
                            "weight": weight,
                            "earned": 0,
                        }
                    )
            if zero_max_score != 100:
                raise ValueError(
                    "Benchmark v2 fixture quality weights must total exactly 100"
                )
            canonical_case_result = {"case_failure": validated_failure}
            evaluation = {
                "case_id": case_id,
                "hard_gate_passed": False,
                "failures": [
                    f"model_failed:{validated_failure['failure_code']}"
                ],
            }
            quality_score = {
                "case_id": case_id,
                "score": 0,
                "max_score": zero_max_score,
                "category_scores": zero_category_scores,
                "assertions": zero_assertions,
            }
        else:
            raw_audit = raw_case_result.get("audit_result")
            if not isinstance(raw_audit, dict):
                raise ValueError(
                    "Benchmark v2 raw Reviewer-v2 case result requires audit_result "
                    "or a terminal model failure"
                )
            validated_audit = validate_audit_result(
                raw_audit,
                transcript,
                review_context,
            )

            raw_edit = raw_case_result.get("edit_result")
            if validated_audit["status"] == "fail":
                if raw_edit is not None:
                    raise ValueError(
                        "Benchmark v2 failed raw Reviewer-v2 case must not contain an edit"
                    )
                validated_edit = None
            else:
                if not isinstance(raw_edit, dict):
                    raise ValueError(
                        "Benchmark v2 accepted raw Reviewer-v2 case requires edit_result"
                    )
                validated_edit = validate_edit_result(
                    raw_edit,
                    validated_audit,
                    draft,
                    transcript,
                    review_context,
                )

            final_markdown = accepted_final_markdown(
                validated_audit,
                validated_edit,
                draft,
            )
            if (
                "accepted_final_markdown" in raw_case_result
                and raw_case_result["accepted_final_markdown"] != final_markdown
            ):
                raise ValueError(
                    "Benchmark v2 raw Reviewer-v2 accepted final markdown disagrees with recomputation"
                )
            if (
                "served_provider" in raw_case_result
                and raw_case_result["served_provider"] != served_provider
            ):
                raise ValueError(
                    "Benchmark v2 raw Reviewer-v2 served provider disagrees with qualification evidence"
                )

            canonical_case_result = {
                "audit_result": validated_audit,
                "edit_result": validated_edit,
                "accepted_final_markdown": final_markdown,
            }
            evaluation = evaluate_qualification_case(
                fixture,
                review_context,
                canonical_case_result,
            )
            quality_score = score_qualification_case(
                fixture,
                review_context,
                canonical_case_result,
            )

        raw_by_pair[pair] = record
        recomputed_by_pair[pair] = {
            "candidate_id": candidate_id,
            "case_id": case_id,
            "result": {
                "candidate_id": candidate_id,
                "case_id": case_id,
                "served_provider": served_provider,
                "hard_gate_passed": evaluation["hard_gate_passed"],
                "score": quality_score["score"],
                "max_score": quality_score["max_score"],
                "evaluation": evaluation,
                "quality_score": quality_score,
                "case_result": canonical_case_result,
            },
        }

    if set(raw_by_pair) != expected_pairs:
        raise ValueError(
            "Benchmark v2 raw qualification evidence must cover every candidate case exactly once"
        )

    candidate_results = []
    recomputed_case_records = []
    for candidate_id in candidate_ids:
        candidate_raw_records = [
            raw_by_pair[(candidate_id, case_id)]
            for case_id in canonical_case_ids
        ]
        candidate_recomputed_records = [
            recomputed_by_pair[(candidate_id, case_id)]
            for case_id in canonical_case_ids
        ]
        per_case_eligibility = [
            record["result"]["evaluation"]
            for record in candidate_recomputed_records
        ]
        per_case_scores = [
            record["result"]["quality_score"]
            for record in candidate_recomputed_records
        ]

        candidate_results.append(
            {
                "candidate_id": candidate_id,
                "model_id": candidate_id,
                "routing_provider_slug": candidate_raw_records[0][
                    "routing_provider_slug"
                ],
                "observed_served_provider_identity": candidate_raw_records[0][
                    "served_provider"
                ],
                "eligibility": evaluate_candidate_eligibility(
                    fixture_set,
                    per_case_eligibility,
                ),
                "aggregate_score": aggregate_candidate_scores(
                    fixture_set,
                    per_case_scores,
                ),
                "repair_turns": sum(
                    record["repair_turns"]
                    for record in candidate_raw_records
                ),
                "total_cost_usd": format(
                    sum(
                        (
                            Decimal(record["cost_usd"])
                            for record in candidate_raw_records
                        ),
                        Decimal("0"),
                    ),
                    "f",
                ),
                "total_latency_ms": sum(
                    record["latency_ms"]
                    for record in candidate_raw_records
                ),
            }
        )
        recomputed_case_records.extend(candidate_recomputed_records)

    _validate_qualification_candidate_results(
        canonical_candidate_ids=list(candidate_ids),
        candidate_results=candidate_results,
    )
    return candidate_results, recomputed_case_records


def _validate_qualification_candidate_results(
    *,
    canonical_candidate_ids: list[str],
    candidate_results: list[dict],
) -> None:
    """Fail closed on malformed Task-6 qualification result envelopes."""

    if not isinstance(candidate_results, list):
        raise ValueError(
            "Benchmark v2 qualification selection requires canonical candidate results"
        )

    fixture_path = (
        REPOSITORY_ROOT / "config" / "summary-review-benchmark-v2-fixtures.json"
    )
    try:
        fixture_payload = json.loads(fixture_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 canonical qualification fixtures are unavailable"
        ) from error

    fixtures = (
        fixture_payload.get("cases")
        if isinstance(fixture_payload, dict)
        else None
    )
    if not isinstance(fixtures, list) or len(fixtures) != 6:
        raise ValueError(
            "Benchmark v2 canonical qualification fixtures must contain exactly six cases"
        )

    canonical_case_ids = []
    for fixture in fixtures:
        case_id = fixture.get("case_id") if isinstance(fixture, dict) else None
        if (
            not isinstance(case_id, str)
            or not case_id
            or case_id in canonical_case_ids
        ):
            raise ValueError(
                "Benchmark v2 canonical qualification case IDs must be unique non-empty strings"
            )
        canonical_case_ids.append(case_id)

    seen_candidate_ids = set()
    for candidate_result in candidate_results:
        if not isinstance(candidate_result, dict):
            raise ValueError(
                "Benchmark v2 qualification selection requires canonical candidate results"
            )

        candidate_id = candidate_result.get("candidate_id")
        if (
            not isinstance(candidate_id, str)
            or candidate_id not in canonical_candidate_ids
            or candidate_id in seen_candidate_ids
            or candidate_result.get("model_id") != candidate_id
        ):
            raise ValueError(
                "Benchmark v2 qualification selection requires exact canonical candidate identity"
            )
        seen_candidate_ids.add(candidate_id)

        eligibility = candidate_result.get("eligibility")
        if not isinstance(eligibility, dict):
            raise ValueError(
                "Benchmark v2 qualification selection requires valid eligibility results"
            )

        eligible = eligibility.get("eligible")
        passed_case_count = eligibility.get("passed_case_count")
        required_case_count = eligibility.get("required_case_count")
        case_results = eligibility.get("case_results")
        if (
            not isinstance(eligible, bool)
            or isinstance(passed_case_count, bool)
            or not isinstance(passed_case_count, int)
            or passed_case_count < 0
            or required_case_count != 6
            or not isinstance(case_results, list)
            or len(case_results) != 6
        ):
            raise ValueError(
                "Benchmark v2 qualification selection requires valid six-case eligibility results"
            )

        eligibility_case_ids = []
        computed_passed_case_count = 0
        for case_result in case_results:
            if not isinstance(case_result, dict):
                raise ValueError(
                    "Benchmark v2 qualification selection requires valid six-case eligibility results"
                )
            case_id = case_result.get("case_id")
            hard_gate_passed = case_result.get("hard_gate_passed")
            if (
                not isinstance(case_id, str)
                or not case_id
                or case_id in eligibility_case_ids
                or not isinstance(hard_gate_passed, bool)
            ):
                raise ValueError(
                    "Benchmark v2 qualification selection requires valid six-case eligibility results"
                )
            eligibility_case_ids.append(case_id)
            computed_passed_case_count += int(hard_gate_passed)

        if eligibility_case_ids != canonical_case_ids:
            raise ValueError(
                "Benchmark v2 qualification cases must match the exact canonical fixture case IDs"
            )

        if (
            passed_case_count != computed_passed_case_count
            or eligible != (computed_passed_case_count == required_case_count)
        ):
            raise ValueError(
                "Benchmark v2 qualification eligibility summary must match case results"
            )

        aggregate_score = candidate_result.get("aggregate_score")
        if not isinstance(aggregate_score, dict):
            raise ValueError(
                "Benchmark v2 qualification selection requires valid six-case aggregate scores"
            )
        case_scores = aggregate_score.get("case_scores")
        if not isinstance(case_scores, list) or len(case_scores) != 6:
            raise ValueError(
                "Benchmark v2 qualification selection requires valid six-case aggregate scores"
            )

        aggregate_case_ids = []
        computed_score = 0
        for case_score in case_scores:
            if not isinstance(case_score, dict):
                raise ValueError(
                    "Benchmark v2 qualification selection requires valid six-case aggregate scores"
                )
            case_id = case_score.get("case_id")
            score = case_score.get("score")
            if (
                not isinstance(case_id, str)
                or not case_id
                or case_id in aggregate_case_ids
                or isinstance(score, bool)
                or not isinstance(score, int)
                or score < 0
                or score > 100
                or case_score.get("max_score") != 100
            ):
                raise ValueError(
                    "Benchmark v2 qualification selection requires valid six-case aggregate scores"
                )
            aggregate_case_ids.append(case_id)
            computed_score += score

        aggregate_total = aggregate_score.get("score")
        if (
            aggregate_case_ids != eligibility_case_ids
            or isinstance(aggregate_total, bool)
            or not isinstance(aggregate_total, int)
            or aggregate_total != computed_score
            or aggregate_score.get("max_score") != 600
        ):
            raise ValueError(
                "Benchmark v2 qualification aggregate must match eligibility cases exactly"
            )

        repair_turns = candidate_result.get("repair_turns")
        if (
            isinstance(repair_turns, bool)
            or not isinstance(repair_turns, int)
            or repair_turns < 0
            or repair_turns > 6
        ):
            raise ValueError(
                "Benchmark v2 qualification repair_turns must be an integer from 0 to 6"
            )

        total_cost_usd = candidate_result.get("total_cost_usd")
        if not isinstance(total_cost_usd, str) or not total_cost_usd:
            raise ValueError(
                "Benchmark v2 qualification total_cost_usd must be a finite non-negative decimal string"
            )
        try:
            parsed_total_cost_usd = Decimal(total_cost_usd)
        except InvalidOperation as error:
            raise ValueError(
                "Benchmark v2 qualification total_cost_usd must be a finite non-negative decimal string"
            ) from error
        if not parsed_total_cost_usd.is_finite() or parsed_total_cost_usd < 0:
            raise ValueError(
                "Benchmark v2 qualification total_cost_usd must be a finite non-negative decimal string"
            )

        total_latency_ms = candidate_result.get("total_latency_ms")
        if (
            isinstance(total_latency_ms, bool)
            or not isinstance(total_latency_ms, int)
            or total_latency_ms < 0
        ):
            raise ValueError(
                "Benchmark v2 qualification total_latency_ms must be a non-negative integer"
            )

    if seen_candidate_ids != set(canonical_candidate_ids):
        raise ValueError(
            "Benchmark v2 qualification selection requires each canonical candidate exactly once"
        )


def select_qualification_winner(
    *,
    canonical_candidate_ids: list[str],
    candidate_results: list[dict],
) -> dict | None:
    """Select zero or one qualification advancer before Geoffrey execution."""

    _validate_qualification_candidate_results(
        canonical_candidate_ids=canonical_candidate_ids,
        candidate_results=candidate_results,
    )
    quality_ranking = rank_candidate_quality(
        canonical_candidate_ids=canonical_candidate_ids,
        candidate_results=candidate_results,
    )
    eligible_rows = [
        row for row in quality_ranking["ranking"] if row["eligible"]
    ]
    if not eligible_rows:
        return None

    top_quality_rows = [
        row for row in eligible_rows if row["quality_rank"] == 1
    ]
    if len(top_quality_rows) == 1:
        selected_candidate_id = top_quality_rows[0]["candidate_id"]
        return next(
            candidate_result
            for candidate_result in candidate_results
            if candidate_result["candidate_id"] == selected_candidate_id
        )

    top_quality_candidate_ids = {
        row["candidate_id"] for row in top_quality_rows
    }
    top_quality_results = [
        candidate_result
        for candidate_result in candidate_results
        if candidate_result["candidate_id"] in top_quality_candidate_ids
    ]
    fewest_repair_turns = min(
        candidate_result["repair_turns"]
        for candidate_result in top_quality_results
    )
    repair_tied_results = [
        candidate_result
        for candidate_result in top_quality_results
        if candidate_result["repair_turns"] == fewest_repair_turns
    ]
    if len(repair_tied_results) == 1:
        return repair_tied_results[0]

    lowest_total_cost = min(
        Decimal(candidate_result["total_cost_usd"])
        for candidate_result in repair_tied_results
    )
    cost_tied_results = [
        candidate_result
        for candidate_result in repair_tied_results
        if Decimal(candidate_result["total_cost_usd"]) == lowest_total_cost
    ]
    if len(cost_tied_results) == 1:
        return cost_tied_results[0]

    lowest_total_latency_ms = min(
        candidate_result["total_latency_ms"]
        for candidate_result in cost_tied_results
    )
    latency_tied_results = [
        candidate_result
        for candidate_result in cost_tied_results
        if candidate_result["total_latency_ms"] == lowest_total_latency_ms
    ]
    if len(latency_tied_results) == 1:
        return latency_tied_results[0]

    return min(
        latency_tied_results,
        key=lambda candidate_result: candidate_result["model_id"],
    )


def evaluate_qualification_case(
    fixture: dict,
    review_context: dict,
    case_result: dict,
) -> dict:
    """Evaluate one deterministic Benchmark v2 qualification hard gate."""

    case_id = fixture["case_id"]
    hard_gate = fixture["hard_gate"]
    audit_result = case_result["audit_result"]
    edit_result = case_result["edit_result"]
    final_markdown = case_result["accepted_final_markdown"]
    failures = _audit_hard_gate_failures(fixture, audit_result)

    edit_mode = hard_gate["required_edit_mode"]
    if edit_mode == "byte_preserving_noop":
        if (
            edit_result is None
            or edit_result["resolved_issue_ids"] != []
            or edit_result["final_markdown"] != fixture["draft"]
            or final_markdown != fixture["draft"]
        ):
            failures.append("edit_mode")
    elif edit_mode == "changed":
        if (
            edit_result is None
            or edit_result["final_markdown"] == fixture["draft"]
            or final_markdown == fixture["draft"]
        ):
            failures.append("edit_mode")

    if final_markdown is None:
        # A legitimate terminal ``fail`` audit (Reviewer-v2 contract) never
        # produces an edit or an accepted final Markdown. The hard gate has
        # already recorded the relevant failure (at minimum a
        # ``required_status`` mismatch, since every canonical qualification
        # fixture requires ``pass`` or ``revised``); there is no final text
        # left to evaluate against the remaining Python-owned substring/
        # occurrence predicates, so they are skipped rather than raised on.
        failures.append("no_accepted_final_markdown")
    else:
        for substring in hard_gate.get("forbidden_final_substrings", []):
            if substring in final_markdown:
                failures.append(f"forbidden_final_substring:{substring}")

        required_any = hard_gate.get("required_final_any_substrings", [])
        if required_any and not any(
            substring in final_markdown for substring in required_any
        ):
            failures.append("required_final_any_substring")

        for text, maximum in hard_gate.get("max_final_occurrences", {}).items():
            if final_markdown.count(text) > maximum:
                failures.append(f"max_final_occurrences:{text}")

    return {
        "case_id": case_id,
        "hard_gate_passed": not failures,
        "failures": failures,
    }


class ModelContractExhausted(ValueError):
    """One model response contract remained invalid after bounded repair."""

    def __init__(self, *, stage: str, cause: Exception):
        if stage not in {"audit", "edit"} or not isinstance(cause, Exception):
            raise ValueError(
                "Benchmark v2 model contract exhaustion inputs are invalid"
            )
        self.stage = stage
        self.failure_code = f"{stage}_contract_exhausted"
        self.last_error_class = (
            f"{type(cause).__module__}.{type(cause).__name__}"
        )[:256]
        self.last_error_message = str(cause)[:2048]
        super().__init__(
            f"Benchmark v2 {stage} contract exhausted its repair budget"
        )

    def failure_record(self, *, case_key: str, attempt_count: int) -> dict:
        return {
            "case_key": case_key,
            "outcome": "model_failed",
            "stage": self.stage,
            "failure_code": self.failure_code,
            "attempt_count": attempt_count,
            "last_error_class": self.last_error_class,
            "last_error_message": self.last_error_message,
        }


def _validate_repaired_audit_contract(
    content: str,
    transcript: str,
    review_context: dict,
) -> dict:
    try:
        audit_result = parse_review_content(content)
        return validate_audit_result(
            audit_result,
            transcript,
            review_context,
        )
    except (TypeError, ValueError) as error:
        raise ModelContractExhausted(stage="audit", cause=error) from error


def _validate_repaired_edit_contract(
    content: str,
    audit_result: dict,
    draft: str,
    transcript: str,
    review_context: dict,
) -> dict:
    try:
        edit_result = parse_review_content(content)
        return validate_edit_result(
            edit_result,
            audit_result,
            draft,
            transcript,
            review_context,
        )
    except (TypeError, ValueError) as error:
        raise ModelContractExhausted(stage="edit", cause=error) from error


def execute_case(
    *,
    model_id: str,
    system_prompt: str,
    episode: dict,
    transcript: str,
    draft: str,
    review_context: dict,
    config: dict,
    provider_lock: dict,
    persisted_state: dict,
    ordered_case_keys: list[str],
    case_key: str,
    call_reservation_usd: Decimal,
    transport,
    journal_path: Path | None = None,
    benchmark_binding: dict | None = None,
) -> dict:
    state = resume_execution_state(persisted_state, ordered_case_keys)
    if case_key not in ordered_case_keys:
        raise ValueError("Benchmark case key is not canonical")
    if case_key in state["completed_case_keys"]:
        raise ValueError("Benchmark case is already completed")
    if case_key in state["failed_case_keys"]:
        raise ValueError("Benchmark case is already resolved as failed")

    if (journal_path is None) != (benchmark_binding is None):
        raise ValueError(
            "Benchmark v2 durable execution requires journal path and benchmark binding together"
        )
    journal_state = None
    if journal_path is not None:
        journal_state = load_or_initialize_execution_journal(
            Path(journal_path),
            benchmark_binding=benchmark_binding,
            ordered_case_keys=ordered_case_keys,
        )
        if case_key in journal_state["completed_case_keys"]:
            raise ValueError("Benchmark case is already completed")
        if case_key in journal_state["failed_case_keys"]:
            raise ValueError("Benchmark case is already resolved as failed")

    try:
        budget_usd = Decimal(config["budget_usd"])
    except (KeyError, InvalidOperation, TypeError) as error:
        raise ValueError("Benchmark budget_usd is invalid") from error

    max_completion_tokens = _require_max_completion_tokens(config)
    temperature = _temperature_for_model(config, model_id)
    max_calls_per_case = config["max_calls_per_case"]
    provider_policy = provider_policy_for_model(config, provider_lock, model_id)
    spent_usd = state["spent_usd"]
    if journal_state is not None:
        spent_usd = Decimal(journal_state["spent_usd"])
    call_count = 0
    repair_count = 0
    served_provider = None

    def benchmark_payload(payload: dict) -> dict:
        existing_max_tokens = payload.get("max_tokens")
        if "max_tokens" in payload and (
            type(existing_max_tokens) is not int
            or existing_max_tokens != max_completion_tokens
        ):
            raise ValueError(
                "Benchmark v2 request max_tokens conflicts with configured "
                "completion token ceiling"
            )

        existing_temperature = payload.get("temperature")
        if "temperature" in payload and (
            temperature is None or existing_temperature != temperature
        ):
            raise ValueError(
                "Benchmark v2 request temperature conflicts with configured "
                "sampling temperature"
            )

        bounded = dict(payload)
        bounded["model"] = model_id
        bounded["provider"] = dict(provider_policy)
        bounded["max_tokens"] = max_completion_tokens
        if temperature is not None:
            bounded["temperature"] = temperature
        bounded["messages"] = [
            {"role": "system", "content": system_prompt},
            *payload["messages"],
        ]
        return bounded

    def request_phase(payload: dict, *, phase: str):
        nonlocal call_count, served_provider, spent_usd

        if (
            type(payload.get("max_tokens")) is not int
            or payload["max_tokens"] != max_completion_tokens
        ):
            raise ValueError(
                "Benchmark v2 request max_tokens must match configured "
                "completion token ceiling"
            )
        if (
            (temperature is None and "temperature" in payload)
            or (
                temperature is not None
                and payload.get("temperature") != temperature
            )
        ):
            raise ValueError(
                "Benchmark v2 request temperature must match configured "
                "sampling temperature"
            )
        if phase not in {"audit", "edit"}:
            raise ValueError("Benchmark v2 request phase is invalid")

        try:
            request_bytes = (
                json.dumps(
                    payload,
                    ensure_ascii=False,
                    sort_keys=True,
                    separators=(",", ":"),
                )
                + "\n"
            ).encode("utf-8")
        except (TypeError, ValueError) as error:
            raise ValueError(
                "Benchmark v2 request payload must be canonical JSON"
            ) from error

        attempt_number = call_count + 1
        response_payload = None
        if journal_state is not None:
            response_payload = replay_completed_attempt(
                Path(journal_path),
                case_key=case_key,
                phase=phase,
                attempt_number=attempt_number,
                request_bytes=request_bytes,
            )
            if response_payload is None:
                reserve_attempt_if_within_budget(
                    Path(journal_path),
                    case_key=case_key,
                    phase=phase,
                    attempt_number=attempt_number,
                    request_bytes=request_bytes,
                    reservation_usd=call_reservation_usd,
                    budget_usd=budget_usd,
                )
                call_count = attempt_number
                started_ns = time.monotonic_ns()
                try:
                    response_payload = perform_transport_attempt(
                        lambda: transport(payload),
                        attempt_number=call_count,
                        max_calls_per_case=max_calls_per_case,
                    )
                except Exception as error:
                    latency_ms = max(
                        0,
                        (time.monotonic_ns() - started_ns) // 1_000_000,
                    )
                    record_attempt_transport_failure(
                        Path(journal_path),
                        case_key=case_key,
                        phase=phase,
                        attempt_number=call_count,
                        error_class=(
                            f"{type(error).__module__}."
                            f"{type(error).__name__}"
                        ),
                        error_message=str(error)[:2048],
                        latency_ms=latency_ms,
                    )
                    raise
                latency_ms = max(
                    0,
                    (time.monotonic_ns() - started_ns) // 1_000_000,
                )
                if not isinstance(response_payload, dict):
                    raise ValueError(
                        "Benchmark transport response must be an object"
                    )
                try:
                    response_bytes = (
                        json.dumps(
                            response_payload,
                            ensure_ascii=False,
                            sort_keys=True,
                            separators=(",", ":"),
                        )
                        + "\n"
                    ).encode("utf-8")
                except (TypeError, ValueError) as error:
                    raise ValueError(
                        "Benchmark transport response must be canonical JSON"
                    ) from error
                checkpointed = record_attempt_response(
                    Path(journal_path),
                    case_key=case_key,
                    attempt_number=call_count,
                    response_bytes=response_bytes,
                    response_payload=response_payload,
                    latency_ms=latency_ms,
                )
                spent_usd = Decimal(checkpointed["spent_usd"])
            else:
                call_count = attempt_number
        else:
            admit_paid_call(budget_usd, spent_usd, call_reservation_usd)
            call_count = attempt_number
            response_payload = perform_transport_attempt(
                lambda: transport(payload),
                attempt_number=call_count,
                max_calls_per_case=max_calls_per_case,
            )

        if not isinstance(response_payload, dict):
            raise ValueError("Benchmark transport response must be an object")

        served_model = response_payload.get("model")
        if served_model != model_id:
            raise ValueError("Benchmark served model does not match candidate model")

        metadata = response_payload.get("openrouter_metadata")
        endpoints = (
            metadata.get("endpoints", {}).get("available", [])
            if isinstance(metadata, dict)
            else []
        )
        actual_provider = None
        if isinstance(endpoints, list):
            selected_endpoints = [
                endpoint
                for endpoint in endpoints
                if isinstance(endpoint, dict)
                and endpoint.get("selected") is True
            ]
            if len(selected_endpoints) == 1:
                candidate_provider = selected_endpoints[0].get(
                    "provider"
                )
                if (
                    isinstance(candidate_provider, str)
                    and candidate_provider
                ):
                    actual_provider = candidate_provider

        served_provider = validate_served_provider(
            provider_lock,
            model_id,
            actual_provider,
            expected_served_provider=served_provider,
        )

        if journal_state is None:
            spent_usd += completed_call_cost_usd(response_payload)

        try:
            content = response_payload["choices"][0]["message"]["content"]
        except (KeyError, IndexError, TypeError) as error:
            raise ValueError("Benchmark response content is unavailable") from error
        return content

    def build_durable_execution_evidence(
        current_journal: dict,
        completed_result: dict,
    ) -> dict:
        prefix = f"{model_id}::"
        candidate_case_key = (
            case_key.startswith(prefix) and bool(case_key[len(prefix):])
        )
        geoffrey_case_key = bool(
            re.fullmatch(r"geoffrey::run-[1-3]", case_key)
            or re.fullmatch(r"geoffrey::[a-z0-9][a-z0-9-]*::run-[1-3]", case_key)
        )
        if not candidate_case_key and not geoffrey_case_key:
            raise ValueError(
                "Benchmark v2 journal completion case identity is invalid"
            )

        provider_entry = provider_lock["models"].get(model_id)
        routing_provider_slug = (
            provider_entry.get("routing_provider_slug")
            if isinstance(provider_entry, dict)
            else None
        )
        completed_provider = completed_result.get("served_provider")
        if (
            not isinstance(routing_provider_slug, str)
            or not routing_provider_slug
            or not isinstance(completed_provider, str)
            or not completed_provider
        ):
            raise ValueError(
                "Benchmark v2 journal completion provider identity is invalid"
            )

        raw_attempts = current_journal.get("attempts")
        if not isinstance(raw_attempts, list):
            raise ValueError(
                "Benchmark v2 journal completion attempts are invalid"
            )
        attempts = [
            attempt
            for attempt in raw_attempts
            if isinstance(attempt, dict)
            and attempt.get("case_key") == case_key
        ]
        attempts.sort(key=lambda attempt: attempt.get("attempt_number", -1))
        if (
            not attempts
            or completed_result.get("call_count") != len(attempts)
        ):
            raise ValueError(
                "Benchmark v2 journal completion attempt count is invalid"
            )

        bounded_attempts = []
        total_prompt_tokens = 0
        total_completion_tokens = 0
        total_tokens = 0
        total_cost = Decimal("0")
        total_latency_ms = 0
        seen_edit = False

        for expected_number, attempt in enumerate(attempts, start=1):
            if (
                attempt.get("status") != "completed"
                or attempt.get("attempt_number") != expected_number
            ):
                raise ValueError(
                    "Benchmark v2 journal completion attempt sequence is invalid"
                )

            phase = attempt.get("phase")
            if phase not in {"audit", "edit"}:
                raise ValueError(
                    "Benchmark v2 journal completion phase is invalid"
                )
            if expected_number == 1 and phase != "audit":
                raise ValueError(
                    "Benchmark v2 journal completion phase sequence must begin with audit"
                )
            if phase == "edit":
                seen_edit = True
            elif seen_edit:
                raise ValueError(
                    "Benchmark v2 journal completion phase sequence cannot return to audit"
                )

            if (
                attempt.get("served_model") != model_id
                or attempt.get("served_provider") != completed_provider
            ):
                raise ValueError(
                    "Benchmark v2 journal completion served identity drift is invalid"
                )

            request_sha256 = attempt.get("request_sha256")
            response_sha256 = attempt.get("response_sha256")
            completion_id = attempt.get("completion_id")
            if (
                not isinstance(request_sha256, str)
                or not re.fullmatch(
                    r"sha256:[0-9a-f]{64}",
                    request_sha256,
                )
                or not isinstance(response_sha256, str)
                or not re.fullmatch(
                    r"sha256:[0-9a-f]{64}",
                    response_sha256,
                )
                or not isinstance(completion_id, str)
                or not completion_id
            ):
                raise ValueError(
                    "Benchmark v2 journal completion attempt hashes are invalid"
                )

            usage = attempt.get("usage")
            if not isinstance(usage, dict):
                raise ValueError(
                    "Benchmark v2 journal completion usage is invalid"
                )
            token_values = {}
            for token_field in (
                "prompt_tokens",
                "completion_tokens",
                "total_tokens",
            ):
                token_value = usage.get(token_field)
                if (
                    isinstance(token_value, bool)
                    or not isinstance(token_value, int)
                    or token_value < 0
                ):
                    raise ValueError(
                        f"Benchmark v2 journal completion {token_field} is invalid"
                    )
                token_values[token_field] = token_value
            if (
                token_values["prompt_tokens"]
                + token_values["completion_tokens"]
                != token_values["total_tokens"]
            ):
                raise ValueError(
                    "Benchmark v2 journal completion token totals are inconsistent"
                )

            try:
                attempt_cost = Decimal(attempt.get("cost_usd"))
            except (InvalidOperation, TypeError) as error:
                raise ValueError(
                    "Benchmark v2 journal completion cost is invalid"
                ) from error
            if not attempt_cost.is_finite() or attempt_cost < 0:
                raise ValueError(
                    "Benchmark v2 journal completion cost is invalid"
                )

            latency_ms = attempt.get("latency_ms")
            if (
                isinstance(latency_ms, bool)
                or not isinstance(latency_ms, int)
                or latency_ms < 0
            ):
                raise ValueError(
                    "Benchmark v2 journal completion latency is invalid"
                )

            bounded_attempts.append(
                {
                    "attempt_number": expected_number,
                    "phase": phase,
                    "request_sha256": request_sha256,
                    "response_sha256": response_sha256,
                    "completion_id": completion_id,
                    "served_model_id": model_id,
                    "served_provider": completed_provider,
                    "prompt_tokens": token_values["prompt_tokens"],
                    "completion_tokens": token_values["completion_tokens"],
                    "total_tokens": token_values["total_tokens"],
                    "cost_usd": format(attempt_cost, "f"),
                    "latency_ms": latency_ms,
                }
            )
            total_prompt_tokens += token_values["prompt_tokens"]
            total_completion_tokens += token_values["completion_tokens"]
            total_tokens += token_values["total_tokens"]
            total_cost += attempt_cost
            total_latency_ms += latency_ms

        try:
            spent_after = Decimal(current_journal.get("spent_usd"))
        except (InvalidOperation, TypeError) as error:
            raise ValueError(
                "Benchmark v2 journal completion spent state is invalid"
            ) from error
        spent_before = spent_after - total_cost
        if (
            not spent_after.is_finite()
            or not spent_before.is_finite()
            or spent_before < 0
        ):
            raise ValueError(
                "Benchmark v2 journal completion spent state is invalid"
            )

        completed_state = completed_result.get("execution_state")
        completed_keys = (
            completed_state.get("completed_case_keys")
            if isinstance(completed_state, dict)
            else None
        )
        if (
            not isinstance(completed_state, dict)
            or completed_state.get("spent_usd")
            != format(spent_after, "f")
            or not isinstance(completed_keys, list)
            or case_key not in completed_keys
        ):
            raise ValueError(
                "Benchmark v2 journal completion execution state is invalid"
            )

        try:
            case_result_bytes = (
                json.dumps(
                    completed_result,
                    ensure_ascii=False,
                    indent=2,
                    sort_keys=True,
                )
                + "\n"
            ).encode("utf-8")
        except (TypeError, ValueError) as error:
            raise ValueError(
                "Benchmark v2 journal completion case result is not canonical JSON"
            ) from error

        frozen_evidence = {}
        for binding_field in (
            "config_sha256",
            "provider_lock_sha256",
            "pricing_evidence_sha256",
        ):
            value = (
                benchmark_binding.get(binding_field)
                if isinstance(benchmark_binding, dict)
                else None
            )
            if (
                not isinstance(value, str)
                or not re.fullmatch(
                    r"sha256:[0-9a-f]{64}",
                    value,
                )
            ):
                raise ValueError(
                    "Benchmark v2 journal completion frozen evidence is invalid"
                )
            frozen_evidence[binding_field] = value

        return {
            "case_key": case_key,
            "requested_model_id": model_id,
            "routing_provider_slug": routing_provider_slug,
            "served_provider_identity": completed_provider,
            "attempt_count": len(bounded_attempts),
            "attempts": bounded_attempts,
            "usage": {
                "prompt_tokens": total_prompt_tokens,
                "completion_tokens": total_completion_tokens,
                "total_tokens": total_tokens,
            },
            "cost_usd": format(total_cost, "f"),
            "latency_ms": total_latency_ms,
            "spent_before_usd": format(spent_before, "f"),
            "spent_after_usd": format(spent_after, "f"),
            "case_result_sha256": _sha256_bytes(case_result_bytes),
            "frozen_evidence": frozen_evidence,
        }

    def finish_case_result(case_result: dict) -> dict:
        if journal_state is None:
            return case_result

        current_journal = load_or_initialize_execution_journal(
            Path(journal_path),
            benchmark_binding=benchmark_binding,
            ordered_case_keys=ordered_case_keys,
        )
        if case_key in current_journal["completed_case_keys"]:
            raise ValueError("Benchmark case is already completed")

        completed_result = {
            **case_result,
            "execution_state": {
                "spent_usd": current_journal["spent_usd"],
                "completed_case_keys": [
                    *current_journal["completed_case_keys"],
                    case_key,
                ],
                "failed_case_keys": list(
                    current_journal["failed_case_keys"]
                ),
            },
        }
        execution_evidence = build_durable_execution_evidence(
            current_journal,
            completed_result,
        )
        record_case_completion(
            Path(journal_path),
            case_key=case_key,
            case_result=completed_result,
            execution_evidence=execution_evidence,
        )
        return completed_result

    def finish_case_failure(
        failure: ModelContractExhausted,
    ) -> dict:
        failure_record = failure.failure_record(
            case_key=case_key,
            attempt_count=call_count,
        )
        if journal_state is None:
            return {
                **failure_record,
                "call_count": call_count,
                "served_provider": served_provider,
                "execution_state": {
                    "spent_usd": format(spent_usd, "f"),
                    "completed_case_keys": list(
                        state["completed_case_keys"]
                    ),
                    "failed_case_keys": [
                        *state["failed_case_keys"],
                        case_key,
                    ],
                },
            }

        current_journal = load_or_initialize_execution_journal(
            Path(journal_path),
            benchmark_binding=benchmark_binding,
            ordered_case_keys=ordered_case_keys,
        )
        if case_key in current_journal["completed_case_keys"]:
            raise ValueError("Benchmark case is already completed")
        persisted = record_case_failure(
            Path(journal_path),
            case_key=case_key,
            failure=failure_record,
        )
        return {
            **failure_record,
            "call_count": call_count,
            "served_provider": served_provider,
            "execution_state": {
                "spent_usd": persisted["spent_usd"],
                "completed_case_keys": list(
                    persisted["completed_case_keys"]
                ),
                "failed_case_keys": list(persisted["failed_case_keys"]),
            },
        }

    audit_payload = benchmark_payload(
        openrouter_audit_payload(episode, transcript, draft, review_context)
    )
    audit_content = request_phase(audit_payload, phase="audit")
    try:
        audit_result = parse_review_content(audit_content)
        validated_audit = validate_audit_result(
            audit_result, transcript, review_context
        )
    except (TypeError, ValueError) as error:
        if repair_count >= config["max_repairs_per_case"]:
            raise
        repair_count += 1
        audit_payload = build_audit_repair_payload(
            audit_payload,
            audit_content,
            slugify_repair_detail_code(str(error)),
        )
        audit_content = request_phase(audit_payload, phase="audit")
        try:
            validated_audit = _validate_repaired_audit_contract(
                audit_content,
                transcript,
                review_context,
            )
        except ModelContractExhausted as failure:
            return finish_case_failure(failure)

    if validated_audit["status"] == "fail":
        final_markdown = accepted_final_markdown(validated_audit, None, draft)
        execution_state = {
            "spent_usd": format(spent_usd, "f"),
            "completed_case_keys": [
                *state["completed_case_keys"],
                case_key,
            ],
            "failed_case_keys": list(state["failed_case_keys"]),
        }
        return finish_case_result(
            {
                "audit_result": validated_audit,
                "edit_result": None,
                "accepted_final_markdown": final_markdown,
                "call_count": call_count,
                "served_provider": served_provider,
                "execution_state": execution_state,
            }
        )

    edit_obligations = build_edit_obligations(validated_audit)
    edit_payload = benchmark_payload(
        openrouter_edit_payload(
            episode,
            transcript,
            draft,
            review_context,
            validated_audit,
            edit_obligations,
        )
    )
    edit_content = request_phase(edit_payload, phase="edit")
    try:
        edit_result = parse_review_content(edit_content)
        validated_edit = validate_edit_result(
            edit_result,
            validated_audit,
            draft,
            transcript,
            review_context,
        )
    except (TypeError, ValueError) as error:
        if repair_count >= config["max_repairs_per_case"]:
            raise
        repair_count += 1
        edit_payload = build_edit_repair_payload(
            edit_payload,
            edit_content,
            slugify_repair_detail_code(str(error)),
        )
        edit_content = request_phase(edit_payload, phase="edit")
        try:
            validated_edit = _validate_repaired_edit_contract(
                edit_content,
                validated_audit,
                draft,
                transcript,
                review_context,
            )
        except ModelContractExhausted as failure:
            return finish_case_failure(failure)

    final_markdown = accepted_final_markdown(
        validated_audit, validated_edit, draft
    )
    execution_state = {
        "spent_usd": format(spent_usd, "f"),
        "completed_case_keys": [
            *state["completed_case_keys"],
            case_key,
        ],
        "failed_case_keys": list(state["failed_case_keys"]),
    }

    return finish_case_result(
        {
            "audit_result": validated_audit,
            "edit_result": validated_edit,
            "accepted_final_markdown": final_markdown,
            "call_count": call_count,
            "served_provider": served_provider,
            "execution_state": execution_state,
        }
    )



def execute_canned_qualification_case(
    *,
    model_id: str,
    fixture: dict,
    episode: dict,
    system_prompt: str,
    config: dict,
    provider_lock: dict,
    transport,
) -> dict:
    """Run one zero-spend canned qualification case through the real V2 state machine."""

    if not isinstance(fixture, dict):
        raise ValueError("Benchmark v2 canned qualification fixture must be an object")

    case_id = fixture.get("case_id")
    transcript = fixture.get("transcript")
    draft = fixture.get("draft")
    if (
        not isinstance(case_id, str)
        or not case_id
        or not isinstance(transcript, str)
        or not transcript
        or not isinstance(draft, str)
        or not draft
    ):
        raise ValueError(
            "Benchmark v2 canned qualification fixture requires "
            "case_id, transcript, and draft"
        )

    review_context = build_review_context(transcript, draft)
    case_key = f"{model_id}::{case_id}"
    case_result = execute_case(
        model_id=model_id,
        system_prompt=system_prompt,
        episode=episode,
        transcript=transcript,
        draft=draft,
        review_context=review_context,
        config=config,
        provider_lock=provider_lock,
        persisted_state={
            "spent_usd": "0.00",
            "completed_case_keys": [],
        },
        ordered_case_keys=[case_key],
        case_key=case_key,
        call_reservation_usd=Decimal("0"),
        transport=transport,
    )

    evaluation = evaluate_qualification_case(
        fixture,
        review_context,
        case_result,
    )
    score = score_qualification_case(
        fixture,
        review_context,
        case_result,
    )
    base_call_count = 1 if case_result["audit_result"]["status"] == "fail" else 2

    return {
        "evaluation": evaluation,
        "score": score,
        "repair_turns": case_result["call_count"] - base_call_count,
        "cost_usd": case_result["execution_state"]["spent_usd"],
        "latency_ms": 0,
        "artifact": {
            "model_id": model_id,
            "case_id": case_id,
            "served_provider": case_result["served_provider"],
            "call_count": case_result["call_count"],
            "mode": "canned",
        },
        "result": case_result,
    }

def build_canned_qualification_response_pair(
    *,
    fixture: dict,
    review_context: dict,
) -> dict:
    """Build contract-valid canonical AUDIT/EDIT responses for Task-9 dry runs."""

    if not isinstance(fixture, dict):
        raise ValueError("Benchmark v2 canned qualification fixture must be an object")
    if not isinstance(review_context, dict):
        raise ValueError(
            "Benchmark v2 canned qualification review context must be an object"
        )

    case_id = fixture.get("case_id")
    transcript = fixture.get("transcript")
    draft = fixture.get("draft")
    hard_gate = fixture.get("hard_gate")
    canonical_case_ids = {
        "q1_clean_restraint",
        "q2_unsupported_precision",
        "q3_term_normalization",
        "q4_epistemic_causal_recommendation_drift",
        "q5_coverage_omission",
        "q6_structure_redundancy",
    }
    if (
        case_id not in canonical_case_ids
        or not isinstance(transcript, str)
        or not transcript
        or not isinstance(draft, str)
        or not draft
        or not isinstance(hard_gate, dict)
    ):
        raise ValueError(
            "Benchmark v2 canned qualification requires one canonical fixture"
        )

    if review_context != build_review_context(transcript, draft):
        raise ValueError(
            "Benchmark v2 canned qualification review context must match fixture bytes"
        )

    spans = review_context.get("transcript_span_index", {}).get("spans")
    risks = review_context.get("risk_inventory", {}).get("risks")
    if (
        not isinstance(spans, list)
        or not spans
        or not isinstance(spans[0], dict)
        or not isinstance(spans[0].get("span_id"), str)
        or not isinstance(risks, list)
        or any(not isinstance(risk, dict) for risk in risks)
    ):
        raise ValueError(
            "Benchmark v2 canned qualification review context is incomplete"
        )
    evidence_span_id = spans[0]["span_id"]

    risk_expectations = {}
    raw_risk_expectations = hard_gate.get("risk_expectations")
    if not isinstance(raw_risk_expectations, list):
        raise ValueError(
            "Benchmark v2 canned qualification risk expectations must be a list"
        )
    for expectation in raw_risk_expectations:
        risk_ids = expectation.get("risk_ids") if isinstance(expectation, dict) else None
        if (
            not isinstance(risk_ids, list)
            or not risk_ids
            or any(not isinstance(risk_id, str) or not risk_id for risk_id in risk_ids)
        ):
            raise ValueError(
                "Benchmark v2 canned qualification risk expectation is invalid"
            )
        for risk_id in risk_ids:
            if risk_id in risk_expectations:
                raise ValueError(
                    "Benchmark v2 canned qualification risk expectation is duplicated"
                )
            risk_expectations[risk_id] = expectation

    known_risk_ids = {
        risk.get("risk_id")
        for risk in risks
        if isinstance(risk.get("risk_id"), str)
    }
    if set(risk_expectations) - known_risk_ids:
        raise ValueError(
            "Benchmark v2 canned qualification risk expectation references an unknown risk"
        )

    risk_assessments = []
    for risk in risks:
        risk_id = risk.get("risk_id")
        draft_block_id = risk.get("draft_block_id")
        if (
            not isinstance(risk_id, str)
            or not risk_id
            or not isinstance(draft_block_id, str)
            or not draft_block_id
        ):
            raise ValueError(
                "Benchmark v2 canned qualification risk inventory is invalid"
            )

        expectation = risk_expectations.get(risk_id)
        disposition = (
            expectation.get("required_disposition")
            if expectation is not None
            else "supported"
        )
        if disposition == "issue":
            issue_type = expectation.get("required_issue_type")
            if not isinstance(issue_type, str) or not issue_type:
                raise ValueError(
                    "Benchmark v2 canned qualification issue risk lacks issue type"
                )
            severity = "material"
            span_ids = [evidence_span_id]
            resolution = "Revise this bounded claim to match the supplied transcript."
        elif disposition == "supported":
            issue_type = None
            severity = None
            span_ids = [evidence_span_id]
            resolution = "The supplied transcript supports this bounded claim."
        elif disposition == "not_applicable":
            issue_type = None
            severity = None
            span_ids = []
            resolution = "This deterministic risk surface is not applicable here."
        else:
            raise ValueError(
                "Benchmark v2 canned qualification risk disposition is invalid"
            )

        risk_assessments.append(
            {
                "risk_id": risk_id,
                "disposition": disposition,
                "issue_type": issue_type,
                "severity": severity,
                "draft_block_ids": [draft_block_id],
                "transcript_span_ids": span_ids,
                "resolution": resolution,
            }
        )

    required_additional_types = hard_gate.get("required_additional_issue_types")
    additional_expectations = hard_gate.get("additional_issue_expectations", [])
    if (
        not isinstance(required_additional_types, list)
        or not isinstance(additional_expectations, list)
        or len(required_additional_types) != len(additional_expectations)
    ):
        raise ValueError(
            "Benchmark v2 canned qualification additional-issue expectations are invalid"
        )

    additional_issues = []
    for required_type, expectation in zip(
        required_additional_types,
        additional_expectations,
    ):
        if (
            not isinstance(required_type, str)
            or not isinstance(expectation, dict)
            or expectation.get("required_issue_type") != required_type
            or not isinstance(expectation.get("draft_block_ids"), list)
            or not isinstance(expectation.get("transcript_span_ids"), list)
        ):
            raise ValueError(
                "Benchmark v2 canned qualification additional-issue expectation is invalid"
            )
        additional_issues.append(
            {
                "issue_type": required_type,
                "severity": (
                    "minor"
                    if required_type in {"redundancy", "structure_violation"}
                    else "material"
                ),
                "draft_block_ids": list(expectation["draft_block_ids"]),
                "transcript_span_ids": list(expectation["transcript_span_ids"]),
                "resolution": "Apply only the bounded correction required by this fixture.",
            }
        )

    audit = validate_audit_result(
        {
            "status": hard_gate.get("required_status"),
            "risk_assessments": risk_assessments,
            "additional_issues": additional_issues,
        },
        transcript,
        review_context,
    )

    def replace_once(text: str, old: str, new: str) -> str:
        if text.count(old) != 1:
            raise ValueError(
                f"Benchmark v2 canned qualification edit surface changed for {case_id}"
            )
        return text.replace(old, new, 1)

    if case_id == "q1_clean_restraint":
        final_markdown = draft
    elif case_id == "q2_unsupported_precision":
        final_markdown = replace_once(
            draft,
            "- Successful handoffs occurred in exactly 87% of sessions.",
            "- Successful handoffs were common, while some sessions still needed manual correction.",
        )
    elif case_id == "q3_term_normalization":
        final_markdown = replace_once(
            draft,
            "- The AeroFlux-X9 device was the system used in the test.",
            "- The recorded device label was uncertain, and no official product spelling was established.",
        )
    elif case_id == "q4_epistemic_causal_recommendation_drift":
        final_markdown = replace_once(
            draft,
            "- Listeners should use the timing pattern because it certainly causes better recovery.",
            "- The timing pattern might be associated with better recovery, but the observation was preliminary.",
        )
        final_markdown = replace_once(
            final_markdown,
            "The episode proves the timing pattern leads to better recovery.",
            "The observation did not establish cause, and the guest did not recommend changing anyone's routine from it alone.",
        )
    elif case_id == "q5_coverage_omission":
        final_markdown = (
            draft
            + "\nSleep schedules, family responsibilities, and evening routines changed adherence.\n"
        )
    else:
        sentence = "The warm-up raises temperature and rehearses the first movement."
        final_markdown = replace_once(
            draft,
            f"{sentence}\n\n{sentence}",
            sentence,
        )

    obligations = build_edit_obligations(audit)
    edit = validate_edit_result(
        {
            "resolved_issue_ids": [
                obligation["issue_id"] for obligation in obligations
            ],
            "final_markdown": final_markdown,
        },
        audit,
        draft,
        transcript,
        review_context,
    )

    return {
        "audit": audit,
        "edit": edit,
    }


def _execute_zero_paid_geoffrey_terminal_probe(
    _selected_candidate: dict,
    _run_number: int,
) -> dict:
    """Exercise fail-closed Geoffrey plumbing without transport capability."""

    raise RuntimeError(
        "Benchmark v2 deterministic zero-paid Geoffrey terminal probe"
    )


def run_canonical_canned_qualification_matrix_dry_run(
    *,
    lock_dir: Path,
    config: dict,
    fixture_set: dict,
    candidate_routes: dict,
    provider_lock: dict,
    qualification_evidence: dict,
    system_prompt: str,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    benchmark_binding: dict | None = None,
    designated_candidate_ids: list[str] | None = None,
) -> dict:
    """Run the canonical 5x6 qualification matrix through the real canned state machine."""

    if not isinstance(fixture_set, dict):
        raise ValueError("Benchmark v2 canned qualification fixture set must be an object")
    episode_template = fixture_set.get("episode_template")
    if not isinstance(episode_template, dict):
        raise ValueError(
            "Benchmark v2 canned qualification fixture set requires episode_template"
        )

    def execute_canned_case(*, model_id: str, fixture: dict) -> dict:
        route = candidate_routes.get(model_id)
        if not isinstance(route, dict):
            raise ValueError(
                "Benchmark v2 canned qualification candidate route must be an object"
            )
        served_provider = route.get("observed_served_provider_identity")
        if not isinstance(served_provider, str) or not served_provider:
            raise ValueError(
                "Benchmark v2 canned qualification served-provider identity is invalid"
            )

        transcript = fixture.get("transcript")
        draft = fixture.get("draft")
        case_id = fixture.get("case_id")
        if (
            not isinstance(transcript, str)
            or not transcript
            or not isinstance(draft, str)
            or not draft
            or not isinstance(case_id, str)
            or not case_id
        ):
            raise ValueError(
                "Benchmark v2 canned qualification fixture identity is invalid"
            )

        review_context = build_review_context(transcript, draft)
        pair = build_canned_qualification_response_pair(
            fixture=fixture,
            review_context=review_context,
        )

        def response_payload(content: dict, completion_id: str) -> dict:
            return {
                "id": completion_id,
                "model": model_id,
                "openrouter_metadata": {
                    "endpoints": {
                        "available": [
                            {
                                "provider": served_provider,
                                "selected": True,
                            }
                        ]
                    }
                },
                "usage": {
                    "prompt_tokens": 10,
                    "completion_tokens": 5,
                    "total_tokens": 15,
                    "cost": 0,
                },
                "choices": [
                    {
                        "message": {
                            "content": json.dumps(content),
                        }
                    }
                ],
            }

        def canned_transport(payload: dict) -> dict:
            schema_name = payload["response_format"]["json_schema"]["name"]
            if schema_name == "podcast_summary_review_audit":
                return response_payload(
                    pair["audit"],
                    f"task9-{case_id}-audit",
                )
            if schema_name == "podcast_summary_review_edit":
                return response_payload(
                    pair["edit"],
                    f"task9-{case_id}-edit",
                )
            raise AssertionError(
                f"unexpected Task 9 canned phase schema: {schema_name}"
            )

        episode = {
            **episode_template,
            "episode_key": f"task9-{case_id}",
        }
        return execute_canned_qualification_case(
            model_id=model_id,
            fixture=fixture,
            episode=episode,
            system_prompt=system_prompt,
            config=config,
            provider_lock=provider_lock,
            transport=canned_transport,
        )

    return run_canonical_qualification_matrix_dry_run(
        lock_dir=Path(lock_dir),
        config=config,
        fixture_set=fixture_set,
        candidate_routes=candidate_routes,
        qualification_case_executor=execute_canned_case,
        qualification_evidence=qualification_evidence,
        transcript_bytes=transcript_bytes,
        draft_bytes=draft_bytes,
        geoffrey_run_executor=_execute_zero_paid_geoffrey_terminal_probe,
        benchmark_binding=benchmark_binding,
        designated_candidate_ids=designated_candidate_ids,
    )


def build_qualification_lock_binding(
    *,
    canonical_candidate_ids: list[str],
    canonical_case_ids: list[str],
    config_bytes: bytes,
    prompt_bytes: bytes,
    provider_lock_bytes: bytes,
    case_artifacts: list[dict],
    raw_case_records: list[dict],
    recomputed_case_records: list[dict],
    benchmark_binding: dict | None = None,
) -> dict:
    """Bind exact raw Reviewer-v2 evidence and recomputed Task-6 truth."""

    import hashlib

    def require_canonical_ids(name: str, values: object) -> list[str]:
        if (
            not isinstance(values, list)
            or not values
            or any(
                not isinstance(value, str) or not value
                for value in values
            )
            or len(set(values)) != len(values)
        ):
            raise ValueError(
                f"Benchmark v2 qualification binding requires canonical {name}"
            )
        return values

    def sha256_bytes(name: str, value: object) -> str:
        if not isinstance(value, bytes):
            raise ValueError(
                f"Benchmark v2 qualification binding requires exact {name} bytes"
            )
        return "sha256:" + hashlib.sha256(value).hexdigest()

    def canonical_json_bytes(value: object) -> bytes:
        try:
            return (
                json.dumps(
                    value,
                    ensure_ascii=False,
                    indent=2,
                    sort_keys=True,
                )
                + "\n"
            ).encode("utf-8")
        except (TypeError, ValueError) as error:
            raise ValueError(
                "Benchmark v2 qualification case result must be canonical JSON"
            ) from error

    candidate_ids = require_canonical_ids(
        "candidate IDs",
        canonical_candidate_ids,
    )
    case_ids = require_canonical_ids(
        "case IDs",
        canonical_case_ids,
    )

    if not isinstance(case_artifacts, list):
        raise ValueError(
            "Benchmark v2 qualification binding requires case artifacts"
        )

    artifacts_by_case: dict[str, dict] = {}
    for artifact in case_artifacts:
        if not isinstance(artifact, dict) or set(artifact) != {
            "case_id",
            "fixture_bytes",
            "gate_bytes",
        }:
            raise ValueError(
                "Benchmark v2 qualification binding case artifact is malformed"
            )
        case_id = artifact["case_id"]
        if (
            case_id not in case_ids
            or case_id in artifacts_by_case
        ):
            raise ValueError(
                "Benchmark v2 qualification binding has duplicate or unknown case artifacts"
            )
        sha256_bytes("fixture", artifact["fixture_bytes"])
        sha256_bytes("gate", artifact["gate_bytes"])
        artifacts_by_case[case_id] = artifact

    if set(artifacts_by_case) != set(case_ids):
        raise ValueError(
            "Benchmark v2 qualification binding requires every canonical case artifact"
        )

    expected_pairs = {
        (candidate_id, case_id)
        for candidate_id in candidate_ids
        for case_id in case_ids
    }

    if not isinstance(raw_case_records, list):
        raise ValueError(
            "Benchmark v2 qualification binding requires raw case records"
        )
    raw_required_fields = {
        "candidate_id",
        "case_id",
        "case_result",
        "routing_provider_slug",
        "served_provider",
        "repair_turns",
        "cost_usd",
        "latency_ms",
    }
    raw_by_pair: dict[tuple[str, str], dict] = {}
    for record in raw_case_records:
        if not isinstance(record, dict) or set(record) != raw_required_fields:
            raise ValueError(
                "Benchmark v2 qualification binding raw case record is malformed"
            )
        candidate_id = record["candidate_id"]
        case_id = record["case_id"]
        pair = (candidate_id, case_id)
        if pair not in expected_pairs or pair in raw_by_pair:
            raise ValueError(
                "Benchmark v2 qualification binding has duplicate or unknown raw candidate case results"
            )
        raw_case_result = record["case_result"]
        if not isinstance(raw_case_result, dict):
            raise ValueError(
                "Benchmark v2 qualification binding raw case result must be an object"
            )
        canonical_json_bytes(raw_case_result)
        raw_by_pair[pair] = record

    if set(raw_by_pair) != expected_pairs:
        raise ValueError(
            "Benchmark v2 qualification binding requires exactly every raw candidate case result"
        )

    if not isinstance(recomputed_case_records, list):
        raise ValueError(
            "Benchmark v2 qualification binding requires recomputed case records"
        )
    recomputed_by_pair: dict[tuple[str, str], dict] = {}
    for record in recomputed_case_records:
        if not isinstance(record, dict) or set(record) != {
            "candidate_id",
            "case_id",
            "result",
        }:
            raise ValueError(
                "Benchmark v2 qualification binding recomputed case result is malformed"
            )
        candidate_id = record["candidate_id"]
        case_id = record["case_id"]
        pair = (candidate_id, case_id)
        if pair not in expected_pairs or pair in recomputed_by_pair:
            raise ValueError(
                "Benchmark v2 qualification binding has duplicate or unknown recomputed candidate case results"
            )
        if not isinstance(record["result"], dict):
            raise ValueError(
                "Benchmark v2 qualification binding recomputed case result payload must be an object"
            )
        canonical_json_bytes(record)
        recomputed_by_pair[pair] = record

    if set(recomputed_by_pair) != expected_pairs:
        raise ValueError(
            "Benchmark v2 qualification binding requires exactly every recomputed candidate case result"
        )

    binding = {
        "benchmark_config_sha256": sha256_bytes(
            "benchmark config",
            config_bytes,
        ),
        "reviewer_prompt_sha256": sha256_bytes(
            "reviewer prompt",
            prompt_bytes,
        ),
        "provider_lock_sha256": sha256_bytes(
            "provider lock",
            provider_lock_bytes,
        ),
        "qualification_cases": [
            {
                "case_id": case_id,
                "fixture_sha256": sha256_bytes(
                    "fixture",
                    artifacts_by_case[case_id]["fixture_bytes"],
                ),
                "gate_sha256": sha256_bytes(
                    "gate",
                    artifacts_by_case[case_id]["gate_bytes"],
                ),
            }
            for case_id in case_ids
        ],
        "candidate_case_results": [
            {
                "candidate_id": candidate_id,
                "cases": [
                    {
                        "case_id": case_id,
                        "raw_case_result_sha256": sha256_bytes(
                            "raw case result",
                            canonical_json_bytes(
                                raw_by_pair[(candidate_id, case_id)]["case_result"]
                            ),
                        ),
                        "recomputed_case_result_sha256": sha256_bytes(
                            "recomputed case result",
                            canonical_json_bytes(
                                recomputed_by_pair[(candidate_id, case_id)]
                            ),
                        ),
                    }
                    for case_id in case_ids
                ],
            }
            for candidate_id in candidate_ids
        ],
    }
    if benchmark_binding is not None:
        binding["benchmark_binding"] = _require_benchmark_binding(
            benchmark_binding
        )
    return binding


def write_qualification_decision_lock(
    *,
    lock_dir: Path,
    binding: dict,
    selected_candidate: dict | None,
) -> dict:
    """Write or byte-verify one immutable Task-7 qualification decision lock."""

    if not isinstance(binding, dict):
        raise ValueError(
            "Benchmark v2 qualification decision lock requires a binding object"
        )
    if selected_candidate is not None and not isinstance(selected_candidate, dict):
        raise ValueError(
            "Benchmark v2 qualification decision lock candidate must be an object or null"
        )

    decision = "advance" if selected_candidate is not None else "no_winner"
    filename = (
        "qualification.lock.json"
        if decision == "advance"
        else "qualification.no_winner.lock.json"
    )
    opposite_filename = (
        "qualification.no_winner.lock.json"
        if decision == "advance"
        else "qualification.lock.json"
    )
    payload = {
        "lock_format": 1,
        "decision": decision,
        "binding": binding,
        "selected_candidate": selected_candidate,
    }
    try:
        expected_bytes = (
            json.dumps(
                payload,
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
            + "\n"
        ).encode("utf-8")
    except (TypeError, ValueError) as error:
        raise ValueError(
            "Benchmark v2 qualification decision lock payload is not canonical JSON"
        ) from error

    lock_dir = Path(lock_dir)
    target_path = lock_dir / filename
    opposite_path = lock_dir / opposite_filename

    if opposite_path.exists():
        raise ValueError(
            "Benchmark v2 qualification decision lock conflicts with an existing opposite decision"
        )

    if target_path.exists():
        if not target_path.is_file():
            raise ValueError(
                "Benchmark v2 qualification decision lock path is not a file"
            )
        try:
            existing_bytes = target_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 qualification decision lock is unreadable"
            ) from error
        if existing_bytes != expected_bytes:
            raise ValueError(
                "Benchmark v2 qualification decision lock is immutable and conflicts"
            )
        return {
            "path": target_path,
            "payload": payload,
        }

    try:
        lock_dir.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise ValueError(
            "Benchmark v2 qualification decision lock directory is unavailable"
        ) from error

    if opposite_path.exists():
        raise ValueError(
            "Benchmark v2 qualification decision lock conflicts with an existing opposite decision"
        )

    try:
        with target_path.open("xb") as handle:
            handle.write(expected_bytes)
    except FileExistsError:
        try:
            existing_bytes = target_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 qualification decision lock is unreadable"
            ) from error
        if existing_bytes != expected_bytes:
            raise ValueError(
                "Benchmark v2 qualification decision lock is immutable and conflicts"
            )
    except OSError as error:
        raise ValueError(
            "Benchmark v2 qualification decision lock could not be written"
        ) from error

    return {
        "path": target_path,
        "payload": payload,
    }


def _validate_qualification_lock_evidence_consistency(
    *,
    canonical_candidate_ids: list[str],
    canonical_case_ids: list[str],
    candidate_results: list[dict],
    provider_lock_bytes: bytes,
    case_results: list[dict],
) -> None:
    """Require lock evidence to describe the same canonical qualification outcome."""

    if not isinstance(provider_lock_bytes, bytes):
        raise ValueError(
            "Benchmark v2 qualification provider-lock evidence must be exact bytes"
        )
    try:
        provider_lock = json.loads(provider_lock_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 qualification provider-lock evidence is invalid JSON"
        ) from error

    locked_models = (
        provider_lock.get("models")
        if isinstance(provider_lock, dict)
        else None
    )
    if (
        not isinstance(locked_models, dict)
        or set(locked_models) != set(canonical_candidate_ids)
    ):
        raise ValueError(
            "Benchmark v2 qualification provider lock must cover canonical candidates exactly"
        )

    candidates_by_id = {
        candidate_result["candidate_id"]: candidate_result
        for candidate_result in candidate_results
    }
    for candidate_id in canonical_candidate_ids:
        candidate_result = candidates_by_id[candidate_id]
        provider_entry = locked_models.get(candidate_id)
        if not isinstance(provider_entry, dict):
            raise ValueError(
                "Benchmark v2 qualification provider-lock candidate entry is invalid"
            )

        routing_provider_slug = candidate_result.get("routing_provider_slug")
        observed_served_provider = candidate_result.get(
            "observed_served_provider_identity"
        )
        compatible_served_providers = provider_entry.get(
            "compatible_served_providers"
        )
        if (
            not isinstance(routing_provider_slug, str)
            or not routing_provider_slug
            or routing_provider_slug != provider_entry.get("routing_provider_slug")
            or not isinstance(observed_served_provider, str)
            or not observed_served_provider
            or not isinstance(compatible_served_providers, list)
            or observed_served_provider not in compatible_served_providers
        ):
            raise ValueError(
                "Benchmark v2 qualification candidate provider identity does not match provider lock"
            )

    expected_pairs = {
        (candidate_id, case_id)
        for candidate_id in canonical_candidate_ids
        for case_id in canonical_case_ids
    }
    seen_pairs = set()
    for record in case_results:
        if not isinstance(record, dict):
            raise ValueError(
                "Benchmark v2 qualification case-result evidence is invalid"
            )
        candidate_id = record.get("candidate_id")
        case_id = record.get("case_id")
        result = record.get("result")
        pair = (candidate_id, case_id)
        if (
            pair not in expected_pairs
            or pair in seen_pairs
            or not isinstance(result, dict)
        ):
            raise ValueError(
                "Benchmark v2 qualification case-result evidence is invalid"
            )
        seen_pairs.add(pair)

        candidate_result = candidates_by_id[candidate_id]
        eligibility_by_case = {
            item["case_id"]: item
            for item in candidate_result["eligibility"]["case_results"]
        }
        scores_by_case = {
            item["case_id"]: item
            for item in candidate_result["aggregate_score"]["case_scores"]
        }
        expected_eligibility = eligibility_by_case[case_id]
        expected_score = scores_by_case[case_id]

        if (
            result.get("candidate_id") != candidate_id
            or result.get("case_id") != case_id
            or result.get("hard_gate_passed")
            != expected_eligibility["hard_gate_passed"]
            or result.get("score") != expected_score["score"]
            or result.get("max_score") != expected_score["max_score"]
            or result.get("served_provider")
            != candidate_result["observed_served_provider_identity"]
        ):
            raise ValueError(
                "Benchmark v2 qualification case-result evidence disagrees with candidate result"
            )

    if seen_pairs != expected_pairs:
        raise ValueError(
            "Benchmark v2 qualification case-result evidence must cover every candidate case exactly once"
        )


def finalize_qualification_decision(
    *,
    lock_dir: Path,
    canonical_candidate_ids: list[str],
    canonical_case_ids: list[str],
    raw_case_records: list[dict],
    config_bytes: bytes,
    prompt_bytes: bytes,
    provider_lock_bytes: bytes,
    case_artifacts: list[dict],
    benchmark_binding: dict | None = None,
) -> dict:
    """Recompute, select, bind, and immutably lock one Task-7 decision."""

    candidate_ids = require_canonical_candidate_ids(canonical_candidate_ids)
    fixture_set = _load_canonical_qualification_fixture_set()
    fixture_case_ids = [
        fixture["case_id"] for fixture in fixture_set["cases"]
    ]
    if canonical_case_ids != fixture_case_ids:
        raise ValueError(
            "Benchmark v2 qualification finalization requires exact canonical case order"
        )

    candidate_results, recomputed_case_records = build_canonical_candidate_results(
        fixture_set=fixture_set,
        canonical_candidate_ids=candidate_ids,
        raw_case_records=raw_case_records,
        provider_lock_bytes=provider_lock_bytes,
    )
    selected_candidate = select_qualification_winner(
        canonical_candidate_ids=list(candidate_ids),
        candidate_results=candidate_results,
    )
    _validate_qualification_lock_evidence_consistency(
        canonical_candidate_ids=list(candidate_ids),
        canonical_case_ids=canonical_case_ids,
        candidate_results=candidate_results,
        provider_lock_bytes=provider_lock_bytes,
        case_results=recomputed_case_records,
    )
    binding = build_qualification_lock_binding(
        canonical_candidate_ids=list(candidate_ids),
        canonical_case_ids=canonical_case_ids,
        config_bytes=config_bytes,
        prompt_bytes=prompt_bytes,
        provider_lock_bytes=provider_lock_bytes,
        case_artifacts=case_artifacts,
        raw_case_records=raw_case_records,
        recomputed_case_records=recomputed_case_records,
        benchmark_binding=benchmark_binding,
    )
    return write_qualification_decision_lock(
        lock_dir=lock_dir,
        binding=binding,
        selected_candidate=selected_candidate,
    )


def run_geoffrey_with_qualification_lock(
    *,
    lock_dir: Path,
    expected_binding: dict,
    geoffrey_executor,
):
    """Run Geoffrey only after validating the exact immutable ADVANCE lock."""

    lock_dir = Path(lock_dir)
    qualification_path = lock_dir / "qualification.lock.json"
    no_winner_path = lock_dir / "qualification.no_winner.lock.json"

    if no_winner_path.exists():
        raise ValueError(
            "Benchmark v2 Geoffrey execution is blocked by a NO WINNER qualification lock"
        )
    if not qualification_path.is_file():
        raise ValueError(
            "Benchmark v2 Geoffrey execution requires qualification.lock.json"
        )

    try:
        lock_bytes = qualification_path.read_bytes()
    except OSError as error:
        raise ValueError(
            "Benchmark v2 qualification lock is unreadable"
        ) from error

    try:
        payload = json.loads(lock_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 qualification lock is invalid JSON"
        ) from error

    if not isinstance(payload, dict):
        raise ValueError(
            "Benchmark v2 qualification lock must be an object"
        )

    try:
        canonical_bytes = (
            json.dumps(
                payload,
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
            + "\n"
        ).encode("utf-8")
    except (TypeError, ValueError) as error:
        raise ValueError(
            "Benchmark v2 qualification lock is not canonical JSON"
        ) from error

    if lock_bytes != canonical_bytes:
        raise ValueError(
            "Benchmark v2 qualification lock bytes are not canonical"
        )

    if (
        payload.get("lock_format") != 1
        or payload.get("decision") != "advance"
        or payload.get("binding") != expected_binding
    ):
        raise ValueError(
            "Benchmark v2 qualification lock does not match the expected ADVANCE binding"
        )

    selected_candidate = payload.get("selected_candidate")
    if not isinstance(selected_candidate, dict):
        raise ValueError(
            "Benchmark v2 qualification lock selected candidate is invalid"
        )

    candidate_id = selected_candidate.get("candidate_id")
    model_id = selected_candidate.get("model_id")
    routing_provider_slug = selected_candidate.get("routing_provider_slug")
    observed_served_provider = selected_candidate.get(
        "observed_served_provider_identity"
    )
    eligibility = selected_candidate.get("eligibility")

    canonical_config, _canonical_config_bytes = load_canonical_benchmark_v2_config()
    committed_candidates = require_canonical_candidate_ids(
        canonical_config["models"]
    )
    if candidate_id not in committed_candidates:
        raise ValueError(
            "Benchmark v2 Geoffrey lock selected model must be a committed candidate"
        )

    if (
        not isinstance(candidate_id, str)
        or not candidate_id
        or model_id != candidate_id
        or not isinstance(routing_provider_slug, str)
        or not routing_provider_slug
        or not isinstance(observed_served_provider, str)
        or not observed_served_provider
        or not isinstance(eligibility, dict)
        or eligibility.get("eligible") is not True
        or eligibility.get("passed_case_count") != 6
        or eligibility.get("required_case_count") != 6
    ):
        raise ValueError(
            "Benchmark v2 qualification lock model/provider/eligibility identity is invalid"
        )

    if not callable(geoffrey_executor):
        raise ValueError(
            "Benchmark v2 Geoffrey executor must be callable"
        )

    return geoffrey_executor(selected_candidate)

def prepare_benchmark_v2_operator_workspace(
    *,
    repository_root: Path,
) -> dict:
    """Prepare the bounded ignored Task-9 operator evidence workspace."""

    repository_root = Path(repository_root)
    if not repository_root.is_dir():
        raise ValueError(
            "Benchmark v2 operator repository root must be a directory"
        )

    benchmark_parent = repository_root / "var" / "benchmarks"
    benchmark_root = benchmark_parent / "summary-review-v2"
    locks_dir = benchmark_root / "locks"
    preflight_root = benchmark_root / "preflight"
    preflight_locks_dir = preflight_root / "locks"

    for candidate, label in (
        (repository_root / "var", "benchmark runtime directory"),
        (benchmark_parent, "benchmark evidence parent"),
        (benchmark_root, "benchmark evidence root"),
        (locks_dir, "benchmark locks directory"),
        (preflight_root, "benchmark preflight directory"),
        (preflight_locks_dir, "benchmark preflight locks directory"),
    ):
        if candidate.is_symlink():
            raise ValueError(
                f"Benchmark v2 {label} must not be a symlink"
            )

    try:
        benchmark_root.mkdir(parents=True, exist_ok=True)
        locks_dir.mkdir(exist_ok=True)
        preflight_locks_dir.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise ValueError(
            "Benchmark v2 operator workspace could not be created"
        ) from error

    if not benchmark_root.is_dir() or benchmark_root.is_symlink():
        raise ValueError(
            "Benchmark v2 benchmark evidence root must be a directory and not a symlink"
        )
    if not locks_dir.is_dir() or locks_dir.is_symlink():
        raise ValueError(
            "Benchmark v2 benchmark locks directory must be a directory and not a symlink"
        )
    if not preflight_locks_dir.is_dir() or preflight_locks_dir.is_symlink():
        raise ValueError(
            "Benchmark v2 preflight locks directory must be a directory and not a symlink"
        )

    repository_resolved = repository_root.resolve()
    benchmark_root_resolved = benchmark_root.resolve()
    try:
        benchmark_root_resolved.relative_to(repository_resolved)
    except ValueError as error:
        raise ValueError(
            "Benchmark v2 benchmark evidence root escapes repository root"
        ) from error

    workspace = {
        "root": benchmark_root,
        "locks_dir": locks_dir,
        "preflight_locks_dir": preflight_locks_dir,
        "provider_lock_path": benchmark_root / "provider-lock.json",
        "pricing_evidence_path": benchmark_root / "pricing-evidence.json",
        "execution_state_path": benchmark_root / "execution-state.json",
        "reveal_path": benchmark_root / "reveal.json",
    }

    for target in workspace.values():
        try:
            target.resolve().relative_to(benchmark_root_resolved)
        except ValueError as error:
            raise ValueError(
                "Benchmark v2 operator workspace path escapes benchmark evidence root"
            ) from error

    return workspace

def build_case_execution_evidence(
    *,
    model_id: str,
    case_id: str,
    routing_provider_slug: str,
    served_provider: str,
    attempts: list[dict],
    case_result: dict,
    spent_before_usd: str,
    config_bytes: bytes,
    provider_lock_bytes: bytes,
    pricing_evidence_bytes: bytes,
) -> dict:
    """Build deterministic per-case evidence for later lock/reveal proof."""

    for label, value in (
        ("model_id", model_id),
        ("case_id", case_id),
        ("routing_provider_slug", routing_provider_slug),
        ("served_provider", served_provider),
    ):
        if not isinstance(value, str) or not value:
            raise ValueError(
                f"Benchmark v2 execution evidence {label} must be a non-empty string"
            )

    for label, value in (
        ("config", config_bytes),
        ("provider lock", provider_lock_bytes),
        ("pricing evidence", pricing_evidence_bytes),
    ):
        if not isinstance(value, bytes):
            raise ValueError(
                f"Benchmark v2 execution evidence {label} must be exact bytes"
            )

    if not isinstance(attempts, list) or not attempts:
        raise ValueError(
            "Benchmark v2 execution evidence attempts must be a non-empty list"
        )
    if not isinstance(case_result, dict):
        raise ValueError(
            "Benchmark v2 execution evidence case result must be an object"
        )

    case_key = f"{model_id}::{case_id}"
    call_count = case_result.get("call_count")
    if (
        isinstance(call_count, bool)
        or not isinstance(call_count, int)
        or call_count != len(attempts)
    ):
        raise ValueError(
            "Benchmark v2 execution evidence attempt count does not match case result"
        )

    if case_result.get("served_provider") != served_provider:
        raise ValueError(
            "Benchmark v2 execution evidence served provider does not match case result"
        )

    execution_state = case_result.get("execution_state")
    if not isinstance(execution_state, dict):
        raise ValueError(
            "Benchmark v2 execution evidence requires execution state"
        )
    completed_case_keys = execution_state.get("completed_case_keys")
    if (
        not isinstance(completed_case_keys, list)
        or case_key not in completed_case_keys
    ):
        raise ValueError(
            "Benchmark v2 execution evidence requires the completed canonical case key"
        )

    def parse_non_negative_decimal(value, label):
        if not isinstance(value, str) or not value:
            raise ValueError(
                f"Benchmark v2 execution evidence {label} must be a decimal string"
            )
        try:
            parsed = Decimal(value)
        except (InvalidOperation, ValueError) as error:
            raise ValueError(
                f"Benchmark v2 execution evidence {label} must be a decimal string"
            ) from error
        if not parsed.is_finite() or parsed < 0:
            raise ValueError(
                f"Benchmark v2 execution evidence {label} must be finite and non-negative"
            )
        return parsed

    spent_before = parse_non_negative_decimal(
        spent_before_usd,
        "spent_before_usd",
    )
    spent_after = parse_non_negative_decimal(
        execution_state.get("spent_usd"),
        "spent_after_usd",
    )
    if spent_after < spent_before:
        raise ValueError(
            "Benchmark v2 execution evidence spend cannot move backwards"
        )

    bounded_attempts = []
    total_prompt_tokens = 0
    total_completion_tokens = 0
    total_tokens = 0
    total_cost = Decimal("0")
    total_latency_ms = 0
    seen_edit = False

    for expected_number, attempt in enumerate(attempts, start=1):
        if not isinstance(attempt, dict):
            raise ValueError(
                "Benchmark v2 execution evidence attempt must be an object"
            )
        if attempt.get("attempt_number") != expected_number:
            raise ValueError(
                "Benchmark v2 execution evidence attempt sequence is not canonical"
            )

        phase = attempt.get("phase")
        if phase not in {"audit", "edit"}:
            raise ValueError(
                "Benchmark v2 execution evidence phase must be audit or edit"
            )
        if expected_number == 1 and phase != "audit":
            raise ValueError(
                "Benchmark v2 execution evidence phase sequence must begin with audit"
            )
        if phase == "edit":
            seen_edit = True
        elif seen_edit:
            raise ValueError(
                "Benchmark v2 execution evidence phase sequence cannot return to audit"
            )

        request_bytes = attempt.get("request_bytes")
        response_bytes = attempt.get("response_bytes")
        if not isinstance(request_bytes, bytes):
            raise ValueError(
                "Benchmark v2 execution evidence request bytes are invalid"
            )
        if not isinstance(response_bytes, bytes):
            raise ValueError(
                "Benchmark v2 execution evidence response bytes are invalid"
            )

        completion_id = attempt.get("completion_id")
        if not isinstance(completion_id, str) or not completion_id:
            raise ValueError(
                "Benchmark v2 execution evidence completion ID is invalid"
            )
        if attempt.get("served_model_id") != model_id:
            raise ValueError(
                "Benchmark v2 execution evidence served model drift is not allowed"
            )
        if attempt.get("served_provider") != served_provider:
            raise ValueError(
                "Benchmark v2 execution evidence served provider drift is not allowed"
            )

        token_values = {}
        for token_field in (
            "prompt_tokens",
            "completion_tokens",
            "total_tokens",
        ):
            token_value = attempt.get(token_field)
            if (
                isinstance(token_value, bool)
                or not isinstance(token_value, int)
                or token_value < 0
            ):
                raise ValueError(
                    f"Benchmark v2 execution evidence {token_field} is invalid"
                )
            token_values[token_field] = token_value
        if (
            token_values["prompt_tokens"]
            + token_values["completion_tokens"]
            != token_values["total_tokens"]
        ):
            raise ValueError(
                "Benchmark v2 execution evidence token totals are inconsistent"
            )

        attempt_cost = parse_non_negative_decimal(
            attempt.get("cost_usd"),
            "attempt cost_usd",
        )
        latency_ms = attempt.get("latency_ms")
        if (
            isinstance(latency_ms, bool)
            or not isinstance(latency_ms, int)
            or latency_ms < 0
        ):
            raise ValueError(
                "Benchmark v2 execution evidence latency_ms is invalid"
            )

        bounded_attempts.append(
            {
                "attempt_number": expected_number,
                "phase": phase,
                "request_sha256": _sha256_bytes(request_bytes),
                "response_sha256": _sha256_bytes(response_bytes),
                "completion_id": completion_id,
                "served_model_id": model_id,
                "served_provider": served_provider,
                "prompt_tokens": token_values["prompt_tokens"],
                "completion_tokens": token_values["completion_tokens"],
                "total_tokens": token_values["total_tokens"],
                "cost_usd": format(attempt_cost, "f"),
                "latency_ms": latency_ms,
            }
        )
        total_prompt_tokens += token_values["prompt_tokens"]
        total_completion_tokens += token_values["completion_tokens"]
        total_tokens += token_values["total_tokens"]
        total_cost += attempt_cost
        total_latency_ms += latency_ms

    if spent_after - spent_before != total_cost:
        raise ValueError(
            "Benchmark v2 execution evidence attempt cost does not match execution-state spend delta"
        )

    try:
        case_result_bytes = (
            json.dumps(
                case_result,
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
            + "\n"
        ).encode("utf-8")
    except (TypeError, ValueError) as error:
        raise ValueError(
            "Benchmark v2 execution evidence case result is not canonical JSON"
        ) from error

    return {
        "case_key": case_key,
        "requested_model_id": model_id,
        "routing_provider_slug": routing_provider_slug,
        "served_provider_identity": served_provider,
        "attempt_count": len(bounded_attempts),
        "attempts": bounded_attempts,
        "usage": {
            "prompt_tokens": total_prompt_tokens,
            "completion_tokens": total_completion_tokens,
            "total_tokens": total_tokens,
        },
        "cost_usd": format(total_cost, "f"),
        "latency_ms": total_latency_ms,
        "spent_before_usd": format(spent_before, "f"),
        "spent_after_usd": format(spent_after, "f"),
        "case_result_sha256": _sha256_bytes(case_result_bytes),
        "frozen_evidence": {
            "config_sha256": _sha256_bytes(config_bytes),
            "provider_lock_sha256": _sha256_bytes(provider_lock_bytes),
            "pricing_evidence_sha256": _sha256_bytes(pricing_evidence_bytes),
        },
    }

def assert_benchmark_v2_artifact_target(
    *,
    repository_root: Path,
    workspace_root: Path,
    target: Path,
) -> Path:
    """Require one Task-9 artifact target to remain inside its canonical workspace."""

    repository_root = Path(repository_root)
    workspace_root = Path(workspace_root)
    target = Path(target)

    if not repository_root.is_dir():
        raise ValueError(
            "Benchmark v2 repository root must be a directory"
        )

    canonical_workspace = (
        repository_root
        / "var"
        / "benchmarks"
        / "summary-review-v2"
    )
    if workspace_root != canonical_workspace:
        raise ValueError(
            "Benchmark v2 workspace root is not canonical"
        )

    if workspace_root.is_symlink():
        raise ValueError(
            "Benchmark v2 workspace root is not canonical: symlink not allowed"
        )

    repository_resolved = repository_root.resolve()
    workspace_resolved = workspace_root.resolve()
    try:
        workspace_resolved.relative_to(repository_resolved)
    except ValueError as error:
        raise ValueError(
            "Benchmark v2 workspace root is not canonical"
        ) from error

    try:
        target_resolved = target.resolve()
        target_resolved.relative_to(workspace_resolved)
    except (OSError, ValueError) as error:
        raise ValueError(
            "Benchmark v2 benchmark artifact target is outside canonical benchmark workspace"
        ) from error

    if target_resolved == workspace_resolved:
        raise ValueError(
            "Benchmark v2 benchmark artifact target is outside writable artifact files"
        )

    return target

def freeze_benchmark_v2_paid_readiness_evidence(
    *,
    repository_root: Path,
    workspace_root: Path,
    provider_lock_bytes: bytes,
    pricing_evidence_bytes: bytes,
) -> dict:
    """Freeze exact provider/pricing readiness bytes before any paid request."""

    for label, value in (
        ("provider-lock", provider_lock_bytes),
        ("pricing-evidence", pricing_evidence_bytes),
    ):
        if not isinstance(value, bytes) or not value:
            raise ValueError(
                f"Benchmark v2 {label} bytes must be non-empty exact bytes"
            )

    repository_root = Path(repository_root)
    workspace_root = Path(workspace_root)
    if not workspace_root.is_dir() or workspace_root.is_symlink():
        raise ValueError(
            "Benchmark v2 readiness workspace root must be a real directory"
        )

    provider_path = workspace_root / "provider-lock.json"
    pricing_path = workspace_root / "pricing-evidence.json"

    assert_benchmark_v2_artifact_target(
        repository_root=repository_root,
        workspace_root=workspace_root,
        target=provider_path,
    )
    assert_benchmark_v2_artifact_target(
        repository_root=repository_root,
        workspace_root=workspace_root,
        target=pricing_path,
    )

    targets = (
        ("provider-lock", provider_path, provider_lock_bytes),
        ("pricing-evidence", pricing_path, pricing_evidence_bytes),
    )

    def verify_existing(label, target, expected_bytes):
        if not target.exists():
            return False
        if not target.is_file() or target.is_symlink():
            raise ValueError(
                f"Benchmark v2 {label} target is not a file"
            )
        try:
            existing_bytes = target.read_bytes()
        except OSError as error:
            raise ValueError(
                f"Benchmark v2 {label} target is unreadable"
            ) from error
        if existing_bytes != expected_bytes:
            raise ValueError(
                f"Benchmark v2 readiness evidence is immutable and conflicts: {label}"
            )
        return True

    existing = {
        label: verify_existing(label, target, expected_bytes)
        for label, target, expected_bytes in targets
    }

    for label, target, expected_bytes in targets:
        if existing[label]:
            continue
        try:
            with target.open("xb") as handle:
                handle.write(expected_bytes)
        except FileExistsError:
            verify_existing(label, target, expected_bytes)
        except OSError as error:
            raise ValueError(
                f"Benchmark v2 {label} target could not be written"
            ) from error

    return {
        "provider_lock_path": provider_path,
        "pricing_evidence_path": pricing_path,
        "provider_lock_sha256": _sha256_bytes(provider_lock_bytes),
        "pricing_evidence_sha256": _sha256_bytes(pricing_evidence_bytes),
    }

def load_canonical_geoffrey_fixture_bytes(
    *,
    repository_root: Path,
) -> tuple[bytes, bytes]:
    repository_root = Path(repository_root)
    config, _config_bytes = load_canonical_benchmark_v2_config(
        root=repository_root,
    )

    expected_transcript_sha256 = config.get(
        "expected_geoffrey_compiled_sha256"
    )
    expected_draft_sha256 = config.get(
        "expected_geoffrey_draft_sha256"
    )
    for value in (
        expected_transcript_sha256,
        expected_draft_sha256,
    ):
        if (
            not isinstance(value, str)
            or re.fullmatch(r"[0-9a-f]{64}", value) is None
        ):
            raise ValueError(
                "Benchmark v2 canonical Geoffrey hash authority is invalid"
            )

    fixture_root = (
        repository_root
        / "var"
        / "benchmarks"
        / "summary-review-v1"
        / "fixture"
    )
    try:
        transcript_bytes = (
            fixture_root / "compiled-transcript.txt"
        ).read_bytes()
        draft_bytes = (
            fixture_root / "draft.md"
        ).read_bytes()
    except OSError as error:
        raise ValueError(
            "Benchmark v2 canonical Geoffrey evidence is unavailable"
        ) from error

    if (
        hashlib.sha256(transcript_bytes).hexdigest()
        != expected_transcript_sha256
    ):
        raise ValueError(
            "Benchmark v2 canonical Geoffrey transcript hash does not match config"
        )
    if (
        hashlib.sha256(draft_bytes).hexdigest()
        != expected_draft_sha256
    ):
        raise ValueError(
            "Benchmark v2 canonical Geoffrey draft hash does not match config"
        )

    return transcript_bytes, draft_bytes


def run_benchmark_v2_paid_authorization_preflight(
    *,
    repository_root: Path,
    provider_lock_bytes: bytes,
    pricing_evidence_bytes: bytes,
) -> dict:
    """Compose the final zero-paid Task-9 readiness proof from one run bundle."""

    repository_root = Path(repository_root)
    geoffrey_transcript_bytes, geoffrey_draft_bytes = (
        load_canonical_geoffrey_fixture_bytes(
            repository_root=repository_root,
        )
    )

    bundle = build_benchmark_v2_run_bundle(
        repository_root=repository_root,
        provider_lock_bytes=provider_lock_bytes,
        pricing_evidence_bytes=pricing_evidence_bytes,
        geoffrey_transcript_bytes=geoffrey_transcript_bytes,
        geoffrey_draft_bytes=geoffrey_draft_bytes,
    )
    if not isinstance(bundle, dict):
        raise ValueError(
            "Benchmark v2 run bundle result is invalid"
        )

    benchmark_binding = bundle.get("benchmark_binding")
    if benchmark_binding is not None:
        if not isinstance(benchmark_binding, dict):
            raise ValueError(
                "Benchmark v2 run bundle binding must be an object"
            )
        for binding_field in (
            "config_sha256",
            "fixture_set_sha256",
            "reviewer_prompt_sha256",
            "provider_lock_sha256",
            "pricing_evidence_sha256",
            "geoffrey_transcript_sha256",
            "geoffrey_draft_sha256",
        ):
            binding_value = benchmark_binding.get(binding_field)
            if (
                not isinstance(binding_value, str)
                or re.fullmatch(
                    r"sha256:[0-9a-f]{64}",
                    binding_value,
                )
                is None
            ):
                raise ValueError(
                    "Benchmark v2 run bundle binding hash is invalid: "
                    f"{binding_field}"
                )

    workspace = bundle.get("workspace")
    if not isinstance(workspace, dict):
        raise ValueError(
            "Benchmark v2 operator workspace result is invalid"
        )
    workspace_root = workspace.get("root")
    lock_dir = workspace.get("preflight_locks_dir")
    if not isinstance(workspace_root, Path):
        raise ValueError(
            "Benchmark v2 operator workspace root is invalid"
        )
    if not isinstance(lock_dir, Path):
        raise ValueError(
            "Benchmark v2 operator lock directory is invalid"
        )
    if lock_dir != workspace_root / "preflight" / "locks":
        raise ValueError(
            "Benchmark v2 operator workspace lock directory is not canonical"
        )

    frozen_readiness = freeze_benchmark_v2_paid_readiness_evidence(
        repository_root=repository_root,
        workspace_root=workspace_root,
        provider_lock_bytes=bundle["provider_lock_bytes"],
        pricing_evidence_bytes=bundle["pricing_evidence_bytes"],
    )
    if benchmark_binding is not None:
        if not isinstance(frozen_readiness, dict):
            raise ValueError(
                "Benchmark v2 frozen readiness binding evidence is invalid"
            )
        for binding_field in (
            "provider_lock_sha256",
            "pricing_evidence_sha256",
        ):
            if (
                frozen_readiness.get(binding_field)
                != benchmark_binding[binding_field]
            ):
                raise ValueError(
                    "Benchmark v2 frozen readiness hash does not match "
                    "run bundle binding"
                )

    if benchmark_binding is None:
        journal_state = {
            "journal_format": JOURNAL_FORMAT,
            "benchmark_binding": {},
            "ordered_case_keys": list(bundle["ordered_case_keys"]),
            "spent_usd": "0.00",
            "completed_case_keys": [],
            "attempts": [],
            "completed_cases": [],
            "failed_case_keys": [],
            "failed_cases": [],
        }
    else:
        execution_state_path = workspace.get("execution_state_path")
        if (
            not isinstance(execution_state_path, Path)
            or execution_state_path
            != workspace_root / "execution-state.json"
        ):
            raise ValueError(
                "Benchmark v2 operator execution journal path is not canonical"
            )
        journal_state = load_or_initialize_execution_journal(
            execution_state_path,
            benchmark_binding=benchmark_binding,
            ordered_case_keys=bundle["ordered_case_keys"],
        )

    paid_readiness = build_paid_execution_readiness(
        run_bundle=bundle,
        journal_state=journal_state,
    )
    if (
        not isinstance(paid_readiness, dict)
        or not paid_readiness
        or paid_readiness.get("ready") is not True
    ):
        raise ValueError(
            "Benchmark v2 paid readiness result is not ready"
        )
    if benchmark_binding is not None:
        readiness_binding = paid_readiness.get("benchmark_binding")
        if (
            readiness_binding is not None
            and readiness_binding != benchmark_binding
        ):
            raise ValueError(
                "Benchmark v2 paid readiness binding does not match "
                "run bundle binding"
            )

    provider_models = bundle["provider_lock"].get("models")
    if not isinstance(provider_models, dict):
        raise ValueError(
            "Benchmark v2 run bundle provider models are invalid"
        )

    candidate_routes = {}
    for model_id in bundle["config"]["models"]:
        provider_entry = provider_models.get(model_id)
        if not isinstance(provider_entry, dict):
            raise ValueError(
                "Benchmark v2 run bundle provider candidate entry is invalid"
            )
        route_slug = provider_entry.get("routing_provider_slug")
        compatible_providers = provider_entry.get(
            "compatible_served_providers"
        )
        if (
            not isinstance(route_slug, str)
            or not route_slug
            or not isinstance(compatible_providers, list)
            or not compatible_providers
            or not isinstance(compatible_providers[0], str)
            or not compatible_providers[0]
        ):
            raise ValueError(
                "Benchmark v2 run bundle provider route authority is invalid"
            )
        candidate_routes[model_id] = {
            "routing_provider_slug": route_slug,
            "observed_served_provider_identity": compatible_providers[0],
        }

    reviewer_prompt_bytes = bundle["reviewer_prompt_bytes"]
    if not isinstance(reviewer_prompt_bytes, bytes):
        raise ValueError(
            "Benchmark v2 run bundle reviewer prompt bytes are invalid"
        )
    try:
        system_prompt = reviewer_prompt_bytes.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ValueError(
            "Benchmark v2 run bundle reviewer prompt must be valid UTF-8"
        ) from error

    dry_run = run_canonical_canned_qualification_matrix_dry_run(
        lock_dir=lock_dir,
        config=bundle["config"],
        fixture_set=bundle["fixture_set"],
        candidate_routes=candidate_routes,
        provider_lock=bundle["provider_lock"],
        qualification_evidence={
            "config_bytes": bundle["config_bytes"],
            "prompt_bytes": reviewer_prompt_bytes,
            "provider_lock_bytes": bundle["provider_lock_bytes"],
        },
        system_prompt=system_prompt,
        transcript_bytes=bundle["geoffrey_transcript_bytes"],
        draft_bytes=bundle["geoffrey_draft_bytes"],
        benchmark_binding=benchmark_binding,
        designated_candidate_ids=list(bundle["geoffrey_designated_candidates"]),
    )
    if (
        not isinstance(dry_run, dict)
        or dry_run.get("mode") != "dry_run"
        or dry_run.get("spent_usd") != "0.00"
    ):
        raise ValueError(
            "Benchmark v2 operator preflight requires a zero-paid dry-run result"
        )
    if benchmark_binding is not None:
        dry_run_binding = dry_run.get("benchmark_binding")
        if dry_run_binding != benchmark_binding:
            raise ValueError(
                "Benchmark v2 dry-run binding does not match run bundle binding"
            )
        designated_tracks = dry_run.get("designated_tracks")
        designated_tracks_binding = (
            designated_tracks.get("binding")
            if isinstance(designated_tracks, dict)
            else None
        )
        if (
            not isinstance(designated_tracks_binding, dict)
            or designated_tracks_binding.get("benchmark_binding")
            != benchmark_binding
        ):
            raise ValueError(
                "Benchmark v2 designated-tracks lock is not bound to the run bundle"
            )

    result = {
        "status": "READY FOR PAID AUTHORIZATION",
        "paid_execution_authorized": False,
        "mode": "zero_paid_preflight",
        "workspace_root": workspace_root,
        "frozen_readiness": frozen_readiness,
        "paid_readiness": paid_readiness,
        "dry_run": dry_run,
    }
    if benchmark_binding is not None:
        result["benchmark_binding"] = benchmark_binding
    return result


def _require_benchmark_binding(value: object) -> dict:
    fields = {
        "config_sha256",
        "fixture_set_sha256",
        "reviewer_prompt_sha256",
        "provider_lock_sha256",
        "pricing_evidence_sha256",
        "geoffrey_transcript_sha256",
        "geoffrey_draft_sha256",
    }
    if not isinstance(value, dict) or set(value) != fields:
        raise ValueError("Benchmark v2 run binding is invalid")
    for item in value.values():
        if (
            not isinstance(item, str)
            or re.fullmatch(r"sha256:[0-9a-f]{64}", item) is None
        ):
            raise ValueError("Benchmark v2 run binding is invalid")
    return dict(value)


def _geoffrey_track_slug(candidate_id: str) -> str:
    """Derive the canonical per-candidate Geoffrey lock-directory slug."""

    if not isinstance(candidate_id, str) or not candidate_id:
        raise ValueError("Benchmark v2 Geoffrey track candidate id is invalid")
    slug = candidate_id.replace("/", "-").replace(".", "-")
    if re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug) is None:
        raise ValueError("Benchmark v2 Geoffrey track slug is invalid")
    return slug


def select_qualification_designated_tracks(
    *,
    designated_candidate_ids: list[str],
    canonical_candidate_ids: list[str],
    candidate_results: list[dict],
) -> dict:
    """Independently resolve each designated candidate's own eligibility.

    Unlike ``select_qualification_winner`` (a single deterministic tie-break
    across every eligible candidate), this never compares designated
    candidates against each other or against the rest of the field: each
    designated candidate's own six-of-six hard-gate eligibility, already
    computed identically for every canonical candidate, decides whether
    that candidate's own track proceeds to Geoffrey. One candidate's
    eligibility never affects another's.
    """

    _validate_qualification_candidate_results(
        canonical_candidate_ids=canonical_candidate_ids,
        candidate_results=candidate_results,
    )
    if (
        not isinstance(designated_candidate_ids, list)
        or not designated_candidate_ids
        or len(set(designated_candidate_ids)) != len(designated_candidate_ids)
        or any(
            not isinstance(candidate_id, str) or candidate_id not in canonical_candidate_ids
            for candidate_id in designated_candidate_ids
        )
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey designated candidates must be unique canonical candidates"
        )

    results_by_candidate = {
        candidate_result["candidate_id"]: candidate_result
        for candidate_result in candidate_results
    }
    designated_tracks: dict = {}
    for candidate_id in designated_candidate_ids:
        candidate_result = results_by_candidate[candidate_id]
        eligibility = candidate_result["eligibility"]
        designated_tracks[candidate_id] = (
            candidate_result if eligibility["eligible"] is True else None
        )
    return designated_tracks


def write_qualification_designated_tracks_lock(
    *,
    lock_dir: Path,
    binding: dict,
    designated_tracks: dict,
) -> dict:
    """Write or byte-verify the single immutable designated-tracks lock.

    Unlike the retired single-winner ``qualification.lock.json`` /
    ``qualification.no_winner.lock.json`` pair, there is exactly one
    designated-tracks lock file per epoch -- it records every designated
    candidate's own eligibility outcome side by side, since there is
    nothing to arbitrate between independent tracks at this stage.
    """

    if not isinstance(binding, dict):
        raise ValueError(
            "Benchmark v2 designated-tracks lock requires a binding object"
        )
    if (
        not isinstance(designated_tracks, dict)
        or not designated_tracks
        or any(
            not isinstance(candidate_id, str) or not candidate_id
            for candidate_id in designated_tracks
        )
        or any(
            candidate_result is not None and not isinstance(candidate_result, dict)
            for candidate_result in designated_tracks.values()
        )
    ):
        raise ValueError(
            "Benchmark v2 designated-tracks lock requires a valid designated-track map"
        )

    payload = {
        "lock_format": 1,
        "binding": binding,
        "designated_tracks": {
            candidate_id: {
                "eligible": candidate_result is not None,
                "candidate_result": candidate_result,
            }
            for candidate_id, candidate_result in designated_tracks.items()
        },
    }
    try:
        expected_bytes = (
            json.dumps(
                payload,
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
            + "\n"
        ).encode("utf-8")
    except (TypeError, ValueError) as error:
        raise ValueError(
            "Benchmark v2 designated-tracks lock payload is not canonical JSON"
        ) from error

    lock_dir = Path(lock_dir)
    target_path = lock_dir / "qualification.designated-tracks.lock.json"

    if target_path.exists():
        if not target_path.is_file():
            raise ValueError(
                "Benchmark v2 designated-tracks lock path is not a file"
            )
        try:
            existing_bytes = target_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 designated-tracks lock is unreadable"
            ) from error
        if existing_bytes != expected_bytes:
            raise ValueError(
                "Benchmark v2 designated-tracks lock is immutable and conflicts"
            )
        return {"path": target_path, "payload": payload}

    try:
        lock_dir.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise ValueError(
            "Benchmark v2 designated-tracks lock directory is unavailable"
        ) from error

    try:
        with target_path.open("xb") as handle:
            handle.write(expected_bytes)
    except FileExistsError:
        try:
            existing_bytes = target_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 designated-tracks lock is unreadable"
            ) from error
        if existing_bytes != expected_bytes:
            raise ValueError(
                "Benchmark v2 designated-tracks lock is immutable and conflicts"
            )
    except OSError as error:
        raise ValueError(
            "Benchmark v2 designated-tracks lock could not be written"
        ) from error

    return {"path": target_path, "payload": payload}


def finalize_qualification_designated_tracks_decision(
    *,
    lock_dir: Path,
    canonical_candidate_ids: list[str],
    canonical_case_ids: list[str],
    designated_candidate_ids: list[str],
    raw_case_records: list[dict],
    config_bytes: bytes,
    prompt_bytes: bytes,
    provider_lock_bytes: bytes,
    case_artifacts: list[dict],
    benchmark_binding: dict | None = None,
) -> dict:
    """Recompute, independently resolve, bind, and immutably lock every designated track."""

    candidate_ids = require_canonical_candidate_ids(canonical_candidate_ids)
    fixture_set = _load_canonical_qualification_fixture_set()
    fixture_case_ids = [
        fixture["case_id"] for fixture in fixture_set["cases"]
    ]
    if canonical_case_ids != fixture_case_ids:
        raise ValueError(
            "Benchmark v2 qualification finalization requires exact canonical case order"
        )

    candidate_results, recomputed_case_records = build_canonical_candidate_results(
        fixture_set=fixture_set,
        canonical_candidate_ids=candidate_ids,
        raw_case_records=raw_case_records,
        provider_lock_bytes=provider_lock_bytes,
    )
    designated_tracks = select_qualification_designated_tracks(
        designated_candidate_ids=list(designated_candidate_ids),
        canonical_candidate_ids=list(candidate_ids),
        candidate_results=candidate_results,
    )
    _validate_qualification_lock_evidence_consistency(
        canonical_candidate_ids=list(candidate_ids),
        canonical_case_ids=canonical_case_ids,
        candidate_results=candidate_results,
        provider_lock_bytes=provider_lock_bytes,
        case_results=recomputed_case_records,
    )
    binding = build_qualification_lock_binding(
        canonical_candidate_ids=list(candidate_ids),
        canonical_case_ids=canonical_case_ids,
        config_bytes=config_bytes,
        prompt_bytes=prompt_bytes,
        provider_lock_bytes=provider_lock_bytes,
        case_artifacts=case_artifacts,
        raw_case_records=raw_case_records,
        recomputed_case_records=recomputed_case_records,
        benchmark_binding=benchmark_binding,
    )
    return write_qualification_designated_tracks_lock(
        lock_dir=lock_dir,
        binding=binding,
        designated_tracks=designated_tracks,
    )


def _validate_geoffrey_designated_track_lock_bytes(
    *,
    designated_tracks_lock_bytes: bytes,
    expected_qualification_binding: dict,
    candidate_id: str,
    selected_candidate: dict,
) -> dict:
    """Validate exact canonical designated-tracks bytes for one eligible track."""

    if not isinstance(designated_tracks_lock_bytes, bytes):
        raise ValueError(
            "Benchmark v2 Geoffrey final evidence requires exact designated-tracks lock bytes"
        )
    if not isinstance(expected_qualification_binding, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey final evidence requires the expected qualification binding"
        )
    if not isinstance(candidate_id, str) or not candidate_id:
        raise ValueError(
            "Benchmark v2 Geoffrey final evidence requires a candidate id"
        )

    _validate_geoffrey_locked_candidate(selected_candidate)
    if selected_candidate.get("candidate_id") != candidate_id:
        raise ValueError(
            "Benchmark v2 Geoffrey final evidence candidate identity conflicts"
        )

    try:
        payload = json.loads(designated_tracks_lock_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 Geoffrey designated-tracks lock evidence is invalid JSON"
        ) from error

    if not isinstance(payload, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey designated-tracks lock evidence must be an object"
        )
    if set(payload) != {"lock_format", "binding", "designated_tracks"}:
        raise ValueError(
            "Benchmark v2 Geoffrey designated-tracks lock evidence shape is invalid"
        )

    canonical_bytes = _canonical_geoffrey_json_bytes(payload)
    if designated_tracks_lock_bytes != canonical_bytes:
        raise ValueError(
            "Benchmark v2 Geoffrey designated-tracks lock evidence bytes are not canonical"
        )

    designated_tracks = payload.get("designated_tracks")
    if not isinstance(designated_tracks, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey designated-tracks lock evidence shape is invalid"
        )
    track = designated_tracks.get(candidate_id)

    if (
        payload.get("lock_format") != 1
        or payload.get("binding") != expected_qualification_binding
        or not isinstance(track, dict)
        or track.get("eligible") is not True
        or track.get("candidate_result") != selected_candidate
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey designated-tracks lock evidence does not match the exact eligible track"
        )

    return payload


def build_geoffrey_final_binding_for_track(
    *,
    designated_tracks_lock_bytes: bytes,
    expected_qualification_binding: dict,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    candidate_id: str,
    selected_candidate: dict,
    gate_result: dict,
    geoffrey_run_records: list[dict],
    _revalidate_machine_evidence: bool = False,
) -> dict:
    """Build deterministic Task-8 final evidence for one independent designated track.

    Identical in every respect to ``build_geoffrey_final_binding`` except
    for which lock shape it validates against: a designated track is
    proven eligible against the shared ``qualification.designated-tracks.lock.json``
    (one candidate's entry within it) rather than the retired single-winner
    ``qualification.lock.json``. All run-evidence and gate-shape validation
    below is unchanged from the single-winner path.
    """

    if not isinstance(_revalidate_machine_evidence, bool):
        raise ValueError(
            "Benchmark v2 Geoffrey machine-evidence revalidation flag must be boolean"
        )

    _validate_geoffrey_designated_track_lock_bytes(
        designated_tracks_lock_bytes=designated_tracks_lock_bytes,
        expected_qualification_binding=expected_qualification_binding,
        candidate_id=candidate_id,
        selected_candidate=selected_candidate,
    )

    fixture_context = build_geoffrey_fixture_context(
        transcript_bytes=transcript_bytes,
        draft_bytes=draft_bytes,
    )
    review_context = fixture_context["review_context"]
    evaluator_private = build_geoffrey_evaluator_private(review_context)

    selected_candidate_bytes = _canonical_geoffrey_json_bytes(selected_candidate)

    if not isinstance(gate_result, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding gate result must be an object"
        )
    decision = gate_result.get("decision")
    required_run_count = gate_result.get("required_run_count")
    attempted_run_count = gate_result.get("attempted_run_count")
    completed_run_count = gate_result.get("completed_run_count")
    machine_pass_count = gate_result.get("machine_pass_count")
    if (
        decision not in {"no_winner", "sanity_review_required"}
        or required_run_count != 3
        or isinstance(attempted_run_count, bool)
        or not isinstance(attempted_run_count, int)
        or attempted_run_count < 1
        or attempted_run_count > required_run_count
        or isinstance(completed_run_count, bool)
        or not isinstance(completed_run_count, int)
        or completed_run_count < 0
        or completed_run_count > attempted_run_count
        or isinstance(machine_pass_count, bool)
        or not isinstance(machine_pass_count, int)
        or machine_pass_count < 0
        or machine_pass_count > completed_run_count
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding gate result is invalid"
        )
    if decision == "sanity_review_required" and (
        attempted_run_count != required_run_count
        or completed_run_count != required_run_count
        or machine_pass_count != required_run_count
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding sanity-review gate requires 3/3"
        )
    _canonical_geoffrey_json_bytes(gate_result)

    if (
        not isinstance(geoffrey_run_records, list)
        or len(geoffrey_run_records) != attempted_run_count
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding run evidence disagrees with attempted-run count"
        )

    records_by_number = {}
    for record in geoffrey_run_records:
        if not isinstance(record, dict):
            raise ValueError(
                "Benchmark v2 Geoffrey final binding run evidence must be an object"
            )
        run_number = record.get("run_number")
        if (
            isinstance(run_number, bool)
            or not isinstance(run_number, int)
            or run_number < 1
            or run_number > attempted_run_count
            or run_number in records_by_number
            or record.get("candidate_id") != candidate_id
        ):
            raise ValueError(
                "Benchmark v2 Geoffrey final binding run identity is invalid"
            )

        terminal_failure = record.get("terminal_failure")
        if terminal_failure is not None:
            if (
                not isinstance(terminal_failure, dict)
                or set(terminal_failure) != {"stage"}
                or terminal_failure.get("stage") not in {"executor", "evaluator"}
            ):
                raise ValueError(
                    "Benchmark v2 Geoffrey terminal failure evidence is invalid"
                )
            if terminal_failure["stage"] == "executor":
                if set(record) != {
                    "run_number",
                    "candidate_id",
                    "terminal_failure",
                }:
                    raise ValueError(
                        "Benchmark v2 Geoffrey executor failure must not contain completed case evidence"
                    )
            else:
                if set(record) != {
                    "run_number",
                    "candidate_id",
                    "case_result",
                    "terminal_failure",
                }:
                    raise ValueError(
                        "Benchmark v2 Geoffrey evaluator failure evidence is invalid"
                    )
                _canonical_geoffrey_json_bytes(record["case_result"])
        else:
            if set(record) != {
                "run_number",
                "candidate_id",
                "case_result",
                "machine_evaluation",
            }:
                raise ValueError(
                    "Benchmark v2 Geoffrey completed run evidence is malformed"
                )
            case_result = record["case_result"]
            machine_evaluation = record["machine_evaluation"]
            if not isinstance(case_result, dict):
                raise ValueError(
                    "Benchmark v2 Geoffrey final binding case result is invalid"
                )
            if (
                not isinstance(machine_evaluation, dict)
                or not isinstance(
                    machine_evaluation.get("hard_gate_passed"),
                    bool,
                )
            ):
                raise ValueError(
                    "Benchmark v2 Geoffrey final binding machine evidence is invalid"
                )
            if _revalidate_machine_evidence:
                expected_evaluation = evaluate_geoffrey_run(
                    review_context=review_context,
                    case_result=case_result,
                    evaluator_private=evaluator_private,
                    transcript=fixture_context["transcript"],
                    draft=fixture_context["draft"],
                )
                if machine_evaluation != expected_evaluation:
                    raise ValueError(
                        "Benchmark v2 Geoffrey final binding machine evidence does not match canonical evaluation"
                    )

        _canonical_geoffrey_json_bytes(record)
        records_by_number[run_number] = record

    expected_run_numbers = list(range(1, attempted_run_count + 1))
    if set(records_by_number) != set(expected_run_numbers):
        raise ValueError(
            "Benchmark v2 Geoffrey final binding requires contiguous attempted runs"
        )
    sorted_records = [
        records_by_number[run_number]
        for run_number in expected_run_numbers
    ]

    completed_records = [
        record for record in sorted_records if "case_result" in record
    ]
    machine_records = [
        record for record in sorted_records if "machine_evaluation" in record
    ]
    terminal_records = [
        record for record in sorted_records if "terminal_failure" in record
    ]
    if len(completed_records) != completed_run_count:
        raise ValueError(
            "Benchmark v2 Geoffrey final binding completed case evidence disagrees with gate count"
        )

    pass_flags = [
        record["machine_evaluation"]["hard_gate_passed"]
        for record in machine_records
    ]
    if sum(pass_flags) != machine_pass_count:
        raise ValueError(
            "Benchmark v2 Geoffrey final binding machine-pass evidence disagrees with gate count"
        )

    if decision == "sanity_review_required":
        evidence_matches_gate = (
            not terminal_records
            and len(machine_records) == required_run_count
            and all(pass_flags)
        )
    elif terminal_records:
        terminal_record = terminal_records[-1]
        terminal_stage = terminal_record["terminal_failure"]["stage"]
        evidence_matches_gate = (
            len(terminal_records) == 1
            and terminal_record["run_number"] == attempted_run_count
        )
        if terminal_stage == "executor":
            evidence_matches_gate = (
                evidence_matches_gate
                and attempted_run_count == completed_run_count + 1
                and len(machine_records) == completed_run_count
                and machine_pass_count == completed_run_count
                and all(pass_flags)
            )
        else:
            evidence_matches_gate = (
                evidence_matches_gate
                and attempted_run_count == completed_run_count
                and completed_run_count >= 1
                and len(machine_records) == completed_run_count - 1
                and machine_pass_count == completed_run_count - 1
                and all(pass_flags)
            )
    else:
        evidence_matches_gate = (
            attempted_run_count == completed_run_count
            and completed_run_count >= 1
            and len(machine_records) == completed_run_count
            and pass_flags
            == [True] * (completed_run_count - 1) + [False]
            and machine_pass_count == completed_run_count - 1
        )

    if not evidence_matches_gate:
        raise ValueError(
            "Benchmark v2 Geoffrey final binding run evidence disagrees with gate"
        )

    return {
        "designated_tracks_lock_sha256": _sha256_bytes(
            designated_tracks_lock_bytes
        ),
        "candidate_id": candidate_id,
        "geoffrey_transcript_sha256": fixture_context["transcript_sha256"],
        "geoffrey_draft_sha256": fixture_context["draft_sha256"],
        "geoffrey_evaluator_private_sha256": _sha256_bytes(
            _canonical_geoffrey_json_bytes(evaluator_private)
        ),
        "selected_candidate_sha256": _sha256_bytes(
            selected_candidate_bytes
        ),
        "gate_result": gate_result,
        "geoffrey_runs": [
            {
                "run_number": record["run_number"],
                "run_evidence_sha256": _sha256_bytes(
                    _canonical_geoffrey_json_bytes(record)
                ),
            }
            for record in sorted_records
        ],
    }


def write_geoffrey_final_decision_lock_for_track(
    *,
    lock_dir: Path,
    designated_tracks_lock_bytes: bytes,
    expected_qualification_binding: dict,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    candidate_id: str,
    selected_candidate: dict,
    gate_result: dict,
    geoffrey_run_records: list[dict],
    sanity_review_accepted: bool | None,
) -> dict:
    """Revalidate raw independent-track evidence, then write one immutable final decision.

    ``lock_dir`` is the per-candidate track directory (for example
    ``locks/geoffrey/<slug>``); each designated candidate's independent
    track writes only within its own directory, so one track's decision
    can never conflict with or be blocked by another's.
    """

    binding = build_geoffrey_final_binding_for_track(
        designated_tracks_lock_bytes=designated_tracks_lock_bytes,
        expected_qualification_binding=expected_qualification_binding,
        transcript_bytes=transcript_bytes,
        draft_bytes=draft_bytes,
        candidate_id=candidate_id,
        selected_candidate=selected_candidate,
        gate_result=gate_result,
        geoffrey_run_records=geoffrey_run_records,
        _revalidate_machine_evidence=True,
    )
    gate_result = binding.get("gate_result")
    if not isinstance(gate_result, dict):
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock requires a gate result"
        )

    gate_decision = gate_result.get("decision")
    required_run_count = gate_result.get("required_run_count")
    attempted_run_count = gate_result.get("attempted_run_count")
    completed_run_count = gate_result.get("completed_run_count")
    machine_pass_count = gate_result.get("machine_pass_count")
    geoffrey_runs = binding.get("geoffrey_runs")

    if (
        required_run_count != 3
        or isinstance(attempted_run_count, bool)
        or not isinstance(attempted_run_count, int)
        or attempted_run_count < 1
        or attempted_run_count > required_run_count
        or isinstance(completed_run_count, bool)
        or not isinstance(completed_run_count, int)
        or completed_run_count < 0
        or completed_run_count > attempted_run_count
        or isinstance(machine_pass_count, bool)
        or not isinstance(machine_pass_count, int)
        or machine_pass_count < 0
        or machine_pass_count > completed_run_count
        or not isinstance(geoffrey_runs, list)
        or len(geoffrey_runs) != attempted_run_count
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock binding is inconsistent"
        )

    if gate_decision == "no_winner":
        count_shape_is_valid = (
            attempted_run_count == completed_run_count + 1
            and machine_pass_count == completed_run_count
        ) or (
            attempted_run_count == completed_run_count
            and completed_run_count >= 1
            and machine_pass_count == completed_run_count - 1
        )
        if not count_shape_is_valid:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock NO WINNER gate is invalid"
            )
        if sanity_review_accepted is not None:
            raise ValueError(
                "Benchmark v2 Geoffrey machine NO WINNER cannot accept a sanity decision"
            )
        decision = "no_winner"
        sanity_review = {
            "required": False,
            "accepted": None,
        }
    elif gate_decision == "sanity_review_required":
        if (
            attempted_run_count != 3
            or completed_run_count != 3
            or machine_pass_count != 3
        ):
            raise ValueError(
                "Benchmark v2 Geoffrey sanity review requires a 3/3 machine pass"
            )
        if type(sanity_review_accepted) is not bool:
            raise ValueError(
                "Benchmark v2 Geoffrey 3/3 result requires an explicit sanity decision"
            )
        decision = (
            "winner"
            if sanity_review_accepted
            else "no_winner"
        )
        sanity_review = {
            "required": True,
            "accepted": sanity_review_accepted,
        }
    else:
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock gate decision is invalid"
        )

    payload = {
        "lock_format": 1,
        "decision": decision,
        "binding": binding,
        "sanity_review": sanity_review,
    }
    expected_bytes = _canonical_geoffrey_json_bytes(payload)

    lock_dir = Path(lock_dir)
    filename = (
        "winner.lock.json"
        if decision == "winner"
        else "no_winner.lock.json"
    )
    opposite_filename = (
        "no_winner.lock.json"
        if decision == "winner"
        else "winner.lock.json"
    )
    target_path = lock_dir / filename
    opposite_path = lock_dir / opposite_filename

    if opposite_path.exists():
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock conflicts with an existing opposite decision"
        )

    if target_path.exists():
        if not target_path.is_file():
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock path is not a file"
            )
        try:
            existing_bytes = target_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock is unreadable"
            ) from error
        if existing_bytes != expected_bytes:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock is immutable and conflicts"
            )
        return {
            "path": target_path,
            "payload": payload,
        }

    try:
        lock_dir.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock directory is unavailable"
        ) from error

    if opposite_path.exists():
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock conflicts with an existing opposite decision"
        )

    try:
        with target_path.open("xb") as handle:
            handle.write(expected_bytes)
    except FileExistsError:
        try:
            existing_bytes = target_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock is unreadable"
            ) from error
        if existing_bytes != expected_bytes:
            raise ValueError(
                "Benchmark v2 Geoffrey final decision lock is immutable and conflicts"
            )
    except OSError as error:
        raise ValueError(
            "Benchmark v2 Geoffrey final decision lock could not be written"
        ) from error

    return {
        "path": target_path,
        "payload": payload,
    }


def run_geoffrey_with_designated_track_lock(
    *,
    qualification_lock_dir: Path,
    expected_binding: dict,
    candidate_id: str,
    geoffrey_executor,
):
    """Run Geoffrey for one designated track only after validating its exact eligible lock entry."""

    if not callable(geoffrey_executor):
        raise ValueError(
            "Benchmark v2 Geoffrey designated-track executor must be callable"
        )
    if not isinstance(candidate_id, str) or not candidate_id:
        raise ValueError(
            "Benchmark v2 Geoffrey designated-track candidate id is invalid"
        )

    qualification_lock_dir = Path(qualification_lock_dir)
    designated_tracks_path = (
        qualification_lock_dir / "qualification.designated-tracks.lock.json"
    )

    if not designated_tracks_path.is_file():
        raise ValueError(
            "Benchmark v2 Geoffrey designated-track execution requires "
            "qualification.designated-tracks.lock.json"
        )

    try:
        lock_bytes = designated_tracks_path.read_bytes()
    except OSError as error:
        raise ValueError(
            "Benchmark v2 designated-tracks lock is unreadable"
        ) from error

    try:
        payload = json.loads(lock_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError(
            "Benchmark v2 designated-tracks lock is invalid JSON"
        ) from error

    if not isinstance(payload, dict):
        raise ValueError(
            "Benchmark v2 designated-tracks lock must be an object"
        )

    try:
        canonical_bytes = (
            json.dumps(
                payload,
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
            + "\n"
        ).encode("utf-8")
    except (TypeError, ValueError) as error:
        raise ValueError(
            "Benchmark v2 designated-tracks lock is not canonical JSON"
        ) from error

    if lock_bytes != canonical_bytes:
        raise ValueError(
            "Benchmark v2 designated-tracks lock bytes are not canonical"
        )

    if (
        payload.get("lock_format") != 1
        or payload.get("binding") != expected_binding
    ):
        raise ValueError(
            "Benchmark v2 designated-tracks lock does not match the expected binding"
        )

    designated_tracks = payload.get("designated_tracks")
    if not isinstance(designated_tracks, dict):
        raise ValueError(
            "Benchmark v2 designated-tracks lock evidence is invalid"
        )
    track = designated_tracks.get(candidate_id)
    if not isinstance(track, dict) or track.get("eligible") is not True:
        raise ValueError(
            "Benchmark v2 Geoffrey designated-track execution requires an eligible track"
        )

    selected_candidate = track.get("candidate_result")
    if not isinstance(selected_candidate, dict):
        raise ValueError(
            "Benchmark v2 designated-tracks lock selected candidate is invalid"
        )

    candidate_result_id = selected_candidate.get("candidate_id")
    model_id = selected_candidate.get("model_id")
    routing_provider_slug = selected_candidate.get("routing_provider_slug")
    observed_served_provider = selected_candidate.get(
        "observed_served_provider_identity"
    )
    eligibility = selected_candidate.get("eligibility")

    canonical_config, _canonical_config_bytes = load_canonical_benchmark_v2_config()
    committed_candidates = require_canonical_candidate_ids(
        canonical_config["models"]
    )
    if candidate_result_id != candidate_id or candidate_result_id not in committed_candidates:
        raise ValueError(
            "Benchmark v2 Geoffrey designated-track selected model must be a committed candidate"
        )

    if (
        not isinstance(candidate_result_id, str)
        or not candidate_result_id
        or model_id != candidate_result_id
        or not isinstance(routing_provider_slug, str)
        or not routing_provider_slug
        or not isinstance(observed_served_provider, str)
        or not observed_served_provider
        or not isinstance(eligibility, dict)
        or eligibility.get("eligible") is not True
        or eligibility.get("passed_case_count") != 6
        or eligibility.get("required_case_count") != 6
    ):
        raise ValueError(
            "Benchmark v2 Geoffrey designated-track selected candidate identity is invalid"
        )

    return geoffrey_executor(selected_candidate)


def run_geoffrey_final_gate_with_designated_track_lock(
    *,
    qualification_lock_dir: Path,
    track_lock_dir: Path,
    expected_binding: dict,
    candidate_id: str,
    transcript_bytes: bytes,
    draft_bytes: bytes,
    geoffrey_run_executor,
) -> dict:
    """Run canonical Task-8 Geoffrey evaluation for one independent designated track."""

    if not callable(geoffrey_run_executor):
        raise ValueError(
            "Benchmark v2 Geoffrey final-gate executor must be callable"
        )

    fixture_context = build_geoffrey_fixture_context(
        transcript_bytes=transcript_bytes,
        draft_bytes=draft_bytes,
    )
    review_context = fixture_context["review_context"]
    evaluator_private = build_geoffrey_evaluator_private(review_context)
    track_lock_dir = Path(track_lock_dir)

    def run_locked_candidate(selected_candidate):
        designated_tracks_path = (
            Path(qualification_lock_dir) / "qualification.designated-tracks.lock.json"
        )
        try:
            designated_tracks_lock_bytes = designated_tracks_path.read_bytes()
        except OSError as error:
            raise ValueError(
                "Benchmark v2 Geoffrey final gate cannot read designated-tracks lock bytes"
            ) from error

        run_records = []
        attempted_run_count = 0
        completed_run_count = 0
        machine_pass_count = 0
        required_run_count = 3

        def lock_no_winner_for_run(
            *,
            run_number: int,
            case_result=None,
            evaluation: dict | None = None,
            terminal_stage: str | None = None,
        ) -> dict:
            record = {
                "run_number": run_number,
                "candidate_id": selected_candidate["candidate_id"],
            }
            if terminal_stage == "executor":
                record["terminal_failure"] = {"stage": "executor"}
            elif terminal_stage == "evaluator":
                record["case_result"] = case_result
                record["terminal_failure"] = {"stage": "evaluator"}
            else:
                record["case_result"] = case_result
                record["machine_evaluation"] = evaluation
            run_records.append(record)
            gate_result = {
                "decision": "no_winner",
                "required_run_count": required_run_count,
                "attempted_run_count": attempted_run_count,
                "completed_run_count": completed_run_count,
                "machine_pass_count": machine_pass_count,
            }
            write_geoffrey_final_decision_lock_for_track(
                lock_dir=track_lock_dir,
                designated_tracks_lock_bytes=designated_tracks_lock_bytes,
                expected_qualification_binding=expected_binding,
                transcript_bytes=transcript_bytes,
                draft_bytes=draft_bytes,
                candidate_id=candidate_id,
                selected_candidate=selected_candidate,
                gate_result=gate_result,
                geoffrey_run_records=run_records,
                sanity_review_accepted=None,
            )
            return gate_result

        for run_number in range(1, required_run_count + 1):
            attempted_run_count += 1
            try:
                case_result = geoffrey_run_executor(
                    selected_candidate,
                    run_number,
                )
            except Exception:
                return lock_no_winner_for_run(
                    run_number=run_number,
                    terminal_stage="executor",
                )

            completed_run_count += 1
            try:
                evaluation = evaluate_geoffrey_run(
                    review_context=review_context,
                    case_result=case_result,
                    evaluator_private=evaluator_private,
                    transcript=fixture_context["transcript"],
                    draft=fixture_context["draft"],
                )
                if (
                    not isinstance(evaluation, dict)
                    or not isinstance(evaluation.get("hard_gate_passed"), bool)
                ):
                    raise ValueError(
                        "Benchmark v2 Geoffrey evaluator returned invalid machine evidence"
                    )
            except Exception:
                return lock_no_winner_for_run(
                    run_number=run_number,
                    case_result=case_result,
                    terminal_stage="evaluator",
                )

            if evaluation["hard_gate_passed"] is not True:
                return lock_no_winner_for_run(
                    run_number=run_number,
                    case_result=case_result,
                    evaluation=evaluation,
                )

            run_records.append(
                {
                    "run_number": run_number,
                    "candidate_id": selected_candidate["candidate_id"],
                    "case_result": case_result,
                    "machine_evaluation": evaluation,
                }
            )
            machine_pass_count += 1

        gate_result = {
            "decision": "sanity_review_required",
            "required_run_count": required_run_count,
            "attempted_run_count": attempted_run_count,
            "completed_run_count": completed_run_count,
            "machine_pass_count": machine_pass_count,
        }
        binding = build_geoffrey_final_binding_for_track(
            designated_tracks_lock_bytes=designated_tracks_lock_bytes,
            expected_qualification_binding=expected_binding,
            transcript_bytes=transcript_bytes,
            draft_bytes=draft_bytes,
            candidate_id=candidate_id,
            selected_candidate=selected_candidate,
            gate_result=gate_result,
            geoffrey_run_records=run_records,
            _revalidate_machine_evidence=True,
        )
        return {
            **gate_result,
            "binding": binding,
        }

    return run_geoffrey_with_designated_track_lock(
        qualification_lock_dir=qualification_lock_dir,
        expected_binding=expected_binding,
        candidate_id=candidate_id,
        geoffrey_executor=run_locked_candidate,
    )


def run_benchmark_v2_paid_execution(
    *,
    repository_root: Path,
    provider_lock_bytes: bytes,
    pricing_evidence_bytes: bytes,
    transport,
    paid_execution_authorized: bool,
) -> dict:
    """Run the canonical paid qualification and Geoffrey machine gate safely."""

    if paid_execution_authorized is not True:
        raise ValueError(
            "Benchmark v2 execution requires explicit paid authorization"
        )
    if not callable(transport):
        raise ValueError("Benchmark v2 paid transport must be callable")

    repository_root = Path(repository_root)
    geoffrey_transcript_bytes, geoffrey_draft_bytes = (
        load_canonical_geoffrey_fixture_bytes(repository_root=repository_root)
    )
    bundle = build_benchmark_v2_run_bundle(
        repository_root=repository_root,
        provider_lock_bytes=provider_lock_bytes,
        pricing_evidence_bytes=pricing_evidence_bytes,
        geoffrey_transcript_bytes=geoffrey_transcript_bytes,
        geoffrey_draft_bytes=geoffrey_draft_bytes,
    )
    benchmark_binding = _require_benchmark_binding(
        bundle["benchmark_binding"]
    )
    workspace = bundle["workspace"]
    workspace_root = workspace["root"]
    lock_dir = workspace["locks_dir"]
    journal_path = workspace["execution_state_path"]

    frozen = freeze_benchmark_v2_paid_readiness_evidence(
        repository_root=repository_root,
        workspace_root=workspace_root,
        provider_lock_bytes=bundle["provider_lock_bytes"],
        pricing_evidence_bytes=bundle["pricing_evidence_bytes"],
    )
    for field in ("provider_lock_sha256", "pricing_evidence_sha256"):
        if frozen.get(field) != benchmark_binding[field]:
            raise ValueError(
                "Benchmark v2 paid execution frozen evidence binding conflicts"
            )

    ordered_case_keys = list(bundle["ordered_case_keys"])
    journal_state = load_or_initialize_execution_journal(
        journal_path,
        benchmark_binding=benchmark_binding,
        ordered_case_keys=ordered_case_keys,
    )

    config = bundle["config"]
    fixture_set = bundle["fixture_set"]
    episode_template = fixture_set["episode_template"]
    provider_models = bundle["provider_lock"]["models"]
    system_prompt = bundle["reviewer_prompt_bytes"].decode("utf-8")

    def completed_cases_by_key(state: dict) -> dict:
        completed_cases = state.get("completed_cases")
        if not isinstance(completed_cases, list):
            raise ValueError(
                "Benchmark v2 paid execution completed-case evidence is invalid"
            )
        indexed = {}
        for item in completed_cases:
            case_key = item.get("case_key") if isinstance(item, dict) else None
            if (
                not isinstance(case_key, str)
                or not case_key
                or case_key in indexed
                or not isinstance(item.get("case_result"), dict)
                or not isinstance(item.get("execution_evidence"), dict)
            ):
                raise ValueError(
                    "Benchmark v2 paid execution completed-case evidence is invalid"
                )
            indexed[case_key] = item
        return indexed

    def failed_cases_by_key(state: dict) -> dict:
        failed_cases = state.get("failed_cases")
        if not isinstance(failed_cases, list):
            raise ValueError(
                "Benchmark v2 paid execution failed-case evidence is invalid"
            )
        indexed = {}
        for item in failed_cases:
            case_key = item.get("case_key") if isinstance(item, dict) else None
            if not isinstance(case_key, str) or not case_key or case_key in indexed:
                raise ValueError(
                    "Benchmark v2 paid execution failed-case evidence is invalid"
                )
            indexed[case_key] = item
        return indexed

    def failed_case_execution_summary(state: dict, *, case_key: str) -> dict:
        attempts = sorted(
            (
                attempt
                for attempt in state.get("attempts", [])
                if isinstance(attempt, dict) and attempt.get("case_key") == case_key
            ),
            key=lambda attempt: attempt.get("attempt_number", -1),
        )
        served_providers = {attempt.get("served_provider") for attempt in attempts}
        if not attempts or len(served_providers) != 1 or None in served_providers:
            raise ValueError(
                "Benchmark v2 failed-case backing attempts are invalid"
            )
        total_cost = sum(
            (Decimal(attempt["cost_usd"]) for attempt in attempts),
            Decimal("0"),
        )
        total_latency_ms = sum(attempt["latency_ms"] for attempt in attempts)
        return {
            "served_provider": next(iter(served_providers)),
            "cost_usd": format(total_cost, "f"),
            "latency_ms": total_latency_ms,
        }

    reservation_by_model = {
        model_id: Decimal(
            bundle["derived_call_reservation_usd_by_model"][model_id]
        )
        for model_id in bundle["canonical_candidate_ids"]
    }

    raw_case_records = []
    for fixture in fixture_set["cases"]:
        case_id = fixture["case_id"]
        for model_id in bundle["canonical_candidate_ids"]:
            provider_entry = provider_models[model_id]
            routing_provider_slug = provider_entry["routing_provider_slug"]
            reservation = reservation_by_model[model_id]
            case_key = f"{model_id}::{case_id}"
            journal_state = load_or_initialize_execution_journal(
                journal_path,
                benchmark_binding=benchmark_binding,
                ordered_case_keys=ordered_case_keys,
            )
            completed = completed_cases_by_key(journal_state).get(case_key)
            failed = failed_cases_by_key(journal_state).get(case_key)
            if completed is None and failed is None:
                review_context = build_review_context(
                    fixture["transcript"], fixture["draft"]
                )
                execute_case(
                    model_id=model_id,
                    system_prompt=system_prompt,
                    episode={
                        **episode_template,
                        "episode_key": f"benchmark-v2-{case_id}",
                    },
                    transcript=fixture["transcript"],
                    draft=fixture["draft"],
                    review_context=review_context,
                    config=config,
                    provider_lock=bundle["provider_lock"],
                    persisted_state={
                        "spent_usd": journal_state["spent_usd"],
                        "completed_case_keys": journal_state[
                            "completed_case_keys"
                        ],
                        "failed_case_keys": journal_state[
                            "failed_case_keys"
                        ],
                    },
                    ordered_case_keys=ordered_case_keys,
                    case_key=case_key,
                    call_reservation_usd=reservation,
                    transport=transport,
                    journal_path=journal_path,
                    benchmark_binding=benchmark_binding,
                )
                journal_state = load_or_initialize_execution_journal(
                    journal_path,
                    benchmark_binding=benchmark_binding,
                    ordered_case_keys=ordered_case_keys,
                )
                completed = completed_cases_by_key(journal_state).get(case_key)
                failed = failed_cases_by_key(journal_state).get(case_key)
            if completed is None and failed is None:
                raise ValueError(
                    "Benchmark v2 paid qualification case did not persist evidence"
                )

            if completed is not None:
                case_result = completed["case_result"]
                execution_evidence = completed["execution_evidence"]
                base_call_count = (
                    1 if case_result["audit_result"]["status"] == "fail" else 2
                )
                repair_turns = case_result["call_count"] - base_call_count
                served_provider = execution_evidence["served_provider_identity"]
                cost_usd = execution_evidence["cost_usd"]
                latency_ms = execution_evidence["latency_ms"]
            else:
                case_result = failed
                # A terminal model_failed outcome is only ever reached after
                # exhausting the one shared repair opportunity (see the
                # Global Constraints in
                # docs/superpowers/plans/2026-09-14-summary-review-benchmark-v2-terminal-case-outcomes.md);
                # there is no other path to this outcome under the canonical
                # configuration.
                repair_turns = 1
                summary = failed_case_execution_summary(
                    journal_state, case_key=case_key
                )
                served_provider = summary["served_provider"]
                cost_usd = summary["cost_usd"]
                latency_ms = summary["latency_ms"]

            raw_case_records.append(
                {
                    "candidate_id": model_id,
                    "case_id": case_id,
                    "case_result": case_result,
                    "routing_provider_slug": routing_provider_slug,
                    "served_provider": served_provider,
                    "repair_turns": repair_turns,
                    "cost_usd": cost_usd,
                    "latency_ms": latency_ms,
                }
            )

    case_artifacts = [
        {
            "case_id": fixture["case_id"],
            "fixture_bytes": (
                json.dumps(
                    fixture,
                    ensure_ascii=False,
                    indent=2,
                    sort_keys=True,
                )
                + "\n"
            ).encode("utf-8"),
            "gate_bytes": (
                json.dumps(
                    fixture["hard_gate"],
                    ensure_ascii=False,
                    indent=2,
                    sort_keys=True,
                )
                + "\n"
            ).encode("utf-8"),
        }
        for fixture in fixture_set["cases"]
    ]
    designated_tracks_result = finalize_qualification_designated_tracks_decision(
        lock_dir=lock_dir,
        canonical_candidate_ids=list(bundle["canonical_candidate_ids"]),
        canonical_case_ids=list(bundle["canonical_case_ids"]),
        designated_candidate_ids=list(bundle["geoffrey_designated_candidates"]),
        raw_case_records=raw_case_records,
        config_bytes=bundle["config_bytes"],
        prompt_bytes=bundle["reviewer_prompt_bytes"],
        provider_lock_bytes=bundle["provider_lock_bytes"],
        case_artifacts=case_artifacts,
        benchmark_binding=benchmark_binding,
    )
    designated_tracks_lock = designated_tracks_result["payload"]

    geoffrey_transcript = geoffrey_transcript_bytes.decode("utf-8")
    geoffrey_draft = geoffrey_draft_bytes.decode("utf-8")
    geoffrey_review_context = build_review_context(
        geoffrey_transcript,
        geoffrey_draft,
    )

    geoffrey_tracks = {}
    any_winner = False
    for candidate_id in bundle["geoffrey_designated_candidates"]:
        track_entry = designated_tracks_lock["designated_tracks"][candidate_id]
        if track_entry["eligible"] is not True:
            geoffrey_tracks[candidate_id] = {
                "eligible": False,
                "geoffrey": None,
            }
            continue

        slug = _geoffrey_track_slug(candidate_id)
        track_lock_dir = lock_dir / "geoffrey" / slug
        selected_candidate = track_entry["candidate_result"]

        def execute_geoffrey_run(
            run_candidate: dict,
            run_number: int,
            *,
            candidate_id=candidate_id,
            selected_candidate=selected_candidate,
            slug=slug,
        ) -> dict:
            if run_candidate != selected_candidate:
                raise ValueError(
                    "Benchmark v2 Geoffrey candidate conflicts with designated-tracks lock"
                )
            if run_number not in (1, 2, 3):
                raise ValueError("Benchmark v2 Geoffrey run number is invalid")

            model_id = run_candidate["candidate_id"]
            case_key = f"geoffrey::{slug}::run-{run_number}"
            current = load_or_initialize_execution_journal(
                journal_path,
                benchmark_binding=benchmark_binding,
                ordered_case_keys=ordered_case_keys,
            )
            completed = completed_cases_by_key(current).get(case_key)
            if completed is not None:
                return completed["case_result"]

            execute_case(
                model_id=model_id,
                system_prompt=system_prompt,
                episode={
                    **episode_template,
                    "episode_key": f"benchmark-v2-geoffrey-{slug}-{run_number}",
                },
                transcript=geoffrey_transcript,
                draft=geoffrey_draft,
                review_context=geoffrey_review_context,
                config=config,
                provider_lock=bundle["provider_lock"],
                persisted_state={
                    "spent_usd": current["spent_usd"],
                    "completed_case_keys": current["completed_case_keys"],
                },
                ordered_case_keys=ordered_case_keys,
                case_key=case_key,
                call_reservation_usd=Decimal(
                    bundle["derived_call_reservation_usd_by_model"][model_id]
                ),
                transport=transport,
                journal_path=journal_path,
                benchmark_binding=benchmark_binding,
            )
            current = load_or_initialize_execution_journal(
                journal_path,
                benchmark_binding=benchmark_binding,
                ordered_case_keys=ordered_case_keys,
            )
            completed = completed_cases_by_key(current).get(case_key)
            if completed is None:
                raise ValueError(
                    "Benchmark v2 Geoffrey case did not persist evidence"
                )
            return completed["case_result"]

        track_geoffrey = run_geoffrey_final_gate_with_designated_track_lock(
            qualification_lock_dir=lock_dir,
            track_lock_dir=track_lock_dir,
            expected_binding=designated_tracks_lock["binding"],
            candidate_id=candidate_id,
            transcript_bytes=geoffrey_transcript_bytes,
            draft_bytes=geoffrey_draft_bytes,
            geoffrey_run_executor=execute_geoffrey_run,
        )
        if track_geoffrey["decision"] == "sanity_review_required":
            any_winner = True
        geoffrey_tracks[candidate_id] = {
            "eligible": True,
            "geoffrey": track_geoffrey,
        }

    status = (
        "SANITY REVIEW REQUIRED"
        if any_winner
        else "NO WINNER"
    )

    return {
        "status": status,
        "paid_execution_authorized": True,
        "benchmark_binding": benchmark_binding,
        "designated_tracks": designated_tracks_lock,
        "geoffrey_tracks": geoffrey_tracks,
        "journal_state": load_or_initialize_execution_journal(
            journal_path,
            benchmark_binding=benchmark_binding,
            ordered_case_keys=ordered_case_keys,
        ),
    }
