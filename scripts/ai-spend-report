#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v uv >/dev/null 2>&1; then
  echo "error: uv is required for the AI spend report" >&2
  exit 127
fi

exec uv run \
  --python 3.12 \
  --with-requirements requirements.txt \
  python scripts/ai_spend_report.py "$@"
