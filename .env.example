# Core storage / worker
PODCAST_GCS_BUCKET=YOUR_GCS_BUCKET
WORKER_PROJECT=YOUR_GCP_PROJECT_ID
WORKER_REGION=europe-west1
WORKER_JOB_NAME=podcast-worker

# Apple transcript acquisition
APPLE_PODCASTS_TOKEN_FILE=/path/to/apple/bearer_token
APPLE_TRANSCRIPT_DELAY_DAYS=2

# Whisper / transcript review
PODCAST_WHISPER_API_KEY=
PODCAST_TRANSCRIPT_REVIEW_API_KEY=
PODCAST_TRANSCRIPT_REVIEW_PRESET=example-transcript-reviewer
PODCAST_REVIEW_ASR_API_KEY=
PODCAST_WORKER_THIRD_ASR_PREFETCH=1
PODCAST_MATERIALITY_JUDGE_PRESET=example-materiality-judge
PODCAST_WORKER_MATERIALITY_SHADOW=1
PODCAST_REVIEW_MATERIALITY_QUEUE=1

# Knowledge generation: set the writer preset for the single-pass note path.
# Leave it blank to use the legacy summary + independent review path.
PODCAST_KNOWLEDGE_API_KEY=
PODCAST_KNOWLEDGE_WRITER_PRESET=
PODCAST_SUMMARY_PRESET=
PODCAST_METADATA_PRESET=
PODCAST_SUMMARY_REVIEW_API_KEY=
PODCAST_SUMMARY_REVIEW_PRESET=

# Human Review
PODCAST_REVIEW_URL=https://review.example.com
REVIEW_REQUIRE_AUTH=false
GOOGLE_OAUTH_CLIENT_ID=
REVIEW_SESSION_SECRET=
REVIEW_ALLOWED_EMAIL=reviewer@example.com

# Optional notifications
PODCAST_SLACK_WEBHOOK_URL=
PODCAST_SLACK_SIGNING_SECRET=
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
PODCAST_REVIEW_EMAIL_TO=
PODCAST_REVIEW_EMAIL_FROM=notifications@example.com
PODCAST_REVIEW_EMAIL_FROM_NAME=Podcast Automation

# Optional local sync
PODCAST_VAULT_DIR=
PODCAST_VAULT_SUBDIR=Podcasts
PODCAST_VAULT_SYNC_HEARTBEAT_URL=
PODCAST_KNOWLEDGE_ROOTS=
