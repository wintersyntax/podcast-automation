<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.podcast-knowledge-sync</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USER/Documents/GitHub/podcast-automation/.venv/bin/python</string>
        <string>-m</string>
        <string>macos_agent.knowledge_sync</string>
    </array>
