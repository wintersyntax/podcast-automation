<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.podcast-apple-token-maintenance</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USER/Documents/GitHub/podcast-automation/.venv/bin/python</string>
        <string>-m</string>
        <string>macos_agent.apple_token_maintenance</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USER/Documents/GitHub/podcast-automation</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- launchd uses the Mac's local timezone (Europe/Oslo on this machine). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>20</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/Library/Logs/podcast-pipeline/apple_token_maintenance.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/Library/Logs/podcast-pipeline/apple_token_maintenance.stderr.log</string>
</dict>
</plist>
